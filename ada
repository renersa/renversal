local ctxThread = setmetatable({}, { __mode = "k" })
local lastCtx
local function setCtx(name)
	ctxThread[coroutine.running()] = name
	lastCtx = name
end
local function ctxName() return ctxThread[coroutine.running()] or lastCtx end
local function getCustom(slot)
	local n = ctxThread[coroutine.running()] or lastCtx
	local c = n and custom[n] and custom[n][slot]
	if c and c.on and c.id and c.id ~= "" then return c end
	local g = custom["*"] and custom["*"][slot]
	if g and g.on and g.id and g.id ~= "" then return g end
	return nil
end
playSlot = function(slot, vol, pitch, useDef)
	local c = getCustom(slot)
	if c then
		sfx("rbxassetid://" .. c.id, c.vol or 1, pitch or 1)
		return true
	end
	if useDef then
		local d = DEF[ctxName()]
		local id = d and d[slot]
		if id then sfx(id, vol or 1, pitch or 1) end
	end
	return false
end
