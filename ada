	-- ===== CROSSHAIR + CURSOR (galeri bergambar, bukan klik-klik; ID custom tersimpan) =====
	local function __buildCrosshair()
		local Mouse = player:GetMouse()
		local CUR_IDS = {
			{ "Paw", "11767069582" }, { "Gengar", "11759293285" }, { "Bunny", "1912438810" },
			{ "Kitty", "11351620343" }, { "Heart", "11722368344" }, { "Star", "11716559277" },
			{ "Osu", "8390115370" }, { "Cross", "14034486267" }, { "Kuromi", "11893991373" },
			{ "Donut", "11717104785" }, { "Cat", "11722553511" }, { "Death", "12472046162" },
		}
		-- crosshair: hanya "+" dan titik; sisanya (gambar) dari daftar cursor. Cursor: bawaan + gambar.
		local CH_OPTS = { { "plus", "Plus" }, { "dot", "Dot" } }
		for _, c in ipairs(CUR_IDS) do CH_OPTS[#CH_OPTS + 1] = { c[2], c[1] } end
		local CUR_OPTS = { { "default", "Default" } }
		for _, c in ipairs(CUR_IDS) do CUR_OPTS[#CUR_OPTS + 1] = { c[2], c[1] } end
		local OPTS = { ch = CH_OPTS, cur = CUR_OPTS }

		-- migrasi dari versi lama (chStyle/chCustom/curStyle/curCustom)
		local function digits(s) return (tostring(s or ""):gsub("%D", "")) end
		if type(state.chSaved) ~= "table" then state.chSaved = {} end
		if type(state.curSaved) ~= "table" then state.curSaved = {} end
		if state.chKind == "plus" or state.chKind == nil then
			if digits(state.chCustom) ~= "" then state.chKind = digits(state.chCustom)
			elseif tonumber(state.chStyle) == 3 then state.chKind = "dot" end
		end
		if digits(state.chCustom) ~= "" then
			local d = digits(state.chCustom)
			local have = false
			for _, v in ipairs(state.chSaved) do if v == d then have = true end end
			if not have then table.insert(state.chSaved, 1, d) end
		end
		state.chCustom, state.chStyle = "", 1
		if state.curKind == "default" or state.curKind == nil then
			if digits(state.curCustom) ~= "" then state.curKind = digits(state.curCustom)
			elseif state.curOn then
				local s = math.clamp(math.floor(tonumber(state.curStyle) or 1), 1, #CUR_IDS)
				state.curKind = CUR_IDS[s][2]
			end
		end
		if digits(state.curCustom) ~= "" then
			local d = digits(state.curCustom)
			local have = false
			for _, v in ipairs(state.curSaved) do if v == d then have = true end end
			if not have then table.insert(state.curSaved, 1, d) end
		end
		state.curCustom, state.curStyle = "", 1
		if tostring(state.chKind or "") == "" then state.chKind = "plus" end
		if tostring(state.curKind or "") == "" then state.curKind = "default" end

		local function inew(class, props, parent)
			local o = Instance.new(class)
			for k, v in pairs(props) do o[k] = v end
			o.Parent = parent
			return o
		end
		local function colorOf(hex) return fromHex(tostring(hex or "FFFFFF")) or WHITE end

		-- gambar bentuk crosshair / cursor ke dalam sebuah frame (dipakai layar & pratinjau galeri)
		local function drawGlyph(parent, kind, colorHex, px)
			for _, c in ipairs(parent:GetChildren()) do
				if c:GetAttribute("glyph") then c:Destroy() end
			end
			local col = colorOf(colorHex)
			local function G(class, props)
				props.AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5)
				props.Position = props.Position or UDim2.fromScale(0.5, 0.5)
				local o = inew(class, props, parent)
				o:SetAttribute("glyph", true)
				return o
			end
			local function outline(o) inew("UIStroke", { Thickness = 1, Color = BLACK, Transparency = 0.35 }, o) end
			kind = tostring(kind or "plus")
			if kind == "plus" then
				local th = math.max(2, math.floor(px / 10))
				local arm = math.max(6, math.floor(px * 0.92))
				outline(G("Frame", { Size = UDim2.fromOffset(arm, th), BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 2 }))
				outline(G("Frame", { Size = UDim2.fromOffset(th, arm), BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 2 }))
			elseif kind == "dot" then
				local d = math.max(4, math.floor(px * 0.3))
				local o = G("Frame", { Size = UDim2.fromOffset(d, d), BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 2 })
				inew("UICorner", { CornerRadius = UDim.new(1, 0) }, o)
				outline(o)
			elseif kind == "default" then
				G("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "\u{2196}", Font = Enum.Font.GothamBold, TextSize = math.max(10, math.floor(px * 0.9)), TextColor3 = col, TextStrokeTransparency = 0.4, ZIndex = 2 })
			else
				G("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = "rbxassetid://" .. kind, ImageColor3 = col, ScaleType = Enum.ScaleType.Fit, ZIndex = 2 })
			end
		end

		-- ---------- crosshair di layar ----------
		local chGui = mk("Frame", { Size = UDim2.fromOffset(40, 40), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Visible = false, ZIndex = 100 }, gui)
		-- ---------- cursor yang mengikuti mouse ----------
		local curGui = mk("Frame", { Size = UDim2.fromOffset(32, 32), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, Visible = false, ZIndex = 120 }, gui)

		local sig = { ch = "", cur = "" }
		local function applyCrosshair()
			chGui.Visible = state.chOn == true
			local sz = math.clamp(tonumber(state.chSize) or 24, 8, 120)
			chGui.Size = UDim2.fromOffset(sz, sz)
			chGui.Position = UDim2.new(0.5, tonumber(state.chX) or 0, 0.5, tonumber(state.chY) or 0)
			local s = tostring(state.chKind) .. "|" .. tostring(state.chColor) .. "|" .. sz
			if s ~= sig.ch then
				sig.ch = s
				drawGlyph(chGui, state.chKind, state.chColor, sz)
			end
		end
		local function applyCursor()
			local sz = math.clamp(tonumber(state.curSize) or 32, 8, 96)
			curGui.Size = UDim2.fromOffset(sz, sz)
			local custom = state.curOn and tostring(state.curKind) ~= "default"
			if custom then
				local s = tostring(state.curKind) .. "|" .. tostring(state.curColor) .. "|" .. sz
				if s ~= sig.cur then
					sig.cur = s
					drawGlyph(curGui, state.curKind, state.curColor, sz)
				end
				curGui.Visible = true
				pcall(function() UserInputService.MouseIconEnabled = false end)
				pcall(function() Mouse.Icon = "rbxassetid://0" end)
			else
				curGui.Visible = false
				pcall(function() UserInputService.MouseIconEnabled = true end)
				pcall(function() Mouse.Icon = "" end)
			end
		end
		local function resetCrosshair()
			state.chOn, state.chKind, state.chSize, state.chX, state.chY, state.chColor = false, "plus", 24, 0, 0, "FFFFFF"
			applyCrosshair() saveSoon() syncAll()
		end
		local function resetCursor()
			state.curOn, state.curKind, state.curSize, state.curColor = false, "default", 32, "FFFFFF"
			applyCursor() saveSoon() syncAll()
		end
		U.applyCrosshair, U.applyCursor, U.resetCrosshair, U.resetCursor = applyCrosshair, applyCursor, resetCrosshair, resetCursor
		applyCrosshair()
		applyCursor()
		bind(RunService.RenderStepped, function()
			if curGui.Visible then
				local pos = UserInputService:GetMouseLocation()
				curGui.Position = UDim2.fromOffset(pos.X, pos.Y)
			end
		end)

		-- ---------- galeri pilihan (UI bergambar) ----------
		local KEYS = {
			ch = { kind = "chKind", saved = "chSaved", color = "chColor", title = "Choose crosshair" },
			cur = { kind = "curKind", saved = "curSaved", color = "curColor", title = "Choose cursor" },
		}
		local gal = {}
		local function applyWhich(w)
			if w == "ch" then applyCrosshair() else applyCursor() end
		end
		local function nameOf(w, kind)
			for _, o in ipairs(OPTS[w]) do if o[1] == kind then return o[2] end end
