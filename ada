			local bAuto = mkBtn(L("AUTO: MATI", "AUTO: OFF"), 0.75, 0.25, 36)
			local auto = false
			local function render()
				for _, r in ipairs(rows) do pcall(function() r:Destroy() end) end
				rows = {}
				local list, n = scan(), 0
				table.sort(list, function(a, b) return (seen[a] or 0) > (seen[b] or 0) end)
				for _, g in ipairs(list) do
					if not seen[g] then tick0 = tick0 + 1; seen[g] = tick0 end
					local isNew = not base[g]
					if isNew or not onlyNew then
