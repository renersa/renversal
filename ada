			end
		end

		-- ===== 2+3) scan pages + match tokens (APP public + WEB cookie) =====
		local t0 = os.clock()
		local tokenToServer = {}
		local queue = {} -- { token, playing }
		local inflight = 0
		local MAX_INFLIGHT = 40
		local foundHit = nil

		local function onMatch(server, verified)
			if foundHit or not server then return end
			foundHit = {
				jobId = server.id,
				place = scanPlace,
				playing = server.playing,
				maxPlayers = server.maxPlayers,
				avatar = true,
				verified = verified == true,
			}
			F.hit = foundHit
			F.found = true
			prog("KETEMU · headshot match · JobId " .. tostring(server.id):sub(1, 13) .. "… · " .. tostring(server.playing or "?") .. "/" .. tostring(server.maxPlayers or "?"), true)
		end

		local function runBatch(tokens)
			-- Headshot + full body + bust: app/web sering beda mana yang match
			local payload = {}
			for _, tk in ipairs(tokens) do
				local base = tostring(tk)
				payload[#payload + 1] = {
					requestId = base .. "|H",
					type = "AvatarHeadShot",
					targetId = 0,
					token = tk,
					format = "png",
					size = "150x150",
				}
				payload[#payload + 1] = {
					requestId = base .. "|B",
					type = "Avatar",
					targetId = 0,
					token = tk,
					format = "png",
					size = "150x150",
				}
				payload[#payload + 1] = {
					requestId = base .. "|U",
					type = "AvatarBust",
					targetId = 0,
					token = tk,
					format = "png",
					size = "150x150",
