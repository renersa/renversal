			local LINES = { { 1, 2, 3 }, { 4, 5, 6 }, { 7, 8, 9 }, { 1, 4, 7 }, { 2, 5, 8 }, { 3, 6, 9 }, { 1, 5, 9 }, { 3, 5, 7 } }
			local OCOL = C3(255, 184, 76)
			local board, order, over, busy, diff, aiFirst = {}, { {}, {} }, false, false, 2, false
			local score = { 0, 0, 0 }
			local cells = {}
			local function winnerOf(b)
				for _, l in ipairs(LINES) do
					local a = b[l[1]]
					if a ~= 0 and a == b[l[2]] and a == b[l[3]] then return a, l end
				end
				return 0
			end
			local function place(b, ord, who, idx)
				b[idx] = who
				local q = ord[who]
				q[#q + 1] = idx
				local removed = nil
				if #q > 3 then
					removed = table.remove(q, 1)
					b[removed] = 0
				end
				return removed
			end
			local function empties(b)
				local t = {}
				for i = 1, 9 do if b[i] == 0 then t[#t + 1] = i end end
				return t
			end
			local function findWin(b, ord, who)
				for _, i in ipairs(empties(b)) do
					local bb = { table.unpack(b) }
					local oo = { { table.unpack(ord[1]) }, { table.unpack(ord[2]) } }
					place(bb, oo, who, i)
					if winnerOf(bb) == who then return i end
				end
			end
			local function hardMove(b, ord)
				local m = findWin(b, ord, 2) or findWin(b, ord, 1)
				if m then return m end
				if b[5] == 0 then return 5 end
				local corners = {}
				for _, i in ipairs({ 1, 3, 7, 9 }) do if b[i] == 0 then corners[#corners + 1] = i end end
				if #corners > 0 then return corners[math.random(1, #corners)] end
				local e = empties(b)
				return e[math.random(1, #e)]
			end
			local function aiMove()
				local e = empties(board)
				if #e == 0 then return nil end
				if diff == 3 then return hardMove(board, order) end
				if diff == 2 then
					local m = findWin(board, order, 2) or findWin(board, order, 1)
					if m then return m end
					if board[5] == 0 and math.random() < 0.55 then return 5 end
				end
				return e[math.random(1, #e)]
			end
