	for _, p in ipairs(bodyParts(char)) do
		p.Material = Enum.Material.Neon
		tween(p, 0.9, { Color = fire, Transparency = 1, Position = p.Position + V3(0, 3, 0), Size = p.Size * 0.3 }, Enum.EasingStyle.Sine)
	end
	-- burung
	local bird = {}
	local function mkp(shape, size, color, mat)
		local p = fxPart(shape, size, color, CFrame.new(pos), 1, mat or Enum.Material.Neon, 10)
		bird[#bird + 1] = p
		return p
	end
	local body = mkp(CYL, V3(5, 2.2, 2.2), fire)
	local belly = mkp(CYL, V3(4.4, 1.5, 1.5), gold)
	local head = mkp(Enum.PartType.Ball, ONE * 1.7, gold)
	local beak = mkp(B, V3(0.45, 0.35, 1.3), hot)
	local eyes = { mkp(Enum.PartType.Ball, ONE * 0.35, WHITE), mkp(Enum.PartType.Ball, ONE * 0.35, WHITE) }
	local crest = {}
	for k = 1, 3 do crest[k] = mkp(B, V3(0.18, 0.18, 1.6 - k * 0.2), hot) end
	local wings = { [-1] = {}, [1] = {} }
	for _, side in ipairs({ -1, 1 }) do
		for i = 1, 4 do
			local len = 3.4 - i * 0.35
			wings[side][i] = { p = mkp(B, V3(len, 0.14, 3.6 - i * 0.55), (i % 2 == 0) and gold or fire), len = len }
		end
	end
	local tails = {}
	for k = -2, 2 do tails[#tails + 1] = { p = mkp(B, V3(0.35, 0.1, 5.5 - math.abs(k) * 0.7), (k % 2 == 0) and fire or gold), k = k } end
	local pl = Instance.new("PointLight")
	pl.Color, pl.Brightness, pl.Range = fire, 8, 50
	pl.Parent = body
	local em = stream(body, { Color = ColorSequence.new(hot, fire), Texture = TEX_FIRE, Size = NS(2.4, 0), Lifetime = NumberRange.new(0.4, 0.9), Speed = NumberRange.new(2, 8), Rate = 90 })
	local function place(bcf, flap)
		body.CFrame = bcf * ANG(0, PI / 2, 0)
		belly.CFrame = bcf * CFrame.new(0, -0.3, 0) * ANG(0, PI / 2, 0)
		head.CFrame = bcf * CFrame.new(0, 0.5, -3.1)
		beak.CFrame = bcf * CFrame.new(0, 0.35, -4.1) * ANG(0.15, 0, 0)
		eyes[1].CFrame = bcf * CFrame.new(-0.55, 0.85, -3.5)
		eyes[2].CFrame = bcf * CFrame.new(0.55, 0.85, -3.5)
		for k, c in ipairs(crest) do c.CFrame = bcf * CFrame.new(0, 1.55 + k * 0.1, -2.7 + k * 0.5) * ANG(-0.7 + k * 0.1, 0, 0) end
		for _, side in ipairs({ -1, 1 }) do
			local cf = bcf * CFrame.new(side * 1.0, 0.5, -0.4) * ANG(0, 0, side * flap)
			for i, seg in ipairs(wings[side]) do
				cf = cf * CFrame.new(side * seg.len / 2, 0, 0)
				seg.p.CFrame = cf * ANG(0, side * -0.12 * i, 0)
				cf = cf * CFrame.new(side * seg.len / 2, 0, 0) * ANG(0, 0, side * flap * 0.35)
			end
		end
		for _, tl in ipairs(tails) do
			tl.p.CFrame = bcf * CFrame.new(tl.k * 0.6, -0.2 - math.abs(tl.k) * 0.12, 4.2) * ANG(0.18, tl.k * 0.16, 0)
		end
	end
	local function pathAt(t)
		local ang = t * PI * 3.4
		local r = 2.5 + 11 * t
		return V3(pos.X + math.cos(ang) * r, gp.Y + 2 + 42 * t ^ 1.25, pos.Z + math.sin(ang) * r)
	end
	task.wait(0.6)
	sfx(SND_PING, 1, 1.5)
	local shown, lastTrail = false, 0
	local T, t0 = 2.7, os.clock()
	while true do
		local now = os.clock()
		local t = (now - t0) / T
		if t >= 1 then break end
		local p = pathAt(t)
		local d = pathAt(math.min(t + 0.01, 1)) - p
		local bcf = CFrame.lookAt(p, p + (d.Magnitude < 0.01 and V3(0, 1, 0) or d.Unit), UP)
		place(bcf, math.sin((now - t0) * 15) * 0.65 + 0.15)
		if not shown and t > 0.05 then
			shown = true
			for _, bp in ipairs(bird) do tween(bp, 0.3, { Transparency = (bp == belly) and 0.15 or 0 }) end
		end
		if now - lastTrail > 0.08 then
			lastTrail = now
			burst(p, { Color = ColorSequence.new(hot, fire), Texture = TEX_FIRE, Speed = NumberRange.new(2, 8), Size = NS(2.5, 0), Lifetime = NumberRange.new(0.5, 1.1), Acceleration = V3(0, 6, 0) }, 3)
		end
		RunService.Heartbeat:Wait()
	end
	local top = pathAt(1)
	em.Enabled = false
	boom(1.7, 0.9)
	flash(hot, 0.7, 0.8)
	punch(22, 0.6)
	shake(3.5, 0.9)
	light(top, hot, 14, 90, 1.2)
	sphere(top, WHITE, 24, 0.35, 0)
	sphere(top, gold, 42, 0.7, 0.3)
	ring(top, fire, 60, 0.9)
	ring(top, gold, 38, 0.7)
	rays(top, { hot, gold, fire }, 50, 52, 0.9)
	burst(top, { Color = ColorSequence.new(hot, fire), Texture = TEX_FIRE, Speed = NumberRange.new(30, 80), Size = NS(4, 0), Lifetime = NumberRange.new(0.8, 1.6) }, 70)
	for _, bp in ipairs(bird) do
		local away = bp.Position - top
		if away.Magnitude < 0.1 then away = V3(0, 1, 0) end
		tween(bp, 0.9, { Position = bp.Position + away.Unit * (10 + R() * 14), Transparency = 1, Orientation = V3(R(0, 360), R(0, 360), R(0, 360)) })
	end
	for i = 1, I(50) do
		task.delay(R() * 0.4, function()
			local f = fxPart(B, V3(0.25, 0.05, 0.9), (R() < 0.5) and fire or gold, CFrame.new(top + V3((R() - 0.5) * 10, (R() - 0.5) * 6, (R() - 0.5) * 10)) * ANG(R() * 6, R() * 6, R() * 6), 0, nil, 4)
			tween(f, 1.8 + R(), { Position = V3(f.Position.X + (R() - 0.5) * 14, gp.Y + 0.3, f.Position.Z + (R() - 0.5) * 14), Orientation = V3(R(0, 360), R(0, 360), R(0, 360)) }, Enum.EasingStyle.Sine)
			task.delay(1.3 + R(), function() tween(f, 0.5, { Transparency = 1 }) end)
		end)
	end
	embers(gp, gold, 40, 30, 14)
end)

-- 35. HOLOGRAM (scan lalu jadi voxel)
add("Hologram", "\u{1F52E}", C3(70, 230, 255), function(char, pos, gp)
	local cy, bl, wh = C3(70, 230, 255), C3(60, 130, 255), C3(220, 252, 255)
	freezeParts(char)
	dim(0.26, 3.4)
	sfx(SND_PING, 1, 0.6)
	flash(cy, 0.4, 0.15)
	light(pos, cy, 6, 40, 2.6)
	ring(gp, cy, 18, 0.7)
	local parts = bodyParts(char)
	local orig = {}
	for _, p in ipairs(parts) do
		p.Material = Enum.Material.Neon
		orig[p] = { cf = p.CFrame, size = p.Size }
		tween(p, 0.4, { Color = cy, Transparency = 0.5 })
	end
	local plate = fxPart(Enum.PartType.Block, V3(9, 0.14, 9), wh, CFrame.new(pos - V3(0, 3.5, 0)), 0.1, nil, 6)
	local edge = fxPart(Enum.PartType.Block, V3(9.4, 0.05, 9.4), cy, plate.CFrame, 0.4, nil, 6)
	local base = fxPart(Enum.PartType.Cylinder, V3(0.12, 11, 11), cy, CFrame.new(V3(pos.X, gp.Y + 0.06, pos.Z)) * ANG(0, 0, PI / 2), 0.3, nil, 6)
	local base2 = fxPart(Enum.PartType.Cylinder, V3(0.1, 7, 7), bl, CFrame.new(V3(pos.X, gp.Y + 0.08, pos.Z)) * ANG(0, 0, PI / 2), 0.4, nil, 6)
	local lines = {}
	for i = 1, 4 do
		lines[i] = fxPart(Enum.PartType.Block, V3(0.08, 7.5, 0.08), cy, CFrame.new(pos), 0.5, nil, 6)
	end
	local T, t0 = 1.5, os.clock()
	local sweeps = 0
	while true do
		local t = (os.clock() - t0) / T
		if t >= 1 then break end
		local y = pos.Y - 3.5 + 7.2 * (0.5 - 0.5 * math.cos(t * PI * 3))
		plate.Position = V3(pos.X, y, pos.Z)
		edge.Position = plate.Position
		for i, l in ipairs(lines) do
			local a = i / 4 * PI * 2 + t * 2
			l.Position = V3(pos.X + math.cos(a) * 4.2, pos.Y + 0.2, pos.Z + math.sin(a) * 4.2)
		end
		for _, p in ipairs(parts) do
			local o = orig[p]
			p.CFrame = o.cf + V3((R() - 0.5) * 0.15, 0, (R() - 0.5) * 0.15)
			p.Transparency = (p.Position.Y < y) and 0.3 or 0.65
			if R() < 0.05 then p.Transparency = 0.9 end
		end
		local sw = math.floor(t * 3)
		if sw ~= sweeps then
			sweeps = sw
			sfx(SND_PING, 0.7, 1 + sw * 0.4)
		end
		RunService.Heartbeat:Wait()
	end
	-- voxel
	boom(1.4, 1.3)
	flash(wh, 0.5, 0.6)
	punch(14, 0.4)
	shake(2.4, 0.5)
	local vox = {}
	local cap = I(150)
	for _, p in ipairs(parts) do
		local s = p.Size
		local nx, ny, nz = math.clamp(math.ceil(s.X / 0.7), 1, 4), math.clamp(math.ceil(s.Y / 0.7), 1, 5), math.clamp(math.ceil(s.Z / 0.7), 1, 4)
		for ix = 1, nx do
			for iy = 1, ny do
				for iz = 1, nz do
					if #vox < cap then
						local off = V3(((ix - 0.5) / nx - 0.5) * s.X, ((iy - 0.5) / ny - 0.5) * s.Y, ((iz - 0.5) / nz - 0.5) * s.Z)
						local at = p.CFrame:PointToWorldSpace(off)
						local c = fxPart(Enum.PartType.Block, V3(s.X / nx, s.Y / ny, s.Z / nz) * 0.85, (R() < 0.25) and wh or ((R() < 0.5) and cy or bl), CFrame.new(at), 0.15, nil, 5)
						local dir = (at - pos)
						dir = (dir.Magnitude < 0.1) and V3(R() - 0.5, 0.5, R() - 0.5) or dir
						vox[#vox + 1] = { p = c, v = dir.Unit * (4 + R() * 9) + V3(0, 6 + R() * 8, 0), life = 0.9 + R() * 0.8, ph = R() * 6 }
					end
				end
			end
		end
	end
	hide(char)
	for _, o in ipairs({ plate, edge }) do tween(o, 0.4, { Transparency = 1 }) end
	for _, l in ipairs(lines) do tween(l, 0.3, { Transparency = 1 }) end
	tween(base, 1.2, { Size = V3(0.12, 34, 34), Transparency = 1 })
	tween(base2, 1, { Size = V3(0.1, 24, 24), Transparency = 1 })
	ring(gp, cy, 40, 0.7)
	rays(pos, { cy, bl, wh }, 36, 40, 0.7)
	burst(pos, { Color = ColorSequence.new(wh, cy), Speed = NumberRange.new(20, 60) }, 50)
	popup(pos + V3(0, 3, 0), "// ERASED", cy, 22)
	local last = os.clock()
	local v0 = os.clock()
	while os.clock() - v0 < 1.8 do
		local now = os.clock()
		local dt = math.min(now - last, 0.05)
		last = now
		local e = now - v0
		for _, v in ipairs(vox) do
			if v.p.Parent then
				local k = math.clamp(e / v.life, 0, 1)
				v.v = v.v * (1 - 2.2 * dt)
				v.p.Position = v.p.Position + v.v * dt + V3(math.sin(e * 6 + v.ph) * 0.05, 0.05, 0)
				v.p.Transparency = 0.15 + 0.85 * k ^ 2 + ((R() < 0.04) and 0.5 or 0)
				if k >= 1 then v.p:Destroy() end
			end
		end
		RunService.Heartbeat:Wait()
	end
end)

-- 36. KRAKEN (tentakel menyeret ke bawah)
add("Kraken", "\u{1F991}", C3(60, 190, 190), function(char, pos, gp)
	local teal, deep, purple, foam = C3(50, 190, 185), C3(14, 70, 84), C3(110, 70, 160), C3(220, 255, 250)
	freezeParts(char)
	dim(0.22, 3.6)
	sfx(SND_BASS, 1.3, 0.35)
	riser(SND_BASS, 1.4, 0.3, 1, 1)
	loopSfx(SFX.wind, 0.6, 2.6, 0.6)
	shake(2, 2.4)
	local ctr = V3(pos.X, gp.Y, pos.Z)
	local pit = fxPart(Enum.PartType.Cylinder, V3(0.1, 1, 1), C3(5, 18, 28), CFrame.new(ctr + V3(0, 0.05, 0)) * ANG(0, 0, PI / 2), 0, Enum.Material.SmoothPlastic, 8)
	local wat = fxPart(Enum.PartType.Cylinder, V3(0.08, 1, 1), teal, CFrame.new(ctr + V3(0, 0.07, 0)) * ANG(0, 0, PI / 2), 0.4, Enum.Material.Glass, 8)
	tween(pit, 0.7, { Size = V3(0.1, 13, 13) })
	tween(wat, 0.8, { Size = V3(0.08, 19, 19) })
	for k = 1, 4 do task.delay(k * 0.25, function() ring(ctr + V3(0, 0.1, 0), foam, 26 + k * 4, 0.8, 0.4) end) end
	local N = 14
	local tents = {}
	local nT = I(6)
	for i = 1, nT do
		local segs = {}
		for s = 1, N do
			local sz = 2.7 * (1 - (s - 1) / N * 0.82)
			local p = fxPart(Enum.PartType.Ball, ONE * sz, (s % 3 == 0) and purple or deep, CFrame.new(ctr - V3(0, 5, 0)), 0, Enum.Material.SmoothPlastic, 8)
			local cup = (s % 2 == 0 and s > 2) and fxPart(Enum.PartType.Ball, ONE * sz * 0.35, foam, CFrame.new(ctr - V3(0, 5, 0)), 0, Enum.Material.Neon, 8) or nil
			segs[s] = { p = p, cup = cup, sz = sz }
		end
		tents[i] = { segs = segs, a = i / nT * PI * 2 + R() * 0.3, r0 = 7.5 + R() * 2, h = 12 + R() * 6, ph = R() * 6 }
	end
	local parts, pd = bodyParts(char), {}
	for i, p in ipairs(parts) do pd[i] = { cf = p.CFrame, size = p.Size } end
	local T, t0, slammed = 2.5, os.clock(), false
	while true do
		local t = (os.clock() - t0) / T
		if t >= 1 then break end
		local grow = math.clamp(t * 2.4, 0, 1)
		local pull = math.clamp((t - 0.5) / 0.4, 0, 1) ^ 1.4
		for _, td in ipairs(tents) do
			for s, sg in ipairs(td.segs) do
				local u = s / N
				local rad = td.r0 * (1 - 0.88 * u ^ 1.1) * (1 - 0.8 * pull) + 0.6
				local ang = td.a + u * 1.3 + math.sin(t * 5 + u * 6 + td.ph) * 0.18 + pull * 2.2
				local y = gp.Y - 3 + (td.h * math.sin(u * PI * 0.8) * (1 - 0.9 * pull) + 1) * grow + (1 - grow) * -2
				local at = V3(ctr.X + math.cos(ang) * rad, y, ctr.Z + math.sin(ang) * rad)
				sg.p.Position = at
				if sg.cup then sg.cup.Position = at + V3(0, sg.sz * 0.45, 0) end
			end
		end
		for i, p in ipairs(parts) do
			local d = pd[i]
			local sink = pull ^ 1.5
			p.CFrame = CFrame.new(0, -sink * 8, 0) * d.cf * ANG(sink * 3, sink * 4, 0)
			p.Size = d.size * (1 - 0.75 * sink)
		end
		if t > 0.62 and not slammed then
			slammed = true
			boom(1.5, 0.7)
			punch(14, 0.5)
			shake(4, 0.7)
			burst(ctr + V3(0, 2, 0), { Color = ColorSequence.new(foam, teal), Speed = NumberRange.new(20, 50), Acceleration = V3(0, -30, 0), Lifetime = NumberRange.new(0.8, 1.4) }, 60)
			ring(ctr + V3(0, 0.1, 0), teal, 44, 0.7)
		end
		RunService.Heartbeat:Wait()
	end
	hide(char)
	flash(foam, 0.4, 0.4)
	for _, td in ipairs(tents) do
		for _, sg in ipairs(td.segs) do
			tween(sg.p, 0.5, { Position = sg.p.Position - V3(0, 7, 0), Transparency = 1 })
			if sg.cup then tween(sg.cup, 0.5, { Position = sg.cup.Position - V3(0, 7, 0), Transparency = 1 }) end
		end
	end
	for k = 1, 3 do task.delay(k * 0.12, function() ring(ctr + V3(0, 0.1, 0), (k == 2) and purple or foam, 30 + k * 12, 0.8, 0.3) end) end
	burst(ctr + V3(0, 1, 0), { Color = ColorSequence.new(foam, teal), Speed = NumberRange.new(20, 60), Acceleration = V3(0, -35, 0), Lifetime = NumberRange.new(1, 1.8) }, 90)
	shards(ctr + V3(0, 2, 0), teal, 24, Enum.Material.Glass, 24, 0.5)
	tween(pit, 0.8, { Transparency = 1 })
	tween(wat, 0.8, { Transparency = 1 })
end)

