					local b = mk("TextButton", { Position = UDim2.fromOffset((c - 1) * (BW + GAP), 78 + (r - 1) * (BH + GAP)), Size = UDim2.fromOffset(BW, BH), BackgroundColor3 = (kind == "fn") and SURF2 or SURF, Text = shownText, Font = FONTK, TextSize = (#shownText > 2) and 11 or 16, TextColor3 = TXT, AutoButtonColor = false }, pg)
					corner(b, 9)
					if kind == "op" or kind == "eq" then
						acc(b)
						b.TextColor3 = INK
					end
