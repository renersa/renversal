-- owner: notifikasi permintaan akses baru (poll). Non-owner: akses dicabut -> script berhenti.
if CONFIG.PRESENCE_URL then
	if CONFIG.CREATORS[player.UserId] then
		task.spawn(function()
			task.wait(3)
			while alive() do
				local d, ok = U.fb("GET", "hist")
				if ok and type(d) == "table" then
					local seen = tonumber(state.lastHistSeen) or 0
					local newest = seen
					for u, v in pairs(d) do
						local tt = type(v) == "table" and tonumber(v.t)
						if tt and tt > seen and tostring(u) ~= tostring(player.UserId) then
							if tt > newest then newest = tt end
							if seen > 0 then
								U.notif("Script dijalankan", tostring(v.d or v.n or u) .. " (@" .. tostring(v.n or "?") .. ") \u{2022} " .. ((tonumber(v.a) == 1) and "punya akses" or "menunggu akses"), 8)
							end
						end
					end
					if newest > seen then state.lastHistSeen = newest saveSoon() end
				end
				task.wait(12)
			end
		end)
		task.spawn(function()
			while alive() do
				local d, ok = U.fb("GET", "req")
				if ok and type(d) == "table" then
					local seen = tonumber(state.lastReqSeen) or 0
					local newest = seen
					for u, v in pairs(d) do
						local id = type(v) == "table" and tonumber(v.id)
						if id and id > seen then
							if id > newest then newest = id end
							U.notif("Access request", tostring(v.d or v.n or u) .. " (@" .. tostring(v.n or "?") .. "): " .. tostring(v.m or ""), 12)
						end
					end
					if newest > seen then state.lastReqSeen = newest saveSoon() end
				end
				task.wait(10)
			end
		end)
	else
		task.spawn(function()
			while alive() do
				task.wait(25)
				if not alive() then break end
				local ok3, reach3 = U.checkAccess()
				if reach3 and not ok3 then
					U.notif("RenVersal", "Your script access was removed.", 10)
					teardown(true)
					break
				end
			end
		end)
	end
end

