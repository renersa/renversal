	hole.Reflectance = 0.35
	local glint = stream(hole, { Color = ColorSequence.new(WHITE, blue), Size = NS(0.7, 0), Lifetime = NumberRange.new(0.35, 0.9), Speed = NumberRange.new(0, 1.5), Rate = 70 })
	glint.Shape = Enum.ParticleEmitterShape.Sphere
	glint.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	local glintBall = fxPart(Enum.PartType.Ball, ONE * 0.9, WHITE, CFrame.new(center), 0.1)
	local photon = fxPart(Enum.PartType.Cylinder, V3(0.2, 1, 1), hot, flat, 0.05)
	local d1 = fxPart(Enum.PartType.Cylinder, V3(0.14, 1, 1), orange, flat, 0.55)
	local d2 = fxPart(Enum.PartType.Cylinder, V3(0.14, 1, 1), gold, flat, 0.4)
	local d3 = fxPart(Enum.PartType.Cylinder, V3(0.14, 1, 1), hot, flat, 0.3)
	local jetA = fxPart(Enum.PartType.Block, V3(0.5, 1, 0.5), blue, tilt, 0.25)
	local jetB = fxPart(Enum.PartType.Block, V3(0.22, 1, 0.22), hot, tilt, 0.05)
	tween(halo, 0.8, { Size = ONE * 12 })
	tween(hole, 0.8, { Size = ONE * 7 })
	tween(photon, 0.8, { Size = V3(0.2, 8.6, 8.6) })
	tween(d1, 0.9, { Size = V3(0.14, 30, 30) })
	tween(d2, 0.9, { Size = V3(0.14, 21, 21) })
	tween(d3, 0.9, { Size = V3(0.14, 13, 13) })
	tween(jetA, 0.9, { Size = V3(0.5, 54, 0.5) })
	tween(jetB, 0.9, { Size = V3(0.22, 62, 0.22) })
	task.delay(T * 0.7, function()
		local t2 = T * 0.3
		for _, o in ipairs({ d1, d2, d3 }) do
			tween(o, t2, { Size = V3(0.14, 3, 3) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		tween(photon, t2, { Size = V3(0.2, 5, 5) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(jetA, t2, { Size = V3(0.5, 95, 0.5) })
		tween(jetB, t2, { Size = V3(0.22, 105, 0.22) })
	end)

	-- orbiter + trail (disk berputar)
	local orbiters = {}
	for i = 1, I(34) do
		local r = 6 + R() * 11
		local col = (R() < 0.35) and hot or ((R() < 0.5) and gold or orange)
		local p = fxPart(Enum.PartType.Ball, ONE * (0.35 + R() * 0.45), col, CFrame.new(center), 0)
		local a0 = Instance.new("Attachment")
		a0.Position = V3(0, 0.5, 0)
		a0.Parent = p
		local a1 = Instance.new("Attachment")
		a1.Position = V3(0, -0.5, 0)
		a1.Parent = p
		local tr = Instance.new("Trail")
		tr.Attachment0, tr.Attachment1 = a0, a1
		tr.Lifetime, tr.LightEmission, tr.FaceCamera = 0.55, 1, true
		tr.Color = ColorSequence.new(col, orange)
		tr.Transparency = NumberSequence.new(0.1, 1)
		tr.WidthScale = NumberSequence.new(1, 0)
		tr.Parent = p
		orbiters[i] = { p = p, a = R() * 6.28, r = r, s = 22 / r + R() }
	end

	-- bintang jatuh (garis memanjang)
	local stars = {}
	for i = 1, I(46) do
		stars[i] = {
			p = fxPart(Enum.PartType.Block, V3(0.1, 0.1, 2 + R() * 3), (R() < 0.5) and hot or blue, CFrame.new(center), 0.1),
			a = R() * 6.28, r = 10 + R() * 22, y = (R() - 0.5) * 20, s = 1.5 + R() * 2.5,
		}
	end

	-- batu tanah tersedot
	local rocks = {}
	for i = 1, 14 do
		local a, r = R() * 6.28, 5 + R() * 11
		rocks[i] = {
			p = fxPart(Enum.PartType.Block, ONE * (0.5 + R() * 1.3), C3(60, 52, 46), CFrame.new(V3(center.X + math.cos(a) * r, gp.Y + 0.5, center.Z + math.sin(a) * r)), 0, Enum.Material.Slate),
			a = a, r = r, d = R() * 0.5, y0 = gp.Y + 0.5, rot = V3(R() * 6, R() * 6, R() * 6),
		}
	end

	-- korban (spaghettification)
	local vparts = {}
	for _, p in ipairs(bodyParts(char)) do
		p.Anchored, p.CanCollide = true, false
		local rel = p.Position - center
		vparts[#vparts + 1] = { p = p, size = p.Size, col = p.Color, tr = p.Transparency, dist = V3(rel.X, 0, rel.Z).Magnitude, y = rel.Y, a = math.atan2(rel.Z, rel.X) }
	end

	local t0, last, late = os.clock(), os.clock(), false
	while true do
		local now = os.clock()
		local t = (now - t0) / T
		if t >= 1 then break end
		local dt = math.min(now - last, 0.05)
		last = now
		if t > 0.55 and not late then
			late = true
			shake(5, T * 0.45)
		end
		local collapse = math.clamp((t - 0.62) / 0.38, 0, 1)
		local ga = t * 9
		glintBall.Position = center + V3(math.cos(ga) * 0.8, 0.6, math.sin(ga) * 0.8).Unit * (hole.Size.X * 0.5 + 0.05)
		for _, o in ipairs(orbiters) do
			o.a += o.s * dt * (1 + t * 2.5)
			local rr = o.r * (1 - collapse ^ 1.4)
			o.p.CFrame = tilt * CFrame.new(math.cos(o.a) * rr, 0, math.sin(o.a) * rr)
		end
		for _, s in ipairs(stars) do
			s.a += s.s * dt * (1 + t * 4)
			local rr = s.r * (1 - t ^ 1.3) + 0.6
			local at = center + V3(math.cos(s.a) * rr, s.y * (1 - t), math.sin(s.a) * rr)
			local tang = V3(-math.sin(s.a), 0, math.cos(s.a))
			local inward = (center - at).Unit
			s.p.CFrame = CFrame.lookAt(at, at + (tang + inward * 0.35).Unit)
		end
		for _, o in ipairs(rocks) do
			local u = math.clamp((t - o.d) / (1 - o.d), 0, 1)
			local rr = o.r * (1 - u ^ 1.6)
			local ang = o.a + u * u * 9
			local y = o.y0 + (center.Y - o.y0) * u ^ 1.5 + math.sin(u * PI) * 5
			o.p.CFrame = CFrame.new(V3(center.X + math.cos(ang) * rr, y, center.Z + math.sin(ang) * rr)) * ANG(o.rot.X * u * 6, o.rot.Y * u * 6, o.rot.Z * u * 6)
		end
		local vu = math.clamp((t - 0.18) / 0.82, 0, 1) ^ 1.6
		if vu > 0 then
			for _, v in ipairs(vparts) do
				local rr = v.dist * (1 - vu)
				local ang = v.a + vu * 11
				local at = center + V3(math.cos(ang) * rr, v.y * (1 - vu), math.sin(ang) * rr)
				if (center - at).Magnitude > 0.05 then
					v.p.CFrame = CFrame.lookAt(at, center)
				else
					v.p.CFrame = CFrame.new(at)
				end
				local sz, k = v.size, 1 - 0.85 * vu
				v.p.Size = V3(sz.X * k, sz.Y * k, sz.Z * (1 + 6 * vu) * k)
				v.p.Color = v.col:Lerp((vu > 0.5) and hot or orange, vu)
				v.p.Transparency = math.max(v.tr, math.clamp((vu - 0.85) / 0.15, 0, 1))
			end
		end
		RunService.Heartbeat:Wait()
	end

	for _, o in ipairs(orbiters) do o.p:Destroy() end
