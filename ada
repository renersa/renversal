add("Matrix", "\u{1F4BB}", C3(50, 255, 110), function(char, pos, gp)
	local g = C3(50, 255, 110)
	local glyphs = { "0", "1", "{", "}", "#", "$", "%", "<", ">", "/", "=", "+" }
	freezeParts(char)
	sfx(SND_PING, 1, 0.4)
	defSfx("boom", SFX.laser, 0.9, 1.7)
	dim(0.16, 1.6)
	light(pos, g, 4, 30, 1.6)
	flash(C3(150, 255, 180), 0.4, 0.15)
	for _, p in ipairs(bodyParts(char)) do
		p.Material = Enum.Material.Neon
		p.Color = g
	end
	local plate = fxPart(Enum.PartType.Block, V3(9, 0.12, 9), g, CFrame.new(pos + UP * 4), 0.3)
	local function digit(at)
		local a = fxPart(Enum.PartType.Ball, ONE * 0.2, g, CFrame.new(at), 1, nil, 3)
		local bb = Instance.new("BillboardGui")
		bb.Size, bb.Adornee, bb.AlwaysOnTop = UDim2.fromOffset(28, 28), a, true
		bb.Parent = a
		local l = Instance.new("TextLabel")
		l.Size, l.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		l.Text, l.Font, l.TextSize = glyphs[R(1, #glyphs)], Enum.Font.Code, 22
		l.TextColor3 = (R() < 0.2) and WHITE or g
		l.Parent = bb
		tween(a, 0.9 + R() * 0.9, { Position = at - V3(0, 6 + R() * 8, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		task.delay(0.4 + R() * 0.6, function() tween(l, 0.5, { TextTransparency = 1 }) end)
	end
	local function convert(p)
		local n = math.clamp(math.floor(p.Size.X * p.Size.Y * p.Size.Z * 0.6), 2, 8)
		for _ = 1, I(n) do
			digit(p.CFrame:PointToWorldSpace(V3((R() - 0.5) * p.Size.X, (R() - 0.5) * p.Size.Y, (R() - 0.5) * p.Size.Z)))
		end
		p.Transparency = 1
	end
	local list, done = bodyParts(char), {}
	local T, t0 = 0.9, os.clock()
	while true do
		local t = (os.clock() - t0) / T
		if t >= 1 then break end
		local y = pos.Y + 4 - t * 8
		plate.Position = V3(pos.X, y, pos.Z)
		for _, p in ipairs(list) do
			if not done[p] and p.Transparency < 1 and p.Position.Y > y then
				done[p] = true
				convert(p)
			end
		end
		RunService.Heartbeat:Wait()
	end
	for _, p in ipairs(list) do
		if not done[p] and p.Transparency < 1 then convert(p) end
	end
	tween(plate, 0.3, { Transparency = 1 })
	ring(gp, g, 26, 0.6)
	burst(pos, { Color = ColorSequence.new(g, WHITE), Speed = NumberRange.new(10, 30) }, 40)
	flash(C3(150, 255, 180), 0.3, 0.2)
end)

