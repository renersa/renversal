		end)

		local producers = 0
		local function ingestServer(sv)
			if type(sv) ~= "table" or type(sv.id) ~= "string" then return end
			if not F._seen[sv.id] then
				F._seen[sv.id] = true
				F.total = (F.total or 0) + 1
				F.players = (F.players or 0) + (tonumber(sv.playing) or 0)
			end
			local playing = tonumber(sv.playing) or 0
			-- playerTokens = SEMUA token yang API kasih (app sering ≤5; web+cookie bisa lebih)
			local toks = type(sv.playerTokens) == "table" and sv.playerTokens or {}
			-- beberapa response web pakai field "players" dengan playerToken di dalamnya
			if type(sv.players) == "table" then
				for _, p in ipairs(sv.players) do
					if type(p) == "table" and type(p.playerToken) == "string" then
						toks[#toks + 1] = p.playerToken
					end
				end
			end
			for _, tk in ipairs(toks) do
				if type(tk) == "string" and not tokenToServer[tk] then
					tokenToServer[tk] = sv
					queue[#queue + 1] = { tk, playing }
				end
			end
		end

		local function produce(order, useCookie, label)
			producers = producers + 1
			local cursor = nil
			local fails = 0
			local pages = 0
			-- max 200 page × 100 = 20.000 server/producer (bukan 40)
			local MAX_PAGES = 200
			while not F.cancel and not F.found and pages < MAX_PAGES do
				-- coba excludeFullGames dulu; kalau page kosong, ulang tanpa exclude
				local base = "https://games.roblox.com/v1/games/"
					.. scanPlace
					.. "/servers/Public?sortOrder="
					.. order
					.. "&limit=100"
				local url = base .. "&excludeFullGames=true"
				if cursor then
					url = url .. "&cursor=" .. HttpService:UrlEncode(tostring(cursor))
				end
				local body = rGet(url, useCookie)
				local d = jdecode(body or "")
				if (not d or type(d.data) ~= "table" or #d.data == 0) and pages == 0 and not cursor then
					-- fallback tanpa excludeFullGames
					url = base
					body = rGet(url, useCookie)
					d = jdecode(body or "")
				end
				if not (d and type(d.data) == "table") then
					fails = fails + 1
					if fails >= 25 then break end
					-- jeda hanya saat error/rate-limit, bukan tiap page sukses
					task.wait(math.min(0.15 * fails, 1.2))
				else
					fails = 0
					pages = pages + 1
					for _, sv in ipairs(d.data) do ingestServer(sv) end
					pump()
					local nextC = d.nextPageCursor
					if type(nextC) ~= "string" or nextC == "" then break end
					cursor = nextC
					-- tanpa task.wait di page sukses → lebih cepat
				end
				local el = math.max(os.clock() - t0, 0.25)
				local mode = useCookie and "web" or "app"
				prog(string.format(
					"Scan %s %d server · %d avatar · antrian %d · x%d · %.0f/dtk · p%d",
					mode, F.total or 0, F.checked or 0, #queue, inflight, (F.checked or 0) / el, pages
				))
			end
			producers = producers - 1
		end

		-- APP (public, tanpa cookie): 2 arah
		task.spawn(produce, "Desc", false, "app")
		task.spawn(produce, "Asc", false, "app")
		-- WEB (cookie): 2 arah lagi — token sering lebih lengkap dari UI app (yang cuma nampilin ~5)
		if U.cookie and U.cookie ~= "" then
			task.delay(0.15, function()
				if not F.found and not F.cancel then task.spawn(produce, "Desc", true, "web") end
			end)
			task.delay(0.3, function()
				if not F.found and not F.cancel then task.spawn(produce, "Asc", true, "web") end
			end)
		else
			-- tanpa cookie tetap double-pass public biar coverage naik
			task.delay(0.4, function()
				if not F.found and not F.cancel then task.spawn(produce, "Desc", false, "app2") end
			end)
		end

		local idle = 0
		while not F.cancel and not F.found do
			pump()
			local el = math.max(os.clock() - t0, 0.25)
			prog(string.format(
				"Scan %d server · %d headshot · antrian %d · x%d · %.0f/dtk",
				F.total or 0, F.checked or 0, #queue, inflight, (F.checked or 0) / el
			))
			if producers <= 0 and #queue == 0 and inflight == 0 then
				idle = idle + 1
				if idle == 1 then
					prog("Pass 1 selesai · recovery (app+web) ulang token...", true)
					tokenToServer = {}
					task.spawn(produce, "Desc", false, "app")
					task.spawn(produce, "Asc", false, "app")
					if U.cookie and U.cookie ~= "" then
						task.spawn(produce, "Desc", true, "web")
						task.spawn(produce, "Asc", true, "web")
					end
				else
					break
				end
			else
				idle = 0
			end
			task.wait(0.05)
		end
		local tDead = os.clock() + 12
		while inflight > 0 and not F.found and not F.cancel and os.clock() < tDead do
			pump()
			task.wait(0.05)
		end

		F.running = false
		if F.cancel then
			F.paused = true
			F.cancel = false
			prog("Di-stop · " .. tostring(F.checked) .. " headshot / " .. tostring(F.total) .. " server", true)
			return nil, "stopped"
		end
		if foundHit then
			if not foundHit.verified then
				local ph = tryPresence()
				if ph and ph.jobId then
					foundHit.jobId = ph.jobId
					foundHit.place = ph.place or foundHit.place
					foundHit.verified = true
				end
			end
			F.hit = foundHit
			F.paused = false
			prog("Selesai · KETEMU" .. (foundHit.verified and " (verified)" or " (headshot match)"), true)
			-- simpan ringkasan ke file txt kalau executor support
			pcall(function()
				if not writefile then return end
				local path = "find_" .. tostring(uid) .. "_" .. tostring(os.time()) .. ".txt"
				local L = {
					"=== RenVersal Find Result ===",
					"Time: " .. os.date("%Y-%m-%d %H:%M:%S"),
					"UserId: " .. tostring(uid),
					"PlaceId: " .. tostring(foundHit.place or scanPlace),
					"JobId: " .. tostring(foundHit.jobId),
					"Playing: " .. tostring(foundHit.playing),
					"MaxPlayers: " .. tostring(foundHit.maxPlayers),
					"Verified: " .. tostring(foundHit.verified),
					"FromPresence: " .. tostring(foundHit.fromPresence),
					"CookieUsed: " .. tostring(U.cookie ~= nil and U.cookie ~= ""),
					"",
					'game:GetService("TeleportService"):TeleportToPlaceInstance('
						.. tostring(foundHit.place or scanPlace) .. ', "'
						.. tostring(foundHit.jobId) .. '", game.Players.LocalPlayer)',
				}
				writefile(path, table.concat(L, "\n"))
			end)
			return foundHit
		end
		local tip = (U.cookie and U.cookie ~= "")
			and "Tidak ketemu · semua token app+web sudah dicek. Target offline / VIP / place lain."
			or "Tidak ketemu · pasang cookie (Creator → Find) biar token WEB lebih lengkap (app UI cuma ~5 avatar)."
		prog(tip .. " · " .. tostring(F.total) .. " server · " .. tostring(F.checked) .. " headshot", true)
		return nil, "tidak ketemu"
	end

	-- cari PlaceId dari nama game (lewat pencarian Roblox), untuk lokasi yang hanya terbaca berupa nama
	function U.placeFromName(name)
		name = tostring(name or ""):gsub("^%s*[Pp]laying%s+", "")
		local lname = name:lower()
		if #name < 3 or lname == "website" or lname == "online" or lname == "offline" or lname:find("studio", 1, true) or lname == "in game" then return nil end
		local d = jdecode(http("https://apis.roblox.com/search-api/omni-search?searchQuery=" .. HttpService:UrlEncode(name) .. "&pageToken=&sessionId=" .. HttpService:GenerateGUID(false) .. "&pageType=all") or "")
		if not (d and type(d.searchResults) == "table") then return nil end
		local nn = lname:gsub("[^%w]", "")
		for _, grp in ipairs(d.searchResults) do
			if tostring(grp.contentGroupType) == "Game" and type(grp.contents) == "table" then
				for _, c in ipairs(grp.contents) do
					local cn = tostring(c.name or ""):lower():gsub("[^%w]", "")
					if cn == nn or (#nn >= 5 and cn:find(nn, 1, true)) then return tonumber(c.rootPlaceId or c.placeId) end
				end
			end
		end
	end
	-- game populer (untuk scan lintas game)
	function U.popularPlaces(n)
		n = math.clamp(tonumber(n) or 5, 1, 30)
		local sd = jdecode(http("https://games.roblox.com/v1/games/sorts?gameSortsContext=GamesDefaultSorts") or "")
		local tok = sd and type(sd.sorts) == "table" and sd.sorts[1] and sd.sorts[1].token
		if not tok then return {} end
		local d = jdecode(http("https://games.roblox.com/v1/games/list?model.sortToken=" .. HttpService:UrlEncode(tok) .. "&model.startRows=0&model.maxRows=" .. n) or "")
		local out = {}
		if d and type(d.games) == "table" then
			for _, g in ipairs(d.games) do
				if tonumber(g.placeId) then out[#out + 1] = tonumber(g.placeId) end
			end
		end
		return out
	end
	function U.autoFind(r, onProgress, onDone, resumeOrPlace, extraPlaces)
		local F = U.fnd
		local resume = resumeOrPlace == true
		local forcePlace = (type(resumeOrPlace) == "number") and resumeOrPlace or nil
		task.spawn(function()
			-- jika masih running, minta stop dulu lalu tunggu
			if F.running then
				F.cancel = true
				for _ = 1, 50 do if not F.running then break end task.wait(0.05) end
				F.running = false
				F.cancel = false
			end
			local function fin() if onDone then pcall(onDone) end end
			if not resume then
				F.hit, F.status, F.uid = nil, "", r.uid
				if not forcePlace then
					F.paused, F._seen, F._pending, F._target = false, nil, nil, nil
				end
			else
				F.hit = nil
				F.uid = r.uid
			end
			if r.src == "server ini" and not forcePlace and not resume then fin() return end

			-- ===== AKURASI TINGGI: presence dulu (cookie > API), baru scan avatar =====
			if not resume and not forcePlace then
				F.status = "Cek presence (paling akurat)..."
				if onProgress then pcall(onProgress) end
				local job, place, srcP = nil, nil, nil
				-- 1) cookie auth presence (bisa baca hampir semua pemain)
				if U.cookie and U.cookie ~= "" then
					local pr = U.authPresence(r.uid)
					if type(pr) == "table" and type(pr.job) == "string" and pr.job ~= "" then
						job, place, srcP = pr.job, tonumber(pr.place) or tonumber(pr.root), "presence cookie"
					elseif type(pr) == "table" and tonumber(pr.place) then
						place = tonumber(pr.place) or tonumber(pr.root)
						srcP = "presence cookie (place saja)"
					end
				end
				-- 2) presence publik / session
				if not job then
					local okP, pd = pcall(apiJson, "POST", "https://presence.roblox.com/v1/presence/users", { userIds = { r.uid } })
					local u = okP and type(pd) == "table" and type(pd.userPresences) == "table" and pd.userPresences[1]
					if type(u) == "table" then
						if type(u.gameId) == "string" and u.gameId ~= "" then
							job = u.gameId
							place = tonumber(u.placeId) or tonumber(u.rootPlaceId) or place
							srcP = srcP or "presence API"
						elseif not place then
							place = tonumber(u.placeId) or tonumber(u.rootPlaceId)
						end
					end
				end
				-- 3) data lookup yang sudah ada
				if not job and type(r.job) == "string" and r.job ~= "" then
					job, place = r.job, tonumber(r.place) or place
					srcP = "lookup"
				end
				if job and (place or tonumber(r.place) or PLACE) then
					local hp = place or tonumber(r.place) or PLACE
					r.status, r.place, r.job, r.src, r.unknown = "ingame", hp, job, srcP or "presence", nil
					F.status = "Selesai · KETEMU (terverifikasi presence)"
					F.hit = { jobId = job, place = hp, avatar = false, verified = true, instant = true }
					fin()
					task.spawn(function()
						pcall(function() r.game = gameNameOf(hp) end)
						fin()
						pcall(U.geoTo, r, job, hp, fin)
						fin()
					end)
					return
				end
				-- simpan place dari presence untuk target scan yang tepat
				if place then r.place = place end
			end

			local rp = forcePlace or tonumber(r.place)
			if r.status == "ingame" and rp and type(r.job) == "string" and r.job ~= "" and not forcePlace and not resume then
				F.status = "Selesai · KETEMU (presence)"
				F.hit = { jobId = r.job, place = rp, avatar = false, verified = true, instant = true }
				fin()
				task.spawn(function() pcall(U.geoTo, r, r.job, rp, fin) fin() end)
				return
			end
			local targets, seenP = {}, {}
			local function add(pl) pl = tonumber(pl) if pl and not seenP[pl] then seenP[pl] = true targets[#targets + 1] = pl end end
			-- AKURASI: scan game target dulu (kalau ketahuan), baru game yang kamu mainkan
			if rp then add(rp) end
			add(PLACE)
			if not forcePlace then
				for _, nm in ipairs({ r.where, r.rolo and r.rolo.loc }) do
					if type(nm) == "string" and nm ~= "" then
						local okN, pidN = pcall(U.placeFromName, nm)
						if okN and pidN then add(pidN) end
					end
				end
				local a = r.act
				if a and a.place and os.time() - (a.t or 0) < 7200 then add(a.place) end
				local sn = state.lookSeen and state.lookSeen[tostring(r.uid)]
				if sn and tonumber(sn.p) then add(sn.p) end
				for _, e in ipairs(r.actList or {}) do add(e.place) end
			end
			for _, pl in ipairs(extraPlaces or {}) do add(pl) end
			F.status = resume and "Melanjutkan scan..." or ("Scan avatar di " .. #targets .. " game (akurasi tinggi)...")
			if onProgress then pcall(onProgress) end
			local hit
			local myTok = (U.fndTok or 0) + 1
			U.fndTok = myTok
			-- satu putaran; tidak auto-ulang
			for idx, pl in ipairs(targets) do
				if U.fndTok ~= myTok then break end
				hit = U.findInGame(r.uid, onProgress, pl, resume and idx == 1)
				-- hanya terima hit terverifikasi / non-weak; weak lanjut scan game berikutnya
				if hit and (hit.verified or not hit.weak) then break end
				if hit and hit.weak then
					-- simpan sebagai cadangan, lanjut game lain
					F._weakHit = hit
					hit = nil
				end
				if F.paused or U.fndTok ~= myTok then break end
			end
			if not hit and F._weakHit then
				hit = F._weakHit
				F._weakHit = nil
			end
			if U.fndTok == myTok then F.running = false end
			if F.paused and not hit then
				F.status = "Di-stop · " .. tostring(F.checked or 0) .. " pemain / " .. tostring(F.total or 0) .. " server. Pilih Lanjutkan atau Ulang dari awal."
			elseif not hit and not F.paused then
				F.status = "Selesai · TIDAK KETEMU (" .. tostring(F.checked or 0) .. " pemain)."
			end
			if hit then
				local hp = hit.place or rp or PLACE
				r.status, r.place, r.job, r.src, r.unknown = "ingame", hp, hit.jobId, "scan server game", nil
				F.status = "Selesai · KETEMU"
				fin() -- tombol Join langsung muncul; nama game & lokasi menyusul di belakang (tidak menahan UI)
				task.spawn(function()
					pcall(function() r.game = gameNameOf(hp) end)
					fin()
					pcall(U.geoTo, r, hit.jobId, hp, fin)
					fin()
				end)
				return
			end
			fin()
		end)
	end
	function U.lookup(q, onBasic, onLate)
		local r, err = U.resolve(q)
		if not r then return nil, err end
		r.status = "offline"
		if onBasic then pcall(onBasic, r) end
		local req = httpReq()
		local cand = {}
		local pending = 0
		local crit = 0
		local function parC(fn)
			crit = crit + 1
			pending = pending + 1
			task.spawn(function()
				pcall(fn)
				pending = pending - 1
				crit = crit - 1
			end)
		end
		local function par(fn)
			pending = pending + 1
			task.spawn(function()
				pcall(fn)
				pending = pending - 1
			end)
		end
		-- 1) server ini (instan)
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl.UserId == r.uid then cand.server = { place = game.PlaceId, job = game.JobId, display = pl.DisplayName } end
		end
		-- semua sumber lain jalan bersamaan
		par(function()
			local d = apiJson("GET", "https://users.roblox.com/v1/users/" .. r.uid)
			if type(d) == "table" then
				if d.displayName then r.display = d.displayName end
				if type(d.name) == "string" then r.name = d.name end
				r.created = d.created
				if type(d.description) == "string" and d.description:gsub("%s", "") ~= "" then r.bio = d.description end
				r.banned = d.isBanned
			end
		end)
		-- sumber tambahan 2: Rolimons (API lama), endpoint onlinestatus lama, grup utama, game buatan
		parC(function()
			local d = apiJson("GET", "https://www.rolimons.com/playerapi/player/" .. r.uid)
			if type(d) == "table" and d.success ~= false then
				local lo = tonumber(d.last_online or d.lastOnline)
				if lo and lo > 1e12 then lo = lo / 1000 end
				r.rolo2 = { rap = d.rap, value = d.value, rank = d.rank, last = lo, loc = d.last_location }
			end
		end)
		parC(function()
			local d = apiJson("GET", "https://api.roblox.com/users/" .. r.uid .. "/onlinestatus/")
			if type(d) == "table" and (d.IsOnline ~= nil or d.LastOnline) then cand.leg = d end
		end)
		par(function()
			local d = apiJson("GET", "https://groups.roblox.com/v1/users/" .. r.uid .. "/groups/primary/role")
			if type(d) == "table" and type(d.group) == "table" then r.group = d.group.name .. (d.role and d.role.name and (" (" .. d.role.name .. ")") or "") end
		end)
		par(function()
			local d = apiJson("GET", "https://games.roblox.com/v2/users/" .. r.uid .. "/games?limit=3&sortOrder=Desc")
			if type(d) == "table" and type(d.data) == "table" and #d.data > 0 then
				local t = {}
				for _, g in ipairs(d.data) do t[#t + 1] = tostring(g.name) end
				r.made = table.concat(t, ", ")
			end
		end)
		-- sumber tambahan (tanpa API key, tanpa harus se-server): Rolimons, badge terbaru, jumlah teman/follower
		parC(function()
			local d = apiJson("GET", "https://api.rolimons.com/players/v1/playerinfo/" .. r.uid)
			if type(d) == "table" and d.success ~= false then
				local lo = tonumber(d.last_online or d.lastOnline or d.last_seen)
				if lo and lo > 1e12 then lo = lo / 1000 end
				r.rolo = { rap = d.rap, value = d.value, rank = d.rank, premium = d.premium, last = lo, loc = d.last_location }
			end
		end)
		par(function()
			local d = apiJson("GET", "https://badges.roblox.com/v1/users/" .. r.uid .. "/badges?limit=25&sortOrder=Desc")
			if type(d) ~= "table" or type(d.data) ~= "table" or #d.data == 0 then return end
			local ids, byId = {}, {}
			for _, b in ipairs(d.data) do ids[#ids + 1] = tostring(b.id) byId[tostring(b.id)] = b end
			local dd = apiJson("GET", "https://badges.roblox.com/v1/users/" .. r.uid .. "/badges/awarded-dates?badgeIds=" .. table.concat(ids, ","))
			local best
			if type(dd) == "table" and type(dd.data) == "table" then
				for _, e in ipairs(dd.data) do
					local okT, ts = pcall(function() return DateTime.fromIsoDate(e.awardedDate).UnixTimestamp end)
					if okT and ts and (not best or ts > best.t) then best = { t = ts, id = tostring(e.badgeId) } end
				end
			end
			if best then
				local b = byId[best.id] or {}
				local au = b.awardingUniverse
				local gname, rpid = au and au.name, au and au.rootPlaceId
				if not gname and au and au.id then
					local gd = apiJson("GET", "https://games.roblox.com/v1/games?universeIds=" .. tostring(au.id))
					local it = type(gd) == "table" and type(gd.data) == "table" and gd.data[1]
					if it then gname = it.name rpid = rpid or it.rootPlaceId end
				end
				if not gname and type(b.awarder) == "table" and tostring(b.awarder.type) == "Place" and tonumber(b.awarder.id) then
					rpid = rpid or tonumber(b.awarder.id)
					gname = gameNameOf(rpid)
				end
				r.act = { t = best.t, badge = b.name, game = gname, place = rpid }
				-- daftar game dari badge terbaru (untuk scan lintas game)
				local arr, lst, seenU = {}, {}, {}
				for _, e in ipairs(dd.data) do
					local okT, ts = pcall(function() return DateTime.fromIsoDate(e.awardedDate).UnixTimestamp end)
					if okT and ts then arr[#arr + 1] = { t = ts, id = tostring(e.badgeId) } end
				end
				table.sort(arr, function(x, y) return x.t > y.t end)
				for _, e in ipairs(arr) do
					local bb = byId[e.id]
					local au2 = bb and bb.awardingUniverse
					local rp2 = au2 and tonumber(au2.rootPlaceId)
					if rp2 and not seenU[rp2] and #lst < 8 then
						seenU[rp2] = true
						lst[#lst + 1] = { place = rp2, game = au2.name, t = e.t }
					end
				end
				r.actList = lst
			end
		end)
		par(function()
			local f = apiJson("GET", "https://friends.roblox.com/v1/users/" .. r.uid .. "/friends/count")
			local fo = apiJson("GET", "https://friends.roblox.com/v1/users/" .. r.uid .. "/followers/count")
			r.nFriends = type(f) == "table" and f.count or nil
			r.nFollowers = type(fo) == "table" and fo.count or nil
		end)
		if PURL and not cand.server then
			parC(function()
				local d = purl("GET", "presence/" .. r.uid)
				if type(d) == "table" and type(d.t) == "number" then
					if nowMs() - d.t < 30000 and d.j and d.p then cand.db = { place = d.p, job = d.j } else cand.seen = d end
				end
			end)
		end
		if req and not cand.server then
			parC(function()
				if U.cookie then
					local a, info = U.authPresence(r.uid)
					if a then cand.api = a cand.apiAuth = true if a.last then r.lastOnlineIso = a.last end else r.authErr = info end
				end
				if not cand.api then
					local d = apiJson("POST", "https://presence.roblox.com/v1/presence/users", { userIds = { r.uid } })
					local u = type(d) == "table" and type(d.userPresences) == "table" and d.userPresences[1]
					if type(u) == "table" then cand.api = { t = u.userPresenceType, place = u.placeId, job = u.gameId } end
				end
			end)
		end
		if not cand.server then
			parC(function()
				local lname = r.name:lower()
				for _, f in ipairs(friendsRaw()) do
					if f.VisitorId == r.uid or (type(f.UserName) == "string" and f.UserName:lower() == lname) then cand.fr = f end
				end
			end)
		end
		local t0 = os.clock()
		while crit > 0 and os.clock() - t0 < 3.5 do
			-- sumber yang sudah pasti cukup: langsung tampilkan, sisanya menyusul lewat onLate
			if cand.server or cand.db or (cand.api and cand.apiAuth and (cand.api.t ~= 2 or cand.api.place or os.clock() - t0 > 0.6)) then break end
			if cand.api and cand.api.t == 2 and cand.api.place and cand.api.job then break end
			task.wait(0.02)
		end
		task.spawn(function()
			local t1 = os.clock()
			while pending > 0 and os.clock() - t1 < 10 do task.wait(0.1) end
			r.late = true
			if onLate then pcall(onLate, r) end
		end)
		local function setGame(src, label, status)
			r.place, r.job, r.status, r.src = tonumber(src.place), src.job, status or "ingame", label
			r.game = gameNameOf(src.place)
		end
		if cand.server then
			setGame(cand.server, "server ini")
			r.display = cand.server.display or r.display
		elseif cand.db then
			setGame(cand.db, "pengguna script")
		elseif cand.api and cand.api.t == 2 and cand.api.place then
			setGame(cand.api, cand.apiAuth and "API presence (akunmu)" or "API presence")
			r.game = r.game or cand.api.loc
		elseif cand.api and cand.api.t == 2 then
			r.status, r.src, r.game = "ingame", cand.apiAuth and "API presence (akunmu)" or "API presence", cand.api.loc
		elseif cand.fr and cand.fr.IsOnline and (cand.fr.LocationType == 1 or cand.fr.LocationType == 4 or cand.fr.PlaceId) then
			local gid = (type(cand.fr.GameId) == "string" and cand.fr.GameId ~= "") and cand.fr.GameId or nil
			setGame({ place = cand.fr.PlaceId, job = gid }, "teman online")
			r.game = r.game or cand.fr.LastLocation
			r.where = cand.fr.LastLocation
		elseif cand.leg and cand.leg.IsOnline == true and cand.leg.PlaceId and not cand.api then
			setGame({ place = cand.leg.PlaceId, job = (type(cand.leg.GameId) == "string" and cand.leg.GameId ~= "") and cand.leg.GameId or nil }, "API lama")
		elseif cand.api and cand.api.t == 1 then
			r.status, r.src = "online", cand.apiAuth and "API presence (akunmu)" or "API presence"
		elseif cand.api and cand.api.t == 3 then
			r.status, r.src = "studio", cand.apiAuth and "API presence (akunmu)" or "API presence"
		elseif cand.fr then
			r.status, r.src, r.where = cand.fr.IsOnline and "online" or "offline", "teman online", cand.fr.LastLocation
			r.loc = cand.fr.LocationType
			if cand.fr.LocationType == 3 or cand.fr.LocationType == 6 then r.status = "studio" end
		else
			r.src, r.unknown = "tidak terbaca (bukan teman / API butuh login)", true
		end
		if cand.fr then r.lastOnline = cand.fr.LastOnline end
		if not r.lastOnline and cand.leg and cand.leg.LastOnline then r.lastOnline = cand.leg.LastOnline end
		if cand.leg and cand.leg.IsOnline == true and r.status == "offline" then r.status, r.src = "online", "API lama" end
		if cand.apiAuth and cand.api then
			r.where = r.where or cand.api.loc
			if not r.lastOnline and r.lastOnlineIso then r.lastOnline = r.lastOnlineIso end
		end
		if r.rolo2 then
			r.rolo = r.rolo or {}
			for k, v in pairs(r.rolo2) do if r.rolo[k] == nil then r.rolo[k] = v end end
		end
		if (r.status == "offline" or r.unknown) and r.rolo and r.rolo.last and r.rolo.loc then
			local ll, age = tostring(r.rolo.loc):lower(), os.time() - r.rolo.last
			if ll ~= "offline" and age < 1200 then
				r.status = ll:find("stud") and "studio" or ((ll:find("game") or ll:find("play")) and "ingame" or "online")
				r.src, r.unknown = "Rolimons (bisa tertunda beberapa menit)", nil
				r.where = r.where or ("Rolimons: " .. tostring(r.rolo.loc))
			elseif r.unknown then
				r.status, r.src, r.unknown = "offline", "Rolimons", nil
			end
		end
		if r.status == "offline" and cand.seen and not r.where then
			local mins = math.max(1, math.floor((nowMs() - cand.seen.t) / 60000))
			r.where = "terakhir terlihat pakai script " .. (mins >= 60 and (math.floor(mins / 60) .. " jam") or (mins .. " mnt")) .. " lalu" .. (cand.seen.g and (" di " .. tostring(cand.seen.g)) or "")
			r.unknown = nil
		end
		local okF, isF = pcall(function() return player:IsFriendsWith(r.uid) end)
		if okF then r.isFriend = isF end
		r.dbg = U.fdbg .. (r.authErr and (" | cookie gagal: " .. tostring(r.authErr)) or "")
		return r
	end

