add("Portal", "\u{1F30C}", C3(255, 150, 45), function(char, pos, gp)
	local orange, blue, void = C3(255, 150, 45), C3(70, 185, 255), Color3.new(0, 0, 0)
	freezeParts(char)
	dim(0.2, 2.8)
	sfx(SND_BASS, 1, 0.4)
	riser(SND_PING, 1, 0.4, 1.4, 0.7)
	local ctr = V3(pos.X, gp.Y + 0.08, pos.Z)
	local roll = ANG(0, 0, PI / 2)
	local orng = fxPart(Enum.PartType.Cylinder, V3(0.15, 1, 1), orange, CFrame.new(ctr) * roll, 0.1)
	local blu = fxPart(Enum.PartType.Cylinder, V3(0.15, 1, 1), blue, CFrame.new(ctr + V3(0, 0.02, 0)) * roll, 0.15)
	local inner = fxPart(Enum.PartType.Cylinder, V3(0.2, 1, 1), void, CFrame.new(ctr + V3(0, 0.04, 0)) * roll, 0, Enum.Material.SmoothPlastic)
	tween(orng, 0.5, { Size = V3(0.15, 18, 18) }, Enum.EasingStyle.Back)
	tween(blu, 0.5, { Size = V3(0.15, 14.5, 14.5) }, Enum.EasingStyle.Back)
	tween(inner, 0.5, { Size = V3(0.2, 12, 12) }, Enum.EasingStyle.Back)
	light(ctr + UP * 2, orange, 6, 40, 2)
	local orb = {}
	for i = 1, I(26) do
		local col = (i % 2 == 0) and orange or blue
		local p = fxPart(Enum.PartType.Ball, ONE * 0.5, col, CFrame.new(ctr), 0)
		local a0 = Instance.new("Attachment")
		a0.Position = V3(0, 0.4, 0)
		a0.Parent = p
		local a1 = Instance.new("Attachment")
		a1.Position = V3(0, -0.4, 0)
		a1.Parent = p
		local tr = Instance.new("Trail")
		tr.Attachment0, tr.Attachment1 = a0, a1
		tr.Lifetime, tr.LightEmission, tr.FaceCamera = 0.5, 1, true
		tr.Color = ColorSequence.new(col, WHITE)
		tr.Transparency = NumberSequence.new(0.1, 1)
		tr.WidthScale = NumberSequence.new(1, 0)
		tr.Parent = p
		orb[i] = { p = p, a = R() * 6.28, r = 3 + R() * 6, s = 7 + R() * 5, y = R() * 1.2 }
	end
	local vparts = {}
	for i, p in ipairs(bodyParts(char)) do
		local rel = p.Position - ctr
		vparts[i] = { p = p, size = p.Size, col = p.Color, tr = p.Transparency, dist = V3(rel.X, 0, rel.Z).Magnitude, y = rel.Y, a = math.atan2(rel.Z, rel.X) }
	end
	local T, t0, last = 1.5, os.clock(), os.clock()
	while true do
		local now = os.clock()
		local t = (now - t0) / T
		if t >= 1 then break end
		local dt = math.min(now - last, 0.05)
		last = now
		for _, o in ipairs(orb) do
			o.a += o.s * dt * (1 + t)
			local rr = o.r * (1 - 0.3 * t)
			o.p.Position = ctr + V3(math.cos(o.a) * rr, 0.3 + o.y * (1 - t), math.sin(o.a) * rr)
		end
		local vu = math.clamp((t - 0.15) / 0.85, 0, 1) ^ 1.4
		if vu > 0 then
			for i, v in ipairs(vparts) do
				local rr = v.dist * (1 - 0.8 * vu)
				local ang = v.a + vu * 9
				local y = v.y * (1 - vu) - 3 * vu
				v.p.CFrame = CFrame.new(ctr + V3(math.cos(ang) * rr, y, math.sin(ang) * rr)) * ANG(vu * 4, vu * 6, 0)
				v.p.Size = v.size * (1 - 0.75 * vu)
				v.p.Color = v.col:Lerp((i % 2 == 0) and orange or blue, vu)
			end
		end
		RunService.Heartbeat:Wait()
	end
	for _, o in ipairs(orb) do o.p:Destroy() end
	hide(char)
	boom(1.8, 0.8)
	flash(C3(255, 220, 170), 0.6, 0.6)
	punch(18, 0.5)
	shake(3.5, 0.7)
	tween(orng, 0.3, { Size = V3(0.15, 1, 1), Transparency = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	tween(blu, 0.3, { Size = V3(0.15, 1, 1), Transparency = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	tween(inner, 0.3, { Size = V3(0.2, 1, 1), Transparency = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	ring(ctr, orange, 40, 0.7)
	ring(ctr, blue, 28, 0.55)
	pillar(ctr, orange, 40, 4, 0.8, 0.3)
	burst(ctr, { Color = ColorSequence.new(orange, blue), Speed = NumberRange.new(20, 60), Acceleration = V3(0, 30, 0), Lifetime = NumberRange.new(0.9, 1.6) }, 90)
	rays(ctr + UP * 2, { orange, blue, WHITE }, 30, 34, 0.6)
end)

