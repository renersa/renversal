local fvT=0
local function frame()
if W.s~=s then return end
local _,h2,r2=myParts()
if not(r2 and h2)or h2.Health<=0 then stop("Stopped (you died / respawned)")return end
local tpl=s.tgt
if not(tpl and tpl.Parent)then
if spec.all then if not nextTarget(s)then stop("Done")end else stop("Target left")end
return
end
local tr=rootOf(tpl)
if not tr then
if spec.all and not tpl.Character then if not nextTarget(s)then stop("Done")end end
return
end
local now=os.clock()
if spec.per and now - s.tt>=spec.per then
if not nextTarget(s)then stop("Done")end
return
end
if spec.dur and now - s.tt>=spec.dur then stop()return end
local po,ro=spec.po,spec.ro
if spec.dyn then po,ro=spec.dyn(h2,tr)end
local cf=U.predCF(tr)*CFrame.new(po or Vector3.zero)*(ro or CFrame.new())
if not finite(cf.Position)then return end
if W.prUsed then
local want=true
if spec.cycle then want=((now - s.t0)%(PULSE_ON+PULSE_OFF))<PULSE_ON end
if want then
if s.rep~=tr then attachTo(r2,tr)s.rep,s.attached=tr,true end
elseif s.attached then
detach(r2)
s.rep,s.attached=nil,false
end
end
r2.CFrame=cf
if not spec.noZero then
r2.AssemblyLinearVelocity=(not W.prUsed and spec.vel)or Vector3.zero
r2.AssemblyAngularVelocity=Vector3.zero
end
if spec.nan then
r2.AssemblyAngularVelocity=Vector3.new(0,4e4,0)
r2.AssemblyLinearVelocity=Vector3.new(0,300,0)
end
if spec.sit then h2.Sit=true end
end
s.conns[1]=RunService.Heartbeat:Connect(frame)
s.conns[2]=RunService.RenderStepped:Connect(function()
if W.s~=s then return end
local now=os.clock()
if now - fvT>0.2 then fvT=now keepVisible()end
end)
paint()
end
