			return true
		end
		if #c < 50 then return false, "cookie terlalu pendek" end
		U.cookie = c
		U._poolDirty = true
		U.cookieSource = src or "manual"
		-- auto dari executor: jangan tulis disk; manual/save: boleh file lokal
		if src ~= "executor" and writefile then pcall(writefile, COOKIE_FILE, c) end
		return true
	end
	local function authReq1(method, url, body, ckx)
		if not ckx then return nil, "no cookie" end
		if not url:match("^https://[%w%-%.]*roblox%.com/") then return nil, "host bukan roblox.com" end
		local req = httpReq()
		if not req then return nil, "executor tanpa request" end
		local hdr = { ["Content-Type"] = "application/json", Cookie = ".ROBLOSECURITY=" .. ckx, ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124.0 Safari/537.36", Referer = "https://www.roblox.com/", Origin = "https://www.roblox.com" }
		local js = body and HttpService:JSONEncode(body) or nil
		local variant = 1
		local function go()
			local o = { Url = url, Method = method, Headers = hdr, Body = js }
			if variant == 2 then o.Cookies = { [".ROBLOSECURITY"] = ckx } end
			return pcall(req, o)
		end
		local ok, res = go()
		if ok and type(res) == "table" and tonumber(res.StatusCode) == 401 then variant = 2 ok, res = go() end
		if ok and type(res) == "table" and tonumber(res.StatusCode) == 403 and type(res.Headers) == "table" then
			local tok
			for k, v in pairs(res.Headers) do if tostring(k):lower() == "x-csrf-token" then tok = v end end
			if tok then hdr["X-CSRF-TOKEN"] = tok ok, res = go() end
		end
		if not ok or type(res) ~= "table" then return nil, "request gagal" end
		local d = type(res.Body) == "string" and jdecode(res.Body) or nil
		return d, "HTTP " .. tostring(res.StatusCode or "?")
	end
	-- rotasi multi-cookie: kalau state.ckMulti aktif, tiap request pakai cookie berikutnya (yang kena 429/401 dilewati sementara)
	U._badUntil, U._rr = {}, 0
	function U.cookiePool()
		if not U._pool or U._poolDirty then
			local pool, seen = {}, {}
			local function add(c) if c and c ~= "" and not seen[c] then seen[c] = true pool[#pool + 1] = c end end
			add(U.cookie)
			for _, e in ipairs(U.ckLoad()) do add(e.c) end
			U._pool, U._poolDirty = pool, false
		end
		return U._pool
	end
	function U.cookieCur()
		if not state.ckMulti then return U.cookie end
		local pool = U.cookiePool()
		if #pool == 0 then return U.cookie end
		local now = os.clock()
		for _ = 1, #pool do
			U._rr = U._rr % #pool + 1
			local c = pool[U._rr]
			if (U._badUntil[c] or 0) < now then return c end
		end
		return pool[1]
	end
	function U.cookieBad(c, secs) if c then U._badUntil[c] = os.clock() + (secs or 30) end end
	local function authReq(method, url, body)
		local tries = state.ckMulti and math.min(#U.cookiePool(), 4) or 1
		local d, info
		for _ = 1, math.max(1, tries) do
			local ck = U.cookieCur()
			d, info = authReq1(method, url, body, ck)
			if type(info) == "string" and (info:find("429") or info:find("401")) then
				U.cookieBad(ck, info:find("429") and 25 or 600)
			else
				break
			end
		end
		return d, info
	end
	function U.cookieTestFor(c)
		local d, info = authReq1("GET", "https://users.roblox.com/v1/users/authenticated", nil, c)
		if type(d) == "table" and d.name then return true, d.name end
		return false, tostring(info)
	end
	U.cleanCookie = cleanCookie
	function U.cookieTest()
		local d, info = authReq("GET", "https://users.roblox.com/v1/users/authenticated")
		if type(d) == "table" and d.name then return true, d.name end
		return false, tostring(info)
	end
	local CK_LIST = "ckcb20ces.json"
	function U.ckLoad()
		local out = {}
		pcall(function()
			if isfile and readfile and isfile(CK_LIST) then
				local d = jdecode(readfile(CK_LIST))
				if d and type(d.list) == "table" then out = d.list end
			end
		end)
		return out
	end
	local function ckSave(l)
		U._poolDirty = true
		if writefile then pcall(writefile, CK_LIST, HttpService:JSONEncode({ list = l })) end
	end
	function U.ckClear() ckSave({}) end
	function U.ckAdd(name, c)
		c = cleanCookie(c)
		local l = U.ckLoad()
		for i, e in ipairs(l) do if e.c == c then table.remove(l, i) break end end
		table.insert(l, 1, { n = name, c = c, t = os.time() })
		while #l > 300 do table.remove(l) end
		ckSave(l)
	end
	function U.ckDel(i) local l = U.ckLoad() table.remove(l, i) ckSave(l) end
	function U.ckUse(i)
		local l = U.ckLoad()
		local e = l[i]
		if not e then return false end
		U.setCookie(e.c)
		e.t = os.time()
		table.remove(l, i)
		table.insert(l, 1, e)
		ckSave(l)
		return true, e.n
	end
	function U.authPresence(uid)
		local d, info = authReq("POST", "https://presence.roblox.com/v1/presence/users", { userIds = { uid } })
		local u = type(d) == "table" and type(d.userPresences) == "table" and d.userPresences[1]
		if type(u) == "table" then return { t = u.userPresenceType, place = u.placeId or u.rootPlaceId, job = u.gameId, loc = u.lastLocation, last = u.lastOnline, root = u.rootPlaceId } end
		return nil, info
	end
	-- ---------- cari pemain di SEMUA server game ini: paralel + cocok avatar & identitas ----------
	U.fnd = {
		running = false, cancel = false, found = false, scanned = 0, total = 0, checked = 0, players = 0,
		status = "", hit = nil, uid = nil, paused = false,
		_seen = nil, _pending = nil, _scanPlace = nil, _target = nil, _incomplete = false,
	}
	local function httpPost(url, body)
		local req = httpReq()
		if not req then return nil end
		local ok, r = pcall(req, { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode(body) })
		if ok and type(r) == "table" and type(r.Body) == "string" then return jdecode(r.Body) end
	end
	function U.findInGame(uid, onProgress, scanPlace, resume)
		-- Find v2 (2026): headshot icon target → cocokkan ke SEMUA playerTokens di setiap server.
		-- Jalur GANDA: (A) API app/public  (B) Roblox WEB ber-cookie (.ROBLOSECURITY) biar token
		-- tidak cuma ~5 avatar seperti di UI app. Presence tetap jalur tercepat kalau joins public.
		scanPlace = tonumber(scanPlace) or PLACE
		local F = U.fnd
		F.running = true
		F.cancel = false
		F.found = false
		F.hit = nil
		F.uid = uid
		F.paused = false
		if not resume then
			F.scanned, F.total, F.checked, F.players, F.incomplete = 0, 0, 0, 0, false
			F._seen, F._pending, F._scanPlace, F._target = {}, {}, scanPlace, nil
		else
			F._scanPlace = scanPlace
			F._seen = type(F._seen) == "table" and F._seen or {}
		end
		local lastP = 0
		local gname = (scanPlace ~= PLACE and gameNameOf(scanPlace)) or nil
		local function prog(t, force)
			if gname then t = "[" .. tostring(gname) .. "] " .. t end
			F.status = t
			local now = os.clock()
			if onProgress and (force or now - lastP > 0.2) then lastP = now pcall(onProgress) end
		end
		local function finish(a, b)
			F.running = false
			return a, b
		end
		local function normUrl(u)
			if type(u) ~= "string" then return "" end
			local base = u:match("^(.-)%?") or u
			return base:lower()
		end

		-- ===== 1) target headshot (2 size: app + web sering beda cache) =====
		prog("Mengambil icon headshot target...", true)
		local targetSet = {}
		local targetUrl = nil
		-- headshot + full body + bust (3 endpoint paralel size)
		local endpoints = {
			{ "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=%s&size=%s&format=Png&isCircular=false", { "150x150", "48x48", "60x60" } },
			{ "https://thumbnails.roblox.com/v1/users/avatar?userIds=%s&size=%s&format=Png&isCircular=false", { "150x150", "48x48" } },
			{ "https://thumbnails.roblox.com/v1/users/avatar-bust?userIds=%s&size=%s&format=Png&isCircular=false", { "150x150", "48x48" } },
		}
		local pending = 0
		for _, ep in ipairs(endpoints) do
			for _, size in ipairs(ep[2]) do
				pending = pending + 1
				task.spawn(function()
					for attempt = 1, 4 do
						if F.cancel then break end
						local body = http(string.format(ep[1], tostring(uid), size))
						local d = jdecode(body or "")
						local it = d and d.data and d.data[1]
						if it and it.state == "Completed" and type(it.imageUrl) == "string" and it.imageUrl ~= "" then
							targetSet[it.imageUrl] = true
							targetSet[normUrl(it.imageUrl)] = true
							if not targetUrl then targetUrl = it.imageUrl end
							break
						end
						task.wait(0.2)
					end
					pending = pending - 1
				end)
			end
		end
		local tWait = os.clock()
		while pending > 0 and os.clock() - tWait < 8 and not F.cancel do task.wait(0.05) end
		-- fallback rbxthumb (kadang beda CDN path)
		if targetUrl then
			targetSet["https://www.roblox.com/headshot-thumbnail/image?userId=" .. tostring(uid) .. "&width=150&height=150&format=png"] = true
		end
		if not targetUrl then return finish(nil, "avatar target gagal dimuat") end
		F._target = targetUrl
		local function isTargetUrl(url)
			if type(url) ~= "string" then return false end
			return targetSet[url] == true or targetSet[normUrl(url)] == true
		end
		prog("Headshot OK · scan server (app + web)...", true)

		local function rGet(url, useCookie)
			local req = httpReq()
			local hdr = {
				["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124.0 Safari/537.36",
				["Accept"] = "application/json",
				Referer = "https://www.roblox.com/games/" .. tostring(scanPlace),
				Origin = "https://www.roblox.com",
			}
			for try = 1, 8 do
				if F.cancel or F.found then return nil end
				if req then
					local ck = useCookie and (U.cookieCur and U.cookieCur() or U.cookie) or nil
					if ck and ck ~= "" then hdr["Cookie"] = ".ROBLOSECURITY=" .. ck else hdr["Cookie"] = nil end
					local opts = { Url = url, Method = "GET", Headers = hdr }
					if ck and ck ~= "" then
						opts.Cookies = { [".ROBLOSECURITY"] = ck }
					end
					local ok, r = pcall(req, opts)
					if ok and type(r) == "table" then
						local code = tonumber(r.StatusCode or r.status_code)
						if code == 429 then
							if ck and U.cookieBad then U.cookieBad(ck, 20) end
							task.wait(0.45 + try * 0.12)
						elseif type(r.Body) == "string" and #r.Body > 2 then
							return r.Body
						else
							task.wait(0.1 * try)
						end
					else
						task.wait(0.1 * try)
					end
				else
					local b = http(url)
					if b then return b end
					task.wait(0.12 * try)
				end
			end
			return http(url)
		end
		local function rPost(url, payload)
			local req = httpReq()
			if not req then return nil end
			local ok, r = pcall(req, {
				Url = url,
				Method = "POST",
				Headers = { ["Content-Type"] = "application/json", ["Accept"] = "application/json" },
				Body = HttpService:JSONEncode(payload),
			})
			if not ok or type(r) ~= "table" then return nil end
			local code = tonumber(r.StatusCode or r.status_code)
			if code == 429 then return nil, 429 end
			if type(r.Body) == "string" and #r.Body > 2 then
				return jdecode(r.Body)
			end
			return nil
		end

		-- presence cepat (bonus, bukan andalan) — cookie = jalur WEB
		local lastPres = 0
		local function tryPresence()
			local now = os.clock()
			if now - lastPres < 0.9 then return nil end
			lastPres = now
			local job, place = nil, nil
			if U.cookie and U.cookie ~= "" then
				local pr = U.authPresence and U.authPresence(uid)
				if type(pr) == "table" and type(pr.job) == "string" and pr.job ~= "" then
					job, place = pr.job, tonumber(pr.place) or tonumber(pr.root)
