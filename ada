-- 11. SLASH (v3: potong merah -> lego -> debu merah) ---------------------
add("Slash", "\u{1F5E1}", C3(255, 55, 50), function(char, pos, gp)
	local red, white, deep = C3(255, 45, 40), C3(255, 240, 232), C3(120, 10, 12)
	freezeParts(char)
	dim(0.2, 3.4)
	defSfx("start", SFX.slash or SND_SLASH, 2.6, 1) -- sfx slash merah (ID dari kamu)

	local N = 6
	for i = 1, N do
		local ang = (i / N) * PI + R() * 0.4
		local dir = V3(math.cos(ang), math.sin(ang) * 0.7, (R() - 0.5) * 1.2).Unit
		local cf = CFrame.lookAt(pos, pos + dir)
		local core = fxPart(Enum.PartType.Block, V3(0.14, 0.4, 1), white, cf, 0)
		local glow = fxPart(Enum.PartType.Block, V3(0.7, 1.6, 1), red, cf, 0.4)
		local halo = fxPart(Enum.PartType.Block, V3(1.4, 3, 1), deep, cf, 0.75)
		tween(core, 0.1, { Size = V3(0.14, 0.25, 34) })
		tween(glow, 0.1, { Size = V3(0.7, 1, 34) })
		tween(halo, 0.12, { Size = V3(1.4, 1.8, 34) })
		task.delay(0.1, function()
			for _, o in ipairs({ core, glow, halo }) do tween(o, 0.4, { Transparency = 1 }) end
		end)
		sfx(SND_SLASH, 0.5, 1.2 + i * 0.06)
		flash(red, 0.2, 0.22)
		punch(6, 0.16)
		shake(1.6, 0.18)
		burst(pos, { Color = ColorSequence.new(white, red), Speed = NumberRange.new(30, 65), Lifetime = NumberRange.new(0.3, 0.8) }, 18)
		for _, p in ipairs(bodyParts(char)) do
			p.CFrame = p.CFrame + V3((R() - 0.5) * 0.5, (R() - 0.5) * 0.5, (R() - 0.5) * 0.5)
		end
		task.wait(0.1)
	end
	task.wait(0.12)

	flash(white, 0.35, 0.6)
	punch(18, 0.45)
	shake(3, 0.5)
	ring(gp, red, 40, 0.6)
	ring(gp, deep, 26, 0.5)
	light(pos, red, 9, 60, 1.6)
	slotSfx("shatter", SFX.lego, 2.6, 1)
	sfx(SND_BOOM, 0.4, 1.4)

	-- hancur jadi lego
	local palette = { C3(196, 40, 28), C3(13, 105, 172), C3(245, 205, 48), C3(75, 151, 75), C3(250, 250, 250), C3(218, 133, 65) }
	local SZ = { V3(1, 1.2, 1), V3(1, 1.2, 1), V3(1, 1.2, 2), V3(2, 1.2, 1), V3(2, 1.2, 2) }
	local bricks = {}
	for _, bp in ipairs(bodyParts(char)) do
		if bp.Transparency < 1 then
			local vol = bp.Size.X * bp.Size.Y * bp.Size.Z
			local n = math.clamp(math.floor(vol * 0.9 * state.intensity + 0.5), 2, 6)
			for _ = 1, n do
				local sz = SZ[R(1, #SZ)]
				local at = bp.CFrame:PointToWorldSpace(V3((R() - 0.5) * bp.Size.X, (R() - 0.5) * bp.Size.Y, (R() - 0.5) * bp.Size.Z))
				local b = fxPart(Enum.PartType.Block, sz, (R() < 0.55) and bp.Color or palette[R(1, #palette)], CFrame.new(at) * ANG(R() * 6, R() * 6, R() * 6), 0, Enum.Material.Plastic, 12)
				b.TopSurface = Enum.SurfaceType.Studs
				b.BottomSurface = Enum.SurfaceType.Inlet
				local away = V3(at.X - pos.X, 0, at.Z - pos.Z)
				if away.Magnitude < 0.1 then away = V3(R() - 0.5, 0, R() - 0.5) end
				away = away.Unit * (3 + R() * 7) + V3(R() - 0.5, 0, R() - 0.5) * 3
				bricks[#bricks + 1] = {
					p = b, v = V3(away.X, 14 + R() * 12, away.Z),
					spin = V3((R() - 0.5) * 14, (R() - 0.5) * 14, (R() - 0.5) * 14),
					hh = sz.Y / 2, bounces = 0, done = false, yaw = R() * 6.28,
				}
			end
		end
	end
	hide(char)
	burst(pos, { Color = ColorSequence.new(white, red), Speed = NumberRange.new(40, 90) }, 60)

	local G = -90
	local t0, last = os.clock(), os.clock()
	while os.clock() - t0 < 0.85 do
		local now = os.clock()
		local dt = math.min(now - last, 0.05)
		last = now
		for _, b in ipairs(bricks) do
			if not b.done then
				local p = b.p
				b.v = b.v + V3(0, G * dt, 0)
				local np = p.Position + b.v * dt
				local floor = gp.Y + b.hh
				if np.Y <= floor then
					np = V3(np.X, floor, np.Z)
					if b.bounces < 2 and math.abs(b.v.Y) > 6 then
						b.v = V3(b.v.X * 0.5, -b.v.Y * 0.3, b.v.Z * 0.5)
						b.bounces += 1
						if R() < 0.3 then
							burst(np, { Color = ColorSequence.new(red, deep), Speed = NumberRange.new(4, 10), Lifetime = NumberRange.new(0.3, 0.6) }, 2)
						end
					else
						b.done = true
					end
				end
				if b.done or b.bounces > 0 then
					p.CFrame = CFrame.new(np) * ANG(0, b.yaw, 0)
				else
					local e = now - t0
					p.CFrame = CFrame.new(np) * ANG(b.spin.X * e, b.spin.Y * e, b.spin.Z * e)
				end
			end
		end
		RunService.Heartbeat:Wait()
	end
	task.wait(0.1)

	-- lego jadi debu merah
	sfx(SND_BASS, 0.8, 0.5)
	local wind = V3(10, 4, (R() - 0.5) * 6)
	local mist = fxPart(Enum.PartType.Ball, ONE * 0.5, red, CFrame.new(V3(pos.X, gp.Y + 1, pos.Z)), 1, nil, 6)
	local em = stream(mist, { Color = ColorSequence.new(red, deep), Texture = TEX_SMOKE, LightEmission = 0.6, Size = NS(3, 9), Lifetime = NumberRange.new(1.2, 2.2), Speed = NumberRange.new(4, 14), Acceleration = wind * 0.4 + V3(0, 3, 0), Rate = 70 })
	embers(V3(pos.X, gp.Y, pos.Z), red, 30, 9, 14)
	for _, b in ipairs(bricks) do
		local p = b.p
		task.delay(R() * 0.4, function()
			p.Material = Enum.Material.Neon
			tween(p, 0.15, { Color = red })
			task.wait(0.08)
			tween(p, 0.6 + R() * 0.5, {
				Position = p.Position + wind * (0.5 + R()) + V3(0, 1 + R() * 5, (R() - 0.5) * 6),
				Size = ONE * 0.08, Transparency = 1, Color = deep,
				Orientation = V3(R(0, 360), R(0, 360), R(0, 360)),
			}, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
			if R() < 0.4 then
				burst(p.Position, { Color = ColorSequence.new(red, deep), Texture = TEX_SMOKE, LightEmission = 0.3, Speed = NumberRange.new(1, 6), Lifetime = NumberRange.new(0.9, 1.5), Acceleration = wind * 0.4, Size = NS(1.2, 3) }, 1)
			end
		end)
	end
	task.wait(1.3)
	em.Enabled = false
end)

-- 12. ASCEND (malaikat bersayap 3 lapis bulu, halo, naik ke cahaya) ----
add("Ascend", "\u{1F47C}", C3(255, 224, 130), function(char, pos, gp)
	local gold, white, pearl = C3(255, 214, 110), C3(255, 252, 240), C3(255, 236, 196)
	freezeParts(char)
	sfx(SND_PING, 1, 1.7)
	defSfx("boom", SFX.golden, 1.2, 1.2)
	sfx(SND_PING, 0.8, 2.4)
	dim(0.12, 3.6)
	flash(C3(255, 245, 210), 0.7, 0.3)
	shake(0.8, 1.5)
	light(pos, gold, 9, 70, 3.2)
	rays(gp + UP * 4, { gold, white }, 30, 52, 1.2)
	pillar(gp, gold, 110, 10, 2.8, 0.6)
	pillar(gp, white, 110, 4.5, 2.6, 0.2)
	ring(gp, gold, 40, 1)
	task.delay(0.25, function() ring(gp, white, 26, 0.9) end)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local rcf = hrp and hrp.CFrame or CFrame.new(pos)
	local _, yaw = rcf:ToEulerAnglesYXZ()
	local origin = rcf.Position
	local function base(side, rise)
		return CFrame.new(origin + UP * rise) * ANG(0, yaw, 0) * CFrame.new(side * 0.55, 1.6, 0.75) * ANG(0, side * rad(-18), 0)
	end
	-- tiga lapis bulu: primer (panjang), sekunder, penutup
	local ROWS = {
		{ n = 11, L0 = 4.4, L1 = 11.5, w = 0.58, z = 0.00, col = white, mat = Enum.Material.Neon, a0 = -30, a1 = 84, tip = true },
		{ n = 10, L0 = 3.2, L1 = 7.6, w = 0.74, z = -0.07, col = pearl, mat = Enum.Material.Neon, a0 = -12, a1 = 78 },
		{ n = 9, L0 = 2.2, L1 = 4.6, w = 0.86, z = -0.14, col = white, mat = Enum.Material.SmoothPlastic, a0 = 4, a1 = 72 },
	}
	local feathers = {}
	for side = -1, 1, 2 do
		for _, row in ipairs(ROWS) do
			for k = 1, row.n do
				local u = (k - 1) / (row.n - 1)
				local L = row.L0 + (row.L1 - row.L0) * math.sin(u * PI * 0.85 + 0.12)
				local f = {
					side = side, theta = rad(row.a0 + (row.a1 - row.a0) * u), L = L, z = row.z, u = u,
					p = fxPart(Enum.PartType.Block, V3(L, 0.07, row.w * (0.9 + 0.25 * u)), row.col:Lerp(gold, u * 0.35), CFrame.new(origin), 1, row.mat, 9),
				}
				if row.tip then
					f.tip = fxPart(Enum.PartType.Block, V3(1.1, 0.09, row.w * 0.8), gold, CFrame.new(origin), 1, Enum.Material.Neon, 9)
				end
				feathers[#feathers + 1] = f
			end
		end
	end
	local function place(f, e, flap, rise, alpha)
		local th = rad(98) + (f.theta - rad(98)) * e + flap * (0.4 + f.u * 0.6)
		local cf = base(f.side, rise) * ANG(0, 0, f.side * th)
		f.p.CFrame = cf * CFrame.new(f.side * f.L / 2, 0, f.z)
		f.p.Transparency = alpha
		if f.tip then
			f.tip.CFrame = cf * CFrame.new(f.side * (f.L - 0.5), 0, f.z)
			f.tip.Transparency = alpha
		end
	end
	local parts, orig = bodyParts(char), {}
	for i, p in ipairs(parts) do
		orig[i] = p.CFrame
		tween(p, 0.7, { Color = white })
	end
	local halo = fxPart(Enum.PartType.Cylinder, V3(0.16, 3.4, 3.4), gold, CFrame.new(origin + UP * 3.7) * ANG(0, 0, PI / 2), 1, Enum.Material.Neon, 9)
	local halo2 = fxPart(Enum.PartType.Cylinder, V3(0.1, 4.4, 4.4), white, CFrame.new(origin + UP * 3.7) * ANG(0, 0, PI / 2), 1, Enum.Material.Neon, 9)
	local core = fxPart(Enum.PartType.Ball, ONE, white, CFrame.new(origin + UP * 1.5), 1, nil, 9)
	local sparks = stream(core, { Color = ColorSequence.new(white, gold), Size = NS(0.9, 0), Lifetime = NumberRange.new(0.8, 1.6), Speed = NumberRange.new(2, 8), Rate = 70, Acceleration = V3(0, -2, 0) })
	local T, t0, nextShed = 3.6, os.clock(), 0
	while true do
		local t = os.clock() - t0
		if t >= T then break end
		local ue = math.clamp(t / 0.8, 0, 1)
		local e = 1 + 2.2 * (ue - 1) ^ 3 + 1.2 * (ue - 1) ^ 2
		e = math.clamp(e, 0, 1.12)
		local flap = (t > 0.8 and t < 2.9) and math.sin((t - 0.8) * 5.4) * rad(17) or 0
		local rise = (t > 0.9) and (28 * ((t - 0.9) / 2.7) ^ 2) or 0
		local fade = math.clamp((t - 2.8) / 0.8, 0, 1)
		local appear = 1 - math.clamp(t / 0.3, 0, 1) * 0.97
		local alpha = math.max(appear, fade)
		for _, f in ipairs(feathers) do place(f, e, flap, rise, alpha) end
		for i, p in ipairs(parts) do
			p.CFrame = orig[i] + UP * rise
			p.Transparency = fade
		end
		local pulse = 1 + math.sin(t * 6) * 0.06
		halo.Size = V3(0.16, 3.4 * pulse, 3.4 * pulse)
		halo2.Size = V3(0.1, 4.4 * pulse, 4.4 * pulse)
		halo.CFrame = CFrame.new(origin + UP * (3.7 + rise + math.sin(t * 3) * 0.12)) * ANG(0, 0, PI / 2)
		halo2.CFrame = halo.CFrame
		halo.Transparency = math.max(1 - math.clamp(t / 0.5, 0, 1), fade)
		halo2.Transparency = math.max(0.5 - math.clamp(t / 0.5, 0, 0.5), fade)
		core.Position = origin + UP * (1.5 + rise)
		if t > 0.8 and t < 2.9 and t > nextShed then
			nextShed = t + 0.1
			local src = feathers[R(1, #feathers)]
			local fp = src.p.Position
			local fl = fxPart(Enum.PartType.Block, V3(0.5 + R() * 0.7, 0.04, 0.16), (R() < 0.4) and gold or white, CFrame.new(fp) * ANG(R() * 6, R() * 6, R() * 6), 0.05, Enum.Material.Neon, 3)
			tween(fl, 2, { Position = fp - UP * (10 + R() * 6) + V3((R() - 0.5) * 8, 0, (R() - 0.5) * 8), Orientation = V3(R(0, 360), R(0, 360), R(0, 360)), Transparency = 1 }, Enum.EasingStyle.Sine)
		end
		RunService.Heartbeat:Wait()
	end
	sparks.Enabled = false
	for _, f in ipairs(feathers) do
		f.p:Destroy()
		if f.tip then f.tip:Destroy() end
	end
	halo:Destroy()
	halo2:Destroy()
