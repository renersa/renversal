			gal.which = nil
		end
		local refreshGallery
		local function choose(w, kind, addSave)
			local K = KEYS[w]
			state[K.kind] = kind
			if addSave then
				local list = state[K.saved]
				for i = #list, 1, -1 do if list[i] == kind then table.remove(list, i) end end
				table.insert(list, 1, kind)
				while #list > 30 do table.remove(list) end
			end
