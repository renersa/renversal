	local function haversine(a1, o1, a2, o2)
		local r = math.rad
		local x = math.sin(r(a2 - a1) / 2) ^ 2 + math.cos(r(a1)) * math.cos(r(a2)) * math.sin(r(o2 - o1) / 2) ^ 2
		return 12742 * math.asin(math.min(1, math.sqrt(x)))
	end
