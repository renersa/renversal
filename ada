add("Cyclone", "\u{1F32A}", C3(120, 225, 220), function(char, pos, gp)
	local teal, white = C3(120, 225, 220), C3(235, 255, 252)
	freezeParts(char)
	sfx(SND_BASS, 1, 0.8)
	dim(0.14, 2.4)
