function U.ccatSearch(q,limit)
q=tostring(q or ""):gsub("^%s+",""):gsub("%s+$","")
if#q<2 then return{},"ketik minimal 2 huruf" end
limit=clamp(tonumber(limit)or 30,1,50)
local urls={
"https://catalog.roblox.com/v1/search/items/details?Category=11&Keyword=" .. HttpService:UrlEncode(q).. "&Limit=" .. limit,
"https://catalog.roblox.com/v2/search/items/details?Keyword=" .. HttpService:UrlEncode(q).. "&Category=11&Limit=" .. limit,
"https://catalog.roblox.com/v1/search/items?category=Accessories&keyword=" .. HttpService:UrlEncode(q).. "&limit=" .. limit,
}
local items,seen={},{}
for _,u in ipairs(urls)do
local body=http(u)
local d=jdecode(body or "")
local arr=d and(d.data or d)
if type(arr)=="table" then
for _,it in ipairs(arr)do
local id=tonumber(it.id or it.itemId or(it.item and it.item.id))
local nm=it.name or(it.item and it.item.name)or("Item " .. tostring(id))
if id and not seen[id]then
seen[id]=true
items[#items+1]={
id=id,name=tostring(nm),cat="Search",
price=tonumber(it.price),creator=it.creatorName,live=true,
}
end
end
end
if#items>0 then break end
end
return items,#items==0 and "tidak ada hasil / API diblokir" or nil
end
