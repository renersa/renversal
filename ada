			local MUL, DIV = utf8.char(215), utf8.char(247)
			local ex, justEq, lastExpr = "", false, ""
			local function fmt(n)
				if n ~= n or n == math.huge or n == -math.huge then return nil end
				local s = string.format("%.12g", n)
				if s == "-0" then s = "0" end
				return s
			end
			-- tokenizer + parser (tanpa loadstring)
			local function tokenize(str)
				local chars = {}
				for _, cp in utf8.codes(str) do chars[#chars + 1] = utf8.char(cp) end
				local toks, i = {}, 1
				while i <= #chars do
					local ch = chars[i]
					if ch:match("%d") or ch == "." then
						local j, seen = i, ""
						while j <= #chars and (chars[j]:match("%d") or chars[j] == ".") do seen = seen .. chars[j] j += 1 end
						if chars[j] == "e" and chars[j + 1] and (chars[j + 1]:match("%d") or ((chars[j + 1] == "+" or chars[j + 1] == "-") and chars[j + 2] and chars[j + 2]:match("%d"))) then
							seen = seen .. "e" .. chars[j + 1]
							j += 2
							while j <= #chars and chars[j]:match("%d") do seen = seen .. chars[j] j += 1 end
						end
						local v = tonumber(seen)
						if not v then error("num") end
						toks[#toks + 1] = v
						i = j
					elseif ch:match("%a") then
						local j, w = i, ""
						while j <= #chars and chars[j]:match("%a") do w = w .. chars[j] j += 1 end
						if w ~= "sqrt" and w ~= "pi" then error("fn") end
						toks[#toks + 1] = w
						i = j
					else
						toks[#toks + 1] = ch
						i += 1
					end
				end
				return toks
			end
			local function evaluate(str)
				local toks, pos = tokenize(str), 1
				local expr, unary
				local function primary()
					local t = toks[pos]
					if t == nil then error("end") end
					if type(t) == "number" then pos += 1 return t end
					if t == "(" then
						pos += 1
						local v = expr()
						if toks[pos] == ")" then pos += 1 end
						return v
					end
					if t == "pi" then pos += 1 return math.pi end
					if t == "sqrt" then
						pos += 1
						local v = primary()
						if v < 0 then error("neg") end
						return math.sqrt(v)
					end
					error("tok")
				end
				local function postfix()
					local v = primary()
					while toks[pos] == "%" do pos += 1 v = v / 100 end
					return v
				end
				local function power()
					local v = postfix()
					if toks[pos] == "^" then
						pos += 1
						v = v ^ unary()
					end
					return v
				end
				function unary()
					if toks[pos] == "-" then pos += 1 return -unary() end
					if toks[pos] == "+" then pos += 1 return unary() end
					return power()
				end
				local function term()
					local v = unary()
					while true do
						local t = toks[pos]
						if t == MUL then pos += 1 v = v * unary()
						elseif t == DIV then
							pos += 1
							local b = unary()
							if b == 0 then error("div0") end
							v = v / b
						elseif type(t) == "number" or t == "(" or t == "pi" or t == "sqrt" then
							v = v * unary()
						else break end
					end
					return v
				end
				function expr()
					local v = term()
					while toks[pos] == "+" or toks[pos] == "-" do
						local o = toks[pos]
						pos += 1
						local b = term()
						v = (o == "+") and (v + b) or (v - b)
					end
					return v
				end
				local v = expr()
				if pos <= #toks then error("rest") end
				if v ~= v or v == math.huge or v == -math.huge then error("inf") end
				return v
			end
			local function prep(str)
				local s = str:gsub("[%+%-%^]+$", ""):gsub(MUL .. "+$", ""):gsub(DIV .. "+$", "")
				local open = select(2, s:gsub("%(", "")) - select(2, s:gsub("%)", ""))
				if open > 0 then s = s .. string.rep(")", open) end
				return s
			end
			local function tryEval(str)
				local ok, v = pcall(evaluate, prep(str))
				if ok then return v end
			end
			local function refresh()
				if justEq then
					exprL.Text = lastExpr .. " ="
					return
				end
				exprL.Text = (ex == "") and "0" or ex
				if ex:find("[%+%-%^%%%(%)]") or ex:find(MUL, 1, true) or ex:find(DIV, 1, true) or ex:find("sqrt", 1, true) or ex:find("pi", 1, true) then
					local v = tryEval(ex)
					resL.Text = v and ("= " .. fmt(v)) or ""
				else
					resL.Text = ""
				end
			end
			local function addHist(text, full)
				hOrder += 1
				local b = mk("TextButton", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Text = text, TextWrapped = true, Font = FONT, TextSize = 12, TextColor3 = TXT, TextXAlignment = RIGHT, AutoButtonColor = false, LayoutOrder = -hOrder }, hist)
				b.MouseButton1Click:Connect(function()
					click()
					ex, justEq = full, false
					resL.Text = ""
					refresh()
				end)
			end
			local function isOp(c) return c == "+" or c == "-" or c == MUL or c == DIV or c == "^" end
			local function lastCh() return (ex ~= "") and ex:sub(-1) or "" end
			local function lastChar()
				if ex == "" then return "" end
				local o = utf8.offset(ex, -1)
				return ex:sub(o)
			end
			local function press(t)
				if t == "C" then ex, justEq = "", false resL.Text = "" refresh() return end
				if t == "DEL" then
					if justEq then ex, justEq = "", false resL.Text = "" else
						if ex ~= "" then
							local tail = ex:match("sqrt%($") or ex:match("pi$")
							if tail then ex = ex:sub(1, #ex - #tail) else ex = ex:sub(1, utf8.offset(ex, -1) - 1) end
						end
					end
					refresh()
					return
				end
				if t == "=" then
					if ex == "" or justEq then return end
					local v = tryEval(ex)
					if v == nil then resL.Text = "Error" return end
					local shown = fmt(v)
					addHist(ex .. " = " .. shown, ex)
					lastExpr, ex, justEq = ex, shown:gsub("e%+?", "e"), true
					resL.Text = shown
					refresh()
					return
				end
				local isDigit = t:match("^%d$") or t == "." or t == "pi" or t == "(" or t == "sqrt("
				if justEq then
					if isDigit then ex = "" end
					justEq = false
					resL.Text = ""
				end
				if t:match("^%d$") then
					ex = ex .. t
				elseif t == "." then
					local seg = ex:match("[%d%.]*$")
					if seg:find("%.") then return end
					if seg == "" then ex = ex .. "0" end
					ex = ex .. "."
				elseif isOp(t) then
					if ex == "" then
						if t == "-" then ex = "-" end
					else
						local lc = lastChar()
						if isOp(lc) then
							if t == "-" and (lc == MUL or lc == DIV or lc == "^") then ex = ex .. t
							elseif ex ~= lc then ex = ex:sub(1, #ex - #lc) .. t end
						elseif lc ~= "(" or t == "-" then
							ex = ex .. t
						end
					end
				elseif t == "%" then
					local lc = lastChar()
					if lc:match("%d") or lc == ")" or lc == "%" then ex = ex .. t end
				elseif t == ")" then
					local open = select(2, ex:gsub("%(", "")) - select(2, ex:gsub("%)", ""))
					local lc = lastChar()
					if open > 0 and (lc:match("%d") or lc == ")" or lc == "%" or lc == "i") then ex = ex .. t end
				elseif #ex < 80 then
					ex = ex .. t
				end
				refresh()
			end
			local BW, BH, GAP = 70, 33, 5
