function TR.file(code) return "trcb20ce_" .. code .. ".json" end
-- pesan error API (mis. "PLEASE SELECT TWO DISTINCT LANGUAGES") bukan terjemahan: tolak & bersihkan dari cache
function TR.bad(tr, src)
	if type(tr) ~= "string" then return true end
	local low, s0 = tr:lower(), tostring(src or ""):lower()
	for _, b in ipairs({ "please select", "distinct language", "mymemory", "query length limit", "no query specified", "invalid language", "you used all available" }) do
		if low:find(b, 1, true) and not s0:find(b, 1, true) then return true end
	end
	return false
end
function TR.load(code)
	if TR.loaded[code] then return end
	TR.loaded[code] = true
	TR.cache[code] = TR.cache[code] or {}
	pcall(function()
		if isfile and readfile and isfile(TR.file(code)) then
			local d = HttpService:JSONDecode(readfile(TR.file(code)))
			if type(d) == "table" then
				for k, v in pairs(d) do
					if type(k) == "string" and type(v) == "string" and not TR.bad(v, k) then TR.cache[code][k] = v end
				end
			end
		end
	end)
end
function TR.fetch(url)
	local body
	pcall(function() body = game:HttpGet(url) end)
	if type(body) == "string" and #body > 2 then return body end
	local req = httpReq and httpReq()
	if req then
		local ok, r = pcall(req, { Url = url, Method = "GET", Headers = { ["User-Agent"] = "Mozilla/5.0", ["Accept"] = "*/*" } })
		if ok and type(r) == "table" and type(r.Body) == "string" and #r.Body > 2 then return r.Body end
	end
	return nil
end
function TR.req(text, code)
	local pre = text:match("^[^%a]*") or ""
	local body = text:sub(#pre + 1)
	if body == "" then return nil end
	code = tostring(code or "en"):lower()
	if code == "zh" then code = "zh-CN" end
	-- bahasa target = English: tidak perlu translate
	if code == "en" or code == "en-us" or code == "en-gb" then return nil end
	local q = HttpService:UrlEncode(body)
	-- 1) Google gtx
	local url = "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=" .. code .. "&dt=t&q=" .. q
	local res = TR.fetch(url)
	if res then
		local okd, d = pcall(function() return HttpService:JSONDecode(res) end)
		if okd and type(d) == "table" and type(d[1]) == "table" then
			local out = {}
			for _, seg in ipairs(d[1]) do
				if type(seg) == "table" and type(seg[1]) == "string" then out[#out + 1] = seg[1] end
			end
			local tr = table.concat(out)
			if tr ~= "" and not TR.bad(tr, body) then return pre .. tr end
		end
	end
	-- 2) MyMemory (wajib beda bahasa; error "select two distinct languages" = src==dst)
	local pair = "en|" .. code
	if code ~= "en" then
		res = TR.fetch("https://api.mymemory.translated.net/get?q=" .. q .. "&langpair=" .. HttpService:UrlEncode(pair))
		if res then
			local okd, d = pcall(function() return HttpService:JSONDecode(res) end)
			if okd and type(d) == "table" and type(d.responseData) == "table" then
				local tr = d.responseData.translatedText
				if type(tr) == "string" and tr ~= "" and not TR.bad(tr, body) and not tr:lower():find("invalid", 1, true) then
					return pre .. tr
				end
			end
		end
	end
	-- 3) LibreTranslate public
	local req = httpReq and httpReq()
	if req then
		local ok, r = pcall(req, {
			Url = "https://libretranslate.com/translate",
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json", ["Accept"] = "application/json" },
			Body = HttpService:JSONEncode({ q = body, source = "auto", target = code:sub(1, 2), format = "text" }),
		})
		if ok and type(r) == "table" and type(r.Body) == "string" then
			local okd, d = pcall(function() return HttpService:JSONDecode(r.Body) end)
			if okd and type(d) == "table" and type(d.translatedText) == "string" and d.translatedText ~= "" and not TR.bad(d.translatedText, body) then
				return pre .. d.translatedText
			end
		end
	end
	return nil
end
function TR.work()
	if TR.run then return end
	TR.run = true
	task.spawn(function()
		local fails, got = 0, {}
		while #TR.q > 0 and alive() do
			local it = table.remove(TR.q, 1)
			local c = TR.cache[it.code]
			if c and c[it.text] == nil then
				local res = TR.req(it.text, it.code)
				if res then
					fails = 0
					c[it.text] = res
					got[it.code] = true
					local key = it.code .. "\0" .. it.text
					local objs = TR.wait[key]
					TR.wait[key] = nil
					if objs and it.code == LANGS[curLang] and res ~= it.text then
						for _, o in ipairs(objs) do
							pcall(function()
								if o.Parent and o.Text == it.text then
									o:SetAttribute("k", it.text)
									o:SetAttribute("tv", res)
									o.Text = res
								end
							end)
						end
					end
				else
					fails = fails + 1
					TR.wait[it.code .. "\0" .. it.text] = nil
					if fails >= 8 then TR.pauseUntil = os.clock() + 30 end
				end
			end
			task.wait(0.12)
		end
		TR.run = false
		for code in pairs(got) do
			pcall(function() if writefile then writefile(TR.file(code), HttpService:JSONEncode(TR.cache[code])) end end)
		end
	end)
end
function TR.get(text, obj)
	if state.autoTr == false then return nil end
	local code = LANGS[curLang]
	TR.load(code)
	local c = TR.cache[code]
	local v = c[text]
	if v ~= nil and TR.bad(v, text) then c[text] = nil v = nil end
	if v ~= nil then
		if v ~= text then return v end
		return nil
	end
	if os.clock() < TR.pauseUntil or #TR.q >= 900 then return nil end
	local key = code .. "\0" .. text
	if not TR.wait[key] then
		TR.wait[key] = {}
		TR.q[#TR.q + 1] = { code = code, text = text }
	end
	if obj then table.insert(TR.wait[key], obj) end
	TR.work()
	return nil
end
local function T(s)
	local row = DICT[s]
	if row then
		local v = row[curLang]
		if type(v) == "string" and v ~= "" then return v end
		-- bahasa di luar DICT bawaan (ja/ko/zh/...): terjemahkan dari English via TR
		local en = row[1] or s
		if curLang ~= 1 and state.autoTr ~= false then
			TR.K[en] = true
			local tr = TR.get(en)
			if type(tr) == "string" and tr ~= "" and tr ~= en then return tr end
		end
		return en
	end
	if TR.K[s] then return TR.get(s) or s end
	return s
end

