			for try = 1, 6 do
				if F.cancel or F.found then break end
				local res, code = rPost("https://thumbnails.roblox.com/v1/batch", payload)
				if code == 429 then
					task.wait(0.35 + try * 0.15)
				elseif res and type(res.data) == "table" then
					data = res.data
					break
				else
					task.wait(0.12 * try)
				end
			end
			if data then
				for _, item in ipairs(data) do
					F.checked = (F.checked or 0) + 1
					if item.state == "Completed" and type(item.imageUrl) == "string" then
						if isTargetUrl(item.imageUrl) then
							local rid = tostring(item.requestId or "")
							local pure = rid:match("^(.-)|") or rid
							local sv = tokenToServer[pure]
							if sv then
								local ok2 = false
								-- verifikasi ulang headshot + body
								for _, typ in ipairs({ "AvatarHeadShot", "Avatar", "AvatarBust" }) do
									local res2 = select(1, rPost("https://thumbnails.roblox.com/v1/batch", {
										{
											requestId = pure,
											type = typ,
											targetId = 0,
											token = pure,
											format = "png",
											size = "150x150",
										},
									}))
									if res2 and type(res2.data) == "table" and res2.data[1]
										and res2.data[1].state == "Completed"
										and isTargetUrl(res2.data[1].imageUrl)
									then
										ok2 = true
										break
									end
								end
								onMatch(sv, ok2)
