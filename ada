local SNDO={boom=SND_BOOM,bass=SND_BASS,ping=SND_PING,snap="rbxasset://sounds/snap.mp3",glass="rbxasset://sounds/glassbreak.wav"}
local function sfxO(id,vol,pitch,fx,delay)
if not state.sound then return end
local function go()sfx(id,vol or 1,pitch or 1)end
if delay and delay>0 then task.delay(delay,go)else go()end
end
local function boomO(power,delay)
power=power or 1
sfxO(SND_BOOM,1.7*power,0.7,nil,delay)
sfxO(SND_BASS,1.4*power,0.42,nil,delay)
sfxO(SND_BOOM,1.0*power,1.3,nil,(delay or 0)+0.03)
end
local function zapO(p)sfxO(SND_PING,1.2,0.4*(p or 1))sfxO(SNDO.snap,1,0.5*(p or 1))sfxO(SND_BASS,0.9,0.6)end
local function shineO(v)v=v or 0.9 sfxO(SND_PING,v,2.0)sfxO(SND_PING,v*0.7,2.5,nil,0.08)sfxO(SND_PING,v*0.5,3.0,nil,0.17)end
local function whistleO(dur,p0,p1,vol)
if not state.sound then return end
vol=vol or 0.5
local s=Instance.new("Sound")
s.SoundId,s.Looped,s.Volume,s.PlaybackSpeed=SND_PING,true,vol*state.volSfx,p0
s.Parent=SoundService
s:Play()
tween(s,dur,{PlaybackSpeed=p1},Enum.EasingStyle.Quad,Enum.EasingDirection.In)
task.delay(dur,function()s:Stop()s:Destroy()end)
end
local function seqO(a,b,c)
if c then return NumberSequence.new({NumberSequenceKeypoint.new(0,a),NumberSequenceKeypoint.new(0.3,b),NumberSequenceKeypoint.new(1,c)})end
return NumberSequence.new({NumberSequenceKeypoint.new(0,a),NumberSequenceKeypoint.new(1,b)})
end
local function glowO(pos,color,size,life)
burst(pos,{Color=ColorSequence.new(color),Speed=NumberRange.new(0,0),Lifetime=NumberRange.new(life,life),Drag=0,Size=NumberSequence.new({NumberSequenceKeypoint.new(0,size*0.3),NumberSequenceKeypoint.new(0.2,size),NumberSequenceKeypoint.new(1,0)})},1)
end
local function shockO(pos,color,endSize,t)
local s=fxPart(Enum.PartType.Ball,ONE*2,color,CFrame.new(pos),0.3,Enum.Material.ForceField)
tween(s,t,{Size=ONE*endSize,Transparency=1})
end
local function trailO(part,color,life,width)
local a0,a1=Instance.new("Attachment"),Instance.new("Attachment")
a0.Position,a1.Position=V3(0,width/2,0),V3(0,-width/2,0)
a0.Parent,a1.Parent=part,part
local t=Instance.new("Trail")
t.Attachment0,t.Attachment1=a0,a1
t.Color=ColorSequence.new(color,WHITE)
t.Transparency=seqO(0,1)
t.WidthScale=seqO(1,0)
t.Lifetime,t.LightEmission,t.FaceCamera=life,1,true
t.Parent=part
end
local function blurO(size,t)
local b=tagged("BlurEffect")
b.Size=size
b.Parent=Lighting
tween(b,t,{Size=0})
Debris:AddItem(b,t+0.3)
end
