	local function fetchGeo()
		if geoInfo.loading then return end
		geoInfo.loading = true
		paintGeo()
		task.spawn(function()
			local body = nil
			pcall(function()
				body = game:HttpGet("http://ip-api.com/json/?fields=status,message,country,city,query")
			end)
			if not body then
				pcall(function()
					local req = httpReq and httpReq()
					if req then
						local ok, r = pcall(req, { Url = "http://ip-api.com/json/?fields=status,message,country,city,query", Method = "GET" })
						if ok and type(r) == "table" then body = r.Body end
					end
				end)
			end
			local d = nil
			pcall(function() d = HttpService:JSONDecode(body or "") end)
			if type(d) == "table" and (d.status == "success" or d.query) then
				geoInfo.ip = tostring(d.query or "?")
				geoInfo.country = tostring(d.country or "?")
				geoInfo.city = tostring(d.city or "?")
				geoInfo.loaded = true
			else
				-- fallback ipify + (tanpa kota)
				local ipb = nil
				pcall(function() ipb = game:HttpGet("https://api.ipify.org") end)
				if type(ipb) == "string" and #ipb > 0 then
					geoInfo.ip = ipb:gsub("%s+", "")
					geoInfo.country, geoInfo.city = "?", "?"
					geoInfo.loaded = true
				else
					geoInfo.loaded = false
				end
			end
			geoInfo.loading = false
			if geoPop.Visible then paintGeo() end
		end)
	end
