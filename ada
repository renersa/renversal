	-- ---------- FPS boost ----------
	local perfOrig = setmetatable({}, { __mode = "k" })
	local perfGen, perfConn, perfQ = 0, nil, nil
	local function chg(inst, prop, val)
		local o = perfOrig[inst]
		if not o then o = {} perfOrig[inst] = o end
		if o[prop] == nil then
			local ok, cur = pcall(function() return inst[prop] end)
			if not ok then return end
			o[prop] = cur
		end
		pcall(function() inst[prop] = val end)
	end
	local PARTICLE = { ParticleEmitter = true, Trail = true, Smoke = true, Fire = true, Sparkles = true, Beam = true }
	local function perfInst(d, lv)
		if d:IsDescendantOf(fxFolder) then return end
		if d:IsA("BasePart") then
			chg(d, "CastShadow", false)
			if lv >= 2 and not d:IsA("Terrain") then
				chg(d, "Material", Enum.Material.SmoothPlastic)
				chg(d, "Reflectance", 0)
			end
			if lv >= 3 and d:IsA("MeshPart") then
				chg(d, "RenderFidelity", Enum.RenderFidelity.Performance)
				chg(d, "TextureID", "")
			end
		elseif PARTICLE[d.ClassName] then
			chg(d, "Enabled", false)
		elseif d:IsA("Explosion") then
			chg(d, "Visible", false)
		elseif lv >= 2 and (d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight")) then
			chg(d, "Enabled", false)
		elseif lv >= 2 and (d:IsA("Decal") or d:IsA("Texture")) then
			chg(d, "Transparency", 1)
		elseif lv >= 3 and d:IsA("SurfaceAppearance") then
			chg(d, "ColorMap", "")
			chg(d, "NormalMap", "")
			chg(d, "MetalnessMap", "")
			chg(d, "RoughnessMap", "")
		end
	end
	local function perfRestore(fast)
		local list = {}
		for inst, props in pairs(perfOrig) do list[#list + 1] = { inst, props } end
		table.clear(perfOrig)
		for i, it in ipairs(list) do
			for p, v in pairs(it[2]) do pcall(function() it[1][p] = v end) end
			if not fast and i % 400 == 0 then task.wait() end
		end
		if perfQ then
			pcall(function() settings().Rendering.QualityLevel = perfQ end)
			perfQ = nil
		end
	end
	local function perfApply(lv, gen)
		if lv >= 2 then
			pcall(function()
				if perfQ == nil then perfQ = settings().Rendering.QualityLevel end
				settings().Rendering.QualityLevel = Enum.QualityLevel["Level0" .. (lv == 2 and 3 or 1)]
			end)
			local t = workspace:FindFirstChildOfClass("Terrain")
			if t then
				chg(t, "WaterWaveSize", 0)
				chg(t, "WaterWaveSpeed", 0)
				chg(t, "WaterReflectance", 0)
				chg(t, "Decoration", false)
			end
		end
		local list = workspace:GetDescendants()
		for i, d in ipairs(list) do
			if gen ~= perfGen or killed or not alive() then return end
			perfInst(d, lv)
			if i % 500 == 0 then task.wait() end
		end
	end
	function U.setPerf(lv)
		state.perf = lv
		perfGen = perfGen + 1
		local gen = perfGen
		if lv > 0 and state.shader then
			state.shader = false
			clearShader()
		end
		if perfConn then perfConn:Disconnect() perfConn = nil end
		if lv > 0 then
			perfConn = workspace.DescendantAdded:Connect(function(d)
				if state.perf > 0 and not killed then task.defer(perfInst, d, state.perf) end
			end)
		end
		task.spawn(function()
			perfRestore(false)
			if lv > 0 and gen == perfGen then perfApply(lv, gen) end
		end)
		U.light()
		if U.sync then U.sync() end
	end
	function U.setShader(on)
		state.shader = on
		if on then
			if state.perf > 0 then
				state.perf = 0
				perfGen = perfGen + 1
				if perfConn then perfConn:Disconnect() perfConn = nil end
				task.spawn(perfRestore, false)
			end
			buildShader()
		else
			clearShader()
		end
		U.light()
		if U.sync then U.sync() end
	end
