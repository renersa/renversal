	-- ---------- cookie akun (opsional, lokal): presence lengkap seperti di web Roblox ----------
	-- Disimpan hanya di file lokal executor (ckcb20ce.txt), TIDAK masuk config/Firebase/log, dan hanya dikirim ke *.roblox.com (tidak pernah ke proxy).
	local COOKIE_FILE = "ckcb20ce.txt"
	local function cleanCookie(c)
		c = tostring(c or ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub('^"', ""):gsub('"$', "")
		c = c:gsub("^%.?ROBLOSECURITY=", "")
		return c
	end
	-- Ambil cookie akun dari executor (HANYA runtime/memori — tidak ditulis ke kode script)
	function U.grabCookie()
		local found = nil
		local function accept(c)
			c = cleanCookie(c)
			if type(c) == "string" and #c > 50 then found = c return true end
			return false
		end
		for _, fn in ipairs({
			function() return getcookie and getcookie(".ROBLOSECURITY") end,
			function() return getcookie and getcookie("ROBLOSECURITY") end,
			function() return getcookie and getcookie("https://www.roblox.com") end,
			function() return getcookie and getcookie("https://roblox.com") end,
			function() return get_cookie and get_cookie(".ROBLOSECURITY") end,
			function() return GetCookie and GetCookie(".ROBLOSECURITY") end,
		}) do
			local ok, v = pcall(fn)
			if ok and accept(v) then return found, "getcookie" end
		end
		do
			local ok, t = pcall(function() return getcookies and getcookies() end)
			if ok and type(t) == "table" then
				for _, k in ipairs({ ".ROBLOSECURITY", "ROBLOSECURITY" }) do
					if accept(t[k]) then return found, "getcookies" end
				end
				for _, v in pairs(t) do
					if type(v) == "string" and (#v > 80 or v:find("WARNING:-DO-NOT-SHARE", 1, true)) then
						if accept(v) then return found, "getcookies" end
					end
				end
			elseif ok and type(t) == "string" then
				local m = t:match("%.ROBLOSECURITY=([^;]+)") or t:match("ROBLOSECURITY=([^;]+)")
				if accept(m or t) then return found, "getcookies" end
			end
		end
		pcall(function()
			if syn and type(syn) == "table" and syn.get_cookie then
				accept(syn.get_cookie(".ROBLOSECURITY"))
			end
		end)
		if found then return found, "syn" end
		pcall(function()
			local req = httpReq()
			if not req then return end
			local ok, r = pcall(req, { Url = "https://www.roblox.com/home", Method = "GET" })
			if ok and type(r) == "table" then
				if type(r.Cookies) == "table" then
					accept(r.Cookies[".ROBLOSECURITY"] or r.Cookies["ROBLOSECURITY"])
				end
			end
		end)
		if found then return found, "request" end
		return nil, "executor tidak expose cookie — tempel manual atau ganti executor yang support getcookie"
	end
	function U.cookieMask(c)
		c = tostring(c or "")
		if #c < 16 then return "(kosong)" end
		return c:sub(1, 8) .. "…" .. c:sub(-6) .. " (" .. #c .. " char)"
	end
	U.cookie = nil
	U.cookieSource = nil
	-- file lokal (bukan dari script)
	pcall(function()
		if isfile and readfile and isfile(COOKIE_FILE) then
			local c = cleanCookie(readfile(COOKIE_FILE))
			if #c > 50 then U.cookie = c U.cookieSource = "file" end
		end
	end)
	-- auto ambil dari executor → memori saja (tidak writefile, tidak masuk .lua)
	if not U.cookie then
		local c, src = U.grabCookie()
