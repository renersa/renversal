		corner(knob, 8)
		switches[#switches + 1] = function()
			local on = state[key]
			tween(track, 0.15, { BackgroundColor3 = on and byName[state.selected].color or SURF2 })
			tween(knob, 0.15, { Position = on and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0) })
		end
		b.MouseButton1Click:Connect(function()
			click()
			state[key] = not state[key]
			syncAll()
			if onChange then onChange(state[key]) end
			saveSoon()
		end)
