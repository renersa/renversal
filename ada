			end)
		end
		local function gbSorts()
			if GB.sorts and #GB.sorts > 0 then return GB.sorts end
			local d = gbGet("https://games.roblox.com/v1/games/sorts?gameSortsContext=GamesDefaultSorts")
			local out = {}
			if d and type(d.sorts) == "table" then
				for _, s in ipairs(d.sorts) do
					if s.token and s.displayName and #out < 5 then out[#out + 1] = { token = s.token, title = tostring(s.displayName) } end
				end
			end
			GB.sorts = out
			return out
		end
		local function gbOmni(q, token)
			local url = "https://apis.roblox.com/search-api/omni-search?searchQuery=" .. HttpService:UrlEncode(q) .. "&pageToken=" .. HttpService:UrlEncode(token or "") .. "&sessionId=" .. GB.sid .. "&pageType=all"
			local d = gbGet(url)
			if not d or type(d.searchResults) ~= "table" then return nil end
			local out = {}
			for _, grp in ipairs(d.searchResults) do
				if tostring(grp.contentGroupType) == "Game" and type(grp.contents) == "table" then
					for _, c in ipairs(grp.contents) do out[#out + 1] = c end
				end
			end
			local nxt = d.nextPageToken
			if type(nxt) ~= "string" or nxt == "" then nxt = nil end
			return out, nxt
		end
		-- muat n game ke satu baris (aman dipanggil berulang untuk "Muat lebih")
		local function gbLoad(row, n)
			if row.loading or row.dead then return end
			row.loading, row.err = true, false
			task.spawn(function()
				local ok, e = pcall(function()
					n = math.clamp(n, 5, 60)
					if row.kind == "sort" then
						local d = gbGet("https://games.roblox.com/v1/games/list?model.sortToken=" .. HttpService:UrlEncode(row.token) .. "&model.startRows=" .. row.start .. "&model.maxRows=" .. n)
						if not d or type(d.games) ~= "table" then row.err, row.more = true, false return end
						for _, g in ipairs(d.games) do
							local r = gbRec(g)
							if r.uid and not row.ids[r.uid] then row.ids[r.uid] = true row.items[#row.items + 1] = r end
						end
						row.start = row.start + #d.games
						row.more = #d.games >= n and d.hasMoreRows ~= false
					else
						row.buf = row.buf or {}
						local guard = 0
						while #row.buf < n and guard < 6 do
							guard = guard + 1
							local progressed = false
							for _, qq in ipairs(row.qs) do
								if not row.done[qq] and not row.dead then
									local lst, nxt = gbOmni(qq, row.tok[qq])
									if not lst then
										-- cadangan: endpoint pencarian lama
										local d = gbGet("https://games.roblox.com/v1/games/list?model.keyword=" .. HttpService:UrlEncode(qq) .. "&model.startRows=" .. (row.start[qq] or 0) .. "&model.maxRows=" .. n)
										if d and type(d.games) == "table" and #d.games > 0 then
											for _, g in ipairs(d.games) do
												local r = gbRec(g)
												if r.uid and not row.ids[r.uid] then row.ids[r.uid] = true row.buf[#row.buf + 1] = r end
											end
											row.start[qq] = (row.start[qq] or 0) + #d.games
											progressed = true
										else
											row.done[qq] = true
										end
									else
										for _, c in ipairs(lst) do
											local r = gbRec(c)
											if r.uid and not row.ids[r.uid] then row.ids[r.uid] = true row.buf[#row.buf + 1] = r end
										end
										row.tok[qq] = nxt
										if not nxt then row.done[qq] = true end
										progressed = true
									end
								end
							end
							if not progressed then break end
						end
						for _, r in ipairs(row.buf) do r.score = gbScore(r, row.q) end
						table.sort(row.buf, function(a, b) return a.score > b.score end)
						for _ = 1, math.min(n, #row.buf) do row.items[#row.items + 1] = table.remove(row.buf, 1) end
						local anyOpen = false
						for _, qq in ipairs(row.qs) do if not row.done[qq] then anyOpen = true end end
						row.more = #row.buf > 0 or anyOpen
						if not GB.sel and row.items[1] then GB.sel = row.items[1] end
					end
				end)
				row.loading = false
				if not ok then row.err = true end
				if not row.dead then gbRender() end
			end)
		end
		local function gbReset()
			for _, r in ipairs(GB.rows) do r.dead = true end
			GB.rows, GB.built, GB.scroll = {}, false, {}
		end
		local function gbEnsure()
			if GB.built then return end
			GB.built = true
			if GB.q ~= "" then
				local qs = { GB.q }
				local full = gbFull(GB.q)
				if full and full ~= GB.q:lower() then qs[#qs + 1] = full end
				local row = { key = "s", title = "HASIL: " .. GB.q, kind = "search", q = GB.q, qs = qs, tok = {}, done = {}, start = {}, items = {}, ids = {}, more = true }
				GB.rows = { row }
				GB.sel = nil
				gbLoad(row, GB.n)
			else
				local mine = GB.rows
				task.spawn(function()
					local sorts = gbSorts()
					local rows = {}
					if #sorts > 0 then
						for i, s in ipairs(sorts) do rows[i] = { key = "h" .. i, title = s.title:upper(), kind = "sort", token = s.token, items = {}, ids = {}, start = 0, more = true } end
					else
						for i, k in ipairs({ "obby", "tycoon", "simulator", "horror", "roleplay" }) do
							rows[i] = { key = "h" .. i, title = "GENRE: " .. k:upper(), kind = "search", q = k, qs = { k }, tok = {}, done = {}, start = {}, items = {}, ids = {}, more = true }
						end
					end
					if GB.rows ~= mine then return end
					GB.rows = rows
					gbRender()
					for _, r in ipairs(rows) do
						if r.dead then return end
						gbLoad(r, GB.n)
						task.wait(0.2)
					end
				end)
			end
		end
		local function gbPid(g, cb)
