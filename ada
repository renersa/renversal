				local d = gbGet("https://games.roblox.com/v1/games?universeIds=" .. tostring(g.uid))
				local it = d and type(d.data) == "table" and d.data[1]
				if it and it.rootPlaceId then g.pid = tonumber(it.rootPlaceId) end
				cb(g.pid)
			end)
		end
