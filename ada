local function bolt(a, b, thick, color, tr, depth)
	local segs, prev, dir = 10, a, b - a
	for i = 1, segs do
		local target = (i == segs) and b or (a + dir * (i / segs) + V3((R() - 0.5) * 9, (R() - 0.5) * 3, (R() - 0.5) * 9))
		local dist = (target - prev).Magnitude
		if dist > 0.05 then
			local seg = fxPart(Enum.PartType.Block, V3(thick, thick, dist), color, CFrame.lookAt(prev, target) * CFrame.new(0, 0, -dist / 2), tr)
			tween(seg, 0.45, { Transparency = 1, Size = V3(thick * 0.2, thick * 0.2, dist) })
			if depth < 2 and i > 2 and i < segs - 1 and R() < 0.35 then
				bolt(target, target + V3((R() - 0.5) * 30, -(6 + R() * 14), (R() - 0.5) * 30), thick * 0.55, color, tr, depth + 1)
			end
		end
		prev = target
	end
end

