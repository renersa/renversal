	-- meteor kecil pengawal
	for i = 1, 3 do
		task.delay(0.25 + i * 0.18, function()
			local a = R() * 6.28
			local land = ctr + V3(math.cos(a) * (9 + R() * 8), 0, math.sin(a) * (9 + R() * 8))
			local from = land + V3((R() - 0.5) * 40, 110, (R() - 0.5) * 40)
			local m = fxPart(Enum.PartType.Ball, ONE * 3.2, rock, CFrame.new(from), 0, Enum.Material.Slate, 3)
			local g = fxPart(Enum.PartType.Ball, ONE * 4.4, orange, CFrame.new(from), 0.5, nil, 3)
			stream(m, { Color = ColorSequence.new(yellow, orange), Texture = TEX_FIRE, Size = NS(4, 0), Lifetime = NumberRange.new(0.4, 0.7), Speed = NumberRange.new(0, 3), Rate = 120 })
			tween(m, 0.55, { Position = land }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tween(g, 0.55, { Position = land }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.wait(0.55)
			m:Destroy()
			g:Destroy()
			sfx(SND_BOOM, 0.8, 0.9)
			ring(land + V3(0, 0.2, 0), orange, 18, 0.5)
			burst(land, { Color = ColorSequence.new(yellow, orange), Texture = TEX_FIRE, Speed = NumberRange.new(14, 38), Size = NS(2.4, 0), Lifetime = NumberRange.new(0.5, 1) }, 20)
			shards(land, rock, 8, Enum.Material.Slate, 18, 0.6)
			light(land, orange, 8, 36, 0.5)
			shake(1.6, 0.35)
		end)
	end
	-- meteor utama: inti batu, serpihan mengorbit, lidah api panjang
	local a = R() * PI * 2
	local from = ctr + V3(math.cos(a) * 80, 175, math.sin(a) * 80)
	local m = fxPart(Enum.PartType.Ball, ONE * 10, rock, CFrame.new(from), 0, Enum.Material.Slate, 5)
	local glow = fxPart(Enum.PartType.Ball, ONE * 13, orange, CFrame.new(from), 0.5, nil, 5)
	local tail = fxPart(Enum.PartType.Block, V3(8, 8, 60), orange, CFrame.new(from), 0.55, Enum.Material.Neon, 5)
	local tail2 = fxPart(Enum.PartType.Block, V3(4, 4, 80), yellow, CFrame.new(from), 0.35, Enum.Material.Neon, 5)
	local chunks = {}
	for i = 1, 6 do
		chunks[i] = { p = fxPart(Enum.PartType.Ball, ONE * (2 + R() * 2.2), (i % 2 == 0) and rock or C3(80, 40, 28), CFrame.new(from), 0, Enum.Material.Slate, 5), a = R() * 6.28, r = 7 + R() * 3, s = 2 + R() * 3, y = (R() - 0.5) * 6 }
	end
	stream(m, { Color = ColorSequence.new(yellow, orange), Texture = TEX_FIRE, Size = NS(10, 0), Lifetime = NumberRange.new(0.5, 0.9), Speed = NumberRange.new(0, 4), Rate = 200 })
	stream(m, { Color = ColorSequence.new(ash), Texture = TEX_SMOKE, LightEmission = 0, Size = NS(6, 15), Lifetime = NumberRange.new(1, 1.7), Speed = NumberRange.new(0, 3), Rate = 70 })
	local pl = Instance.new("PointLight")
	pl.Color, pl.Brightness, pl.Range = orange, 10, 80
	pl.Parent = m
	local T, t0 = 1.0, os.clock()
	while true do
		local t = (os.clock() - t0) / T
		if t >= 1 then break end
		local P = from:Lerp(pos, t * t)
		m.CFrame = CFrame.new(P) * ANG(t * 6, t * 4, 0)
		glow.Position = P
		local back = CFrame.lookAt(P, from)
		tail.CFrame = back * CFrame.new(0, 0, -30)
		tail2.CFrame = back * CFrame.new(0, 0, -40)
		for _, c in ipairs(chunks) do
			local ang = c.a + t * c.s * 6
			c.p.Position = P + V3(math.cos(ang) * c.r, c.y + math.sin(ang * 1.3) * 2, math.sin(ang) * c.r)
		end
		RunService.Heartbeat:Wait()
	end
	m:Destroy()
	glow:Destroy()
	tail:Destroy()
	tail2:Destroy()
	for _, c in ipairs(chunks) do c.p:Destroy() end
	-- dampak
	boom(2.4, 0.75)
	defSfx("boom", SFX.bhimpact, 1.7, 0.9)
	rays(pos, { orange, yellow, WHITE }, 50, 52, 0.9)
	flash(C3(255, 225, 180), 0.9, 0.9)
	punch(32, 0.8)
	shake(8, 1.5)
	light(pos, orange, 16, 110, 1.6)
	sphere(pos, WHITE, 24, 0.3, 0)
	sphere(pos, yellow, 40, 0.5, 0.1)
	sphere(pos, orange, 74, 0.8, 0.5, Enum.Material.ForceField)
	for i = 1, 4 do
		task.delay((i - 1) * 0.1, function() ring(ctr + V3(0, 0.2, 0), (i % 2 == 0) and orange or yellow, 34 + i * 20, 0.7) end)
	end
	local rim = fxPart(Enum.PartType.Cylinder, V3(0.18, 16, 16), orange, CFrame.new(ctr + V3(0, 0.04, 0)) * ANG(0, 0, PI / 2), 0.1, Enum.Material.Neon, 7)
	local crater = fxPart(Enum.PartType.Cylinder, V3(0.2, 12, 12), C3(22, 18, 16), CFrame.new(ctr + V3(0, 0.06, 0)) * ANG(0, 0, PI / 2), 0.03, Enum.Material.Slate, 7)
	tween(rim, 0.2, { Size = V3(0.18, 32, 32) })
	tween(crater, 0.2, { Size = V3(0.2, 25, 25) })
	task.delay(3.4, function()
		tween(rim, 1.6, { Transparency = 1 })
		tween(crater, 1.6, { Transparency = 1 })
	end)
	cracks(ctr, orange)
	-- jamur asap bertingkat
	for i = 1, 9 do
		task.delay(i * 0.06, function()
			local h = 3 + i * 4.6
			local sz = (i == 9) and 22 or (6 + i * 0.9)
			local s = fxPart(Enum.PartType.Ball, ONE * 3, (i > 6) and ash or C3(120, 70, 50), CFrame.new(ctr + V3((R() - 0.5) * 2, 0.5, (R() - 0.5) * 2)), 0.25, Enum.Material.SmoothPlastic, 5)
			tween(s, 1.4, { Position = ctr + V3(0, h, 0), Size = ONE * sz, Transparency = 1 }, Enum.EasingStyle.Quad)
		end)
	end
	-- serpihan panas melengkung lalu mendarat
	for _ = 1, I(16) do
		local dir = V3(R() - 0.5, 0, R() - 0.5).Unit
		local d = 14 + R() * 26
		local peak = ctr + dir * d * 0.5 + V3(0, 9 + R() * 12, 0)
		local land = ctr + dir * d + V3(0, 0.6, 0)
		local c = fxPart(Enum.PartType.Block, ONE * (0.8 + R() * 1.6), orange, CFrame.new(pos) * ANG(R() * 6, R() * 6, R() * 6), 0, Enum.Material.Neon, 5)
		tween(c, 0.5, { Position = peak, Orientation = V3(R(0, 360), R(0, 360), R(0, 360)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(0.5, function()
			tween(c, 0.5, { Position = land }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.5, function()
				tween(c, 1.4, { Color = rock, Transparency = 1 })
				burst(land, { Color = ColorSequence.new(yellow, orange), Speed = NumberRange.new(4, 14), Size = NS(1, 0), Lifetime = NumberRange.new(0.4, 0.8) }, 6)
			end)
		end)
	end
	shards(pos, rock, 26, Enum.Material.Slate, 44, 0.9)
	shards(pos, orange, 22, Enum.Material.Neon, 34, 0.5)
	burst(pos, { Color = ColorSequence.new(yellow, orange), Texture = TEX_FIRE, Speed = NumberRange.new(30, 76), Size = NS(4.5, 0), Lifetime = NumberRange.new(0.8, 1.6), Acceleration = V3(0, 12, 0) }, 50)
	burst(pos, { Color = ColorSequence.new(ash), Texture = TEX_SMOKE, LightEmission = 0, Speed = NumberRange.new(10, 30), Size = NS(5, 12), Lifetime = NumberRange.new(1.5, 2.6), Acceleration = V3(0, 10, 0) }, 30)
	embers(ctr + V3(0, 1, 0), yellow, 40, 24, 22)
	-- api kecil di sekitar kawah
	for i = 1, 6 do
		local a2 = i / 6 * 6.283
		local fp = fxPart(Enum.PartType.Ball, ONE, orange, CFrame.new(ctr + V3(math.cos(a2) * 12, 0.8, math.sin(a2) * 12)), 1, nil, 4)
		local em = stream(fp, { Color = ColorSequence.new(yellow, orange), Texture = TEX_FIRE, Size = NS(3, 0), Lifetime = NumberRange.new(0.5, 0.9), Speed = NumberRange.new(3, 8), Rate = 26, Spread = Vector2.new(20, 20), Acceleration = V3(0, 8, 0) })
		task.delay(2.6, function() em.Enabled = false end)
	end
	launchParts(char, pos, 58, 1.2, 14)
	popup(pos + V3(0, 6, 0), "IMPACT", orange, 36)
end
