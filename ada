task.spawn(function()pcall(U.geoTo,r,r.job,rp,fin)fin()end)
return
end
local targets,seenP={},{}
local function add(pl)pl=tonumber(pl)if pl and not seenP[pl]then seenP[pl]=true targets[#targets+1]=pl end end
if rp then add(rp)end
add(PLACE)
if not forcePlace then
for _,nm in ipairs({r.where,r.rolo and r.rolo.loc})do
