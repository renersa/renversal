		blobs[#blobs + 1] = { p = b, v = V3(math.cos(a) * sp, 30 + R() * 30, math.sin(a) * sp), r = b.Size.X / 2, lava = true, sp = R() * 8 }
	end
	for _, p in ipairs(bodyParts(char)) do
