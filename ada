local TIERS = { [2] = "DOUBLE KILL", [3] = "TRIPLE KILL", [4] = "QUADRA KILL", [5] = "RAMPAGE", [6] = "UNSTOPPABLE", [8] = "GODLIKE", [10] = "LEGENDARY" }
local function tierName(n)
	local best
	for k in pairs(TIERS) do
		if k <= n and (not best or k > best) then best = k end
	end
	return best and TIERS[best]
end

local combo, lastKill, lastPick, active = 0, 0, nil, 0
local recent = setmetatable({}, { __mode = "k" })

local function pickName()
	if not state.random then return state.selected end
	local pool = {}
	for _, e in ipairs(EFFECTS) do
		if state.cat == "ALL" or (state.cat == "FAV" and favs[e.name]) or e.cat == state.cat then pool[#pool + 1] = e.name end
	end
	if #pool == 0 then return state.selected end
	local n
	repeat n = pool[R(1, #pool)] until n ~= lastPick or #pool < 2
	lastPick = n
	return n
end

