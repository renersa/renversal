add("Blade Storm", "\u{1F5E1}", C3(205, 220, 240), function(char, pos, gp)
	local steel, edge, glow, brass = C3(185, 200, 220), C3(245, 250, 255), C3(120, 200, 255), C3(255, 215, 120)
	freezeParts(char)
	dim(0.18, 2.8)
	sfx(SND_SLASH, 1, 0.8)
	riser(SND_BASS, 1.6, 0.5, 1.2, 0.8)
	local nS = I(22)
	local swords = {}
	local function mk(size, color, mat)
		return fxPart(Enum.PartType.Block, size, color, CFrame.new(pos), 0, mat, 8)
	end
	for i = 1, nS do
		local blade = mk(V3(0.55, 0.12, 4.4), steel, Enum.Material.Metal)
		blade.Reflectance = 0.4
		local sharp = mk(V3(0.12, 0.14, 4.4), edge, Enum.Material.Neon)
		local guard = mk(V3(1.5, 0.22, 0.3), brass, Enum.Material.Metal)
		local grip = mk(V3(0.22, 0.22, 1.1), C3(60, 45, 40), Enum.Material.SmoothPlastic)
		local a0 = Instance.new("Attachment")
		a0.Position = V3(0, 0.3, -2.2)
		a0.Parent = blade
		local a1 = Instance.new("Attachment")
		a1.Position = V3(0, -0.3, -2.2)
		a1.Parent = blade
		local tr = Instance.new("Trail")
		tr.Attachment0, tr.Attachment1 = a0, a1
		tr.Lifetime, tr.LightEmission, tr.FaceCamera = 0.4, 1, true
		tr.Color = ColorSequence.new(WHITE, glow)
		tr.Transparency = NumberSequence.new(0.1, 1)
		tr.Parent = blade
		swords[i] = { b = blade, s = sharp, g = guard, r = grip, a = i / nS * PI * 2 + R() * 0.3, h = (R() - 0.5) * 8, ph = R() * 6 }
	end
	local function place(s, cf)
		local bcf = cf * CFrame.new(0, 0, -2.4)
		s.b.CFrame = bcf
		s.s.CFrame = bcf
		s.g.CFrame = cf * CFrame.new(0, 0, -0.1)
		s.r.CFrame = cf * CFrame.new(0, 0, 0.6)
	end
	local parts, pd = bodyParts(char), {}
	for i, p in ipairs(parts) do pd[i] = { cf = p.CFrame, col = p.Color } end
	ring(gp, glow, 30, 0.8)
	local T, t0, flashed = 1.9, os.clock(), false
	while true do
		local t = (os.clock() - t0) / T
		if t >= 1 then break end
		local ease = math.clamp((t - 0.35) / 0.5, 0, 1) ^ 1.6
		local rad = 8 - 6.4 * ease
		for _, s in ipairs(swords) do
			local ang = s.a + t * 6 + t * t * 14
			local y = s.h * (1 - ease) + math.sin(t * 10 + s.ph) * 0.5
			place(s, CFrame.lookAt(pos + V3(math.cos(ang) * rad, y, math.sin(ang) * rad), pos + V3(0, y * 0.2, 0)))
		end
		if t > 0.7 then
			if not flashed then
				flashed = true
				sfx(SND_SNAP, 1.2, 1.4)
				flash(glow, 0.4, 0.3)
			end
			for i, p in ipairs(parts) do
				p.CFrame = pd[i].cf + V3((R() - 0.5) * 0.5, (R() - 0.5) * 0.5, (R() - 0.5) * 0.5)
				p.Color = (R() < 0.4) and WHITE or pd[i].col
			end
		end
		RunService.Heartbeat:Wait()
	end
	boom(2, 0.9)
	sfx(SND_SLASH, 1.2, 1.2)
	flash(WHITE, 0.6, 0.8)
	punch(18, 0.5)
	shake(4, 0.8)
	launchParts(char, pos, 24, 0.9, 10)
	for _, s in ipairs(swords) do
		for _, o in ipairs({ s.b, s.s, s.g, s.r }) do
			local away = o.Position - pos
			if away.Magnitude < 0.1 then away = V3(0, 1, 0) end
			tween(o, 0.8, { Position = o.Position + away.Unit * (14 + R() * 12), Transparency = 1 })
