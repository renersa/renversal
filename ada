add("Disco", "\u{1F57A}", C3(255, 60, 160), function(char, pos, gp)
	local cols = {
		C3(255, 60, 90), C3(255, 160, 40), C3(255, 235, 60), C3(90, 235, 110),
		C3(60, 220, 255), C3(80, 110, 255), C3(255, 70, 200),
	}
