						local hb = mk("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -52, 0.5, 0), Size = UDim2.fromOffset(46, 24), BackgroundColor3 = SURF2, Text = off and "SHOW" or "HIDE", Font = FONTK, TextSize = 10, TextColor3 = TXT, AutoButtonColor = false }, r)
