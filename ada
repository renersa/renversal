	function U.accessList()
		local d = purl("GET", "access")
		if type(d) ~= "table" then return nil end
		local out = {}
		for uid, v in pairs(d) do
			if type(v) == "table" then out[#out + 1] = { uid = uid, n = v.n, by = v.by, t = v.t or 0, exp = v.exp, perm = type(v.perm) == "table" and v.perm or {} } end
		end
		table.sort(out, function(a, b) return a.t > b.t end)
		return out
	end
