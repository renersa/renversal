			-- unduh .rbxm lewat assetdelivery lalu muat dari file lokal
			function()
				if not (writefile and getcustomasset) then return nil end
				local req = httpReq()
				if not req then return nil end
				local ok, r = pcall(req, { Url = "https://assetdelivery.roblox.com/v2/assetId/" .. assetId, Method = "GET", Headers = { ["Accept"] = "application/json" } })
				local d = ok and type(r) == "table" and type(r.Body) == "string" and jdecode(r.Body)
				local url = d and d.locations and d.locations[1] and d.locations[1].location
				if not url then return nil end
				local ok2, r2 = pcall(req, { Url = url, Method = "GET" })
				if not (ok2 and type(r2) == "table" and type(r2.Body) == "string" and #r2.Body > 20) then return nil end
				local fn = "ccat_" .. tostring(assetId) .. ".rbxm"
				if not pcall(writefile, fn, r2.Body) then return nil end
				local ok3, objs = pcall(function() return game:GetObjects(getcustomasset(fn)) end)
				pcall(function() if delfile then delfile(fn) end end)
				if ok3 and type(objs) == "table" and #objs > 0 then return objs end
			end,
		}
		for _, fn in ipairs(methods) do
			local ok, objs = pcall(fn)
			if ok and type(objs) == "table" and #objs > 0 then return objs end
			if ok and typeof(objs) == "Instance" then return { objs } end
		end
		return nil
	end

	local function weldPart(char, part, offset)
		local head = char:FindFirstChild("Head")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
		local anchor = head or hrp or torso
		if not anchor or not part then return false end
		part.Anchored = false
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CastShadow = false
		local w = Instance.new("WeldConstraint")
		w.Part0 = anchor
		w.Part1 = part
		w.Parent = part
		part.CFrame = anchor.CFrame * (offset or cfn(0, 1.4, 0))
		return true
	end

	local function countAcc(ch)
		local n = 0
		for _, c in ipairs(ch:GetChildren()) do
			if c:IsA("Accessory") then n = n + 1 end
		end
		return n
	end

