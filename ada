local d=Vector3.new(tr.Position.X - r.Position.X,0,tr.Position.Z - r.Position.Z)
d=d.Magnitude>0.1 and d.Unit or Vector3.new(r.CFrame.LookVector.X,0,r.CFrame.LookVector.Z)
r.AssemblyLinearVelocity=(d*0.7071+Vector3.new(0,0.7071,0))*sp*m
RunService.RenderStepped:Wait()
if r.Parent then r.AssemblyLinearVelocity=vel end
RunService.Stepped:Wait()
if r.Parent then r.AssemblyLinearVelocity=vel+Vector3.new(0,movel,0)end
movel=-movel
end
end
for pl,t in pairs(seen)do
