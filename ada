local function iceFor(ch,dur)
local h=Instance.new("Highlight")
h.FillColor,h.OutlineColor,h.FillTransparency,h.Parent=Color3.fromRGB(140,220,255),Color3.fromRGB(235,250,255),0.25,ch
local root=ch:FindFirstChild("HumanoidRootPart")
local blk
if root then
blk=Instance.new("Part")
blk.Anchored,blk.CanCollide,blk.CanTouch,blk.CanQuery,blk.Size=true,false,false,false,Vector3.new(5,7,5)
blk.Material,blk.Color,blk.Transparency,blk.CFrame=Enum.Material.Ice,Color3.fromRGB(170,230,255),0.55,root.CFrame
blk.Parent=workspace
end
local gone=false
local function release()
if gone then return end
gone=true
pcall(function()h:Destroy()if blk then blk:Destroy()end end)
end
if dur and dur>0 then task.delay(dur,release)end
if blk then
task.spawn(function()
while not gone and blk.Parent and root and root.Parent do blk.CFrame=root.CFrame task.wait()end
release()
end)
end
return release
end
local function cageAt(c,dur,solid)
