			end
			if not job then
				local okP, pd = pcall(apiJson, "POST", "https://presence.roblox.com/v1/presence/users", { userIds = { uid } })
				local u = okP and type(pd) == "table" and type(pd.userPresences) == "table" and pd.userPresences[1]
				if type(u) == "table" and type(u.gameId) == "string" and u.gameId ~= "" then
					job = u.gameId
					place = tonumber(u.placeId) or tonumber(u.rootPlaceId)
				end
			end
			if job then
				return { jobId = job, place = place or scanPlace, avatar = false, verified = true, fromPresence = true }
			end
			return nil
		end

		-- coba presence dulu (instan)
		do
			local ph0 = tryPresence()
			if ph0 then
				F.hit = ph0
				F.found = true
				prog("KETEMU via presence · JobId " .. tostring(ph0.jobId):sub(1, 13) .. "…", true)
