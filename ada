	-- ---------- cari pemain (username / UserId) + status + join ----------
	local function rtrim(s) return (tostring(s):gsub("^%s+", ""):gsub("%s+$", "")) end
	U.apiErr = ""
	local apiCache = {}
	local function apiJson(method, url, body)
		local ck = (method == "GET") and url or nil
		if ck then
			local c = apiCache[ck]
			if c and os.clock() - c.t < 20 then return c.d end
		end
		local req = httpReq()
		local hosts = { url }
		local px = url:gsub("roblox%.com", "roproxy.com")
		if px ~= url then hosts[2] = px end
		local js = body and HttpService:JSONEncode(body) or nil
		local res, lastd
		local started, finished = #hosts, 0
		for i, u in ipairs(hosts) do
			task.spawn(function()
				local d
				if req then
					local ok, rs = pcall(req, { Url = u, Method = method, Headers = { ["Content-Type"] = "application/json" }, Body = js })
					if ok and type(rs) == "table" and type(rs.Body) == "string" then
						local dd = jdecode(rs.Body)
						if type(dd) == "table" and dd.errors == nil then d = dd else lastd = dd or lastd U.apiErr = "HTTP " .. tostring(rs.StatusCode or "?") .. (i == 2 and " (proxy)" or "") end
					else
						U.apiErr = ok and "respons kosong" or tostring(rs):sub(1, 60)
					end
				else
					U.apiErr = "executor tanpa fungsi request"
				end
				if not d and method == "GET" then
					local ok, bd = pcall(function() return game:HttpGet(u) end)
					if ok and type(bd) == "string" then
						local dd = jdecode(bd)
						if type(dd) == "table" and dd.errors == nil then d = dd end
					end
				end
				if d and not res then res = d end
				finished = finished + 1
			end)
		end
		local t0 = os.clock()
		while not res and finished < started and os.clock() - t0 < 12 do task.wait(0.02) end
		if res and ck then apiCache[ck] = { d = res, t = os.clock() } end
		return res or lastd
	end
	function U.ago(t)
		local s = math.max(0, os.time() - (tonumber(t) or 0))
		if s < 90 then return "baru saja" end
		if s < 3600 then return math.floor(s / 60) .. " mnt lalu" end
		if s < 86400 then return math.floor(s / 3600) .. " jam lalu" end
		if s < 86400 * 60 then return math.floor(s / 86400) .. " hari lalu" end
		return math.floor(s / 2592000) .. " bln lalu"
	end
	function U.resolve(q)
		q = rtrim(q or "")
		if q == "" then return nil, "kosong" end
		-- cek pemain di server ini dulu (instan, tanpa API)
		do
			local ql, nq, part, nPart = q:lower(), tonumber(q), nil, 0
			for _, pl in ipairs(Players:GetPlayers()) do
				local n, d = pl.Name:lower(), pl.DisplayName:lower()
				if pl.UserId == nq or n == ql or d == ql then return { uid = pl.UserId, name = pl.Name, display = pl.DisplayName } end
				if #ql >= 3 and (n:sub(1, #ql) == ql or d:sub(1, #ql) == ql) then part, nPart = pl, nPart + 1 end
			end
			if part and nPart == 1 then return { uid = part.UserId, name = part.Name, display = part.DisplayName } end
		end
		local uid, name, display = tonumber(q), nil, nil
		if uid then
			local ok, n = pcall(function() return Players:GetNameFromUserIdAsync(uid) end)
			if ok and n then
				name = n
			else
				local d = apiJson("GET", "https://users.roblox.com/v1/users/" .. uid)
				if type(d) == "table" and d.name then name, display = d.name, d.displayName else return nil, "UserId tidak ditemukan" end
			end
		else
			local idA, enB, dB, doneA, doneB
			task.spawn(function()
				local okA, idv = pcall(function() return Players:GetUserIdFromNameAsync(q) end)
				if okA and idv then idA = idv end
				doneA = true
			end)
			task.spawn(function()
				dB = apiJson("POST", "https://users.roblox.com/v1/usernames/users", { usernames = { q }, excludeBannedUsers = false })
				local e1 = type(dB) == "table" and type(dB.data) == "table" and dB.data[1]
				if type(e1) == "table" and e1.id then enB = e1 end
				doneB = true
			end)
			local tR = os.clock()
			while not idA and not enB and not (doneA and doneB) and os.clock() - tR < 12 do task.wait(0.02) end
			local ok, id = idA ~= nil, idA
			local d = dB
			if ok and id then
				uid = id
				if enB and enB.id == id then name, display = enB.name, enB.displayName else name = q end
			else
				local en = enB
				if type(en) == "table" and en.id then
					uid, name, display = en.id, en.name, en.displayName
				else
					local sd = apiJson("GET", "https://users.roblox.com/v1/users/search?limit=10&keyword=" .. HttpService:UrlEncode(q))
					local hit
					if type(sd) == "table" and type(sd.data) == "table" then
						for _, u in ipairs(sd.data) do
							if type(u.name) == "string" and u.name:lower() == q:lower() then hit = u break end
						end
					end
					if hit then
						uid, name, display = hit.id, hit.name, hit.displayName
					else
						return nil, "username tidak ditemukan" .. ((d == nil and U.apiErr ~= "") and (" (API Roblox tidak merespons: " .. U.apiErr .. ")") or "")
					end
				end
			end
		end
		return { uid = uid, name = name, display = display or name }
	end
