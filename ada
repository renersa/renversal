		local val = acc(lab(b, "", 12, FONTK, TXT, UDim2.fromScale(0.4, 0), UDim2.new(0.6, -10, 1, 0), RIGHT), "TextColor3")
		syncs[#syncs + 1] = function() val.Text = getText() end
		val.Text = getText()
		b.MouseButton1Click:Connect(function()
			click()
			step()
			syncAll()
			saveSoon()
		end)
