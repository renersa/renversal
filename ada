				local a = R() * 6.28
				drops[#drops + 1] = { p = b, v = V3(math.cos(a) * (4 + R() * 12), 14 + R() * 20, math.sin(a) * (4 + R() * 12)), col = col, r = b.Size.X / 2 }
			end
		end
