	local baseFit = 1
	local function applyPos()
		local c = cam()
		if c then
			local vp = c.ViewportSize
			state.uiX = math.clamp(state.uiX, -vp.X / 2 + 60, vp.X / 2 - 60)
			state.uiY = math.clamp(state.uiY, -vp.Y / 2 + 40, vp.Y / 2 - 40)
		end
		holder.Position = UDim2.new(0.5, state.uiX, 0.5, state.uiY)
	end
	local function clampSize()
		local maxW, maxH = 1100, 720
		local c = cam()
		if c then
			local vp = c.ViewportSize
			maxW = math.min(maxW, math.floor(vp.X * 0.98 / baseFit))
			maxH = math.min(maxH, math.floor(vp.Y * 0.96 / baseFit))
		end
		state.uiW = math.clamp(state.uiW, math.min(520, maxW), maxW)
		state.uiH = math.clamp(state.uiH, math.min(340, maxH), maxH)
		holder.Size = UDim2.fromOffset(state.uiW, state.uiH)
	end
	local function fitScale()
		-- keyboard HP mengecilkan ViewportSize saat mengetik: jangan ikut mengecil (dan jangan ubah ukuran tersimpan)
		if UserInputService:GetFocusedTextBox() then return end
		local c = cam()
		if not c then return end
		local vp = c.ViewportSize
		baseFit = math.clamp(math.min(vp.X * 0.95 / PW, vp.Y * 0.92 / PH), 0.4, 1.15)
		fit.Scale = baseFit
		clampSize()
		applyPos()
	end
	fitScale()
