	shake(1.5, 2)
	light(pos, teal, 4, 40, 2.2)
	ring(gp, teal, 30, 0.7)
	local parts, pd = bodyParts(char), {}
	for i, p in ipairs(parts) do pd[i] = { a = R() * 6.28, r = 0.5 + R() * 1.5, t = p.Transparency } end
	local streaks = {}
	for i = 1, I(28) do
		streaks[i] = {
			p = fxPart(Enum.PartType.Block, V3(0.12, 0.12, 3 + R() * 4), white, CFrame.new(gp), 0.35),
			a = R() * 6.28, h = R(), sp = 4 + R() * 3, rad = 2 + R() * 3,
		}
	end
	local T, t0 = 2, os.clock()
	while true do
		local t = (os.clock() - t0) / T
		if t >= 1 then break end
		for i, p in ipairs(parts) do
			local d = pd[i]
			local ang, rr = d.a + t * 14, d.r + t * 5
			p.CFrame = CFrame.new(pos + V3(math.cos(ang) * rr, t * 26, math.sin(ang) * rr)) * ANG(t * 12, t * 9, 0)
			p.Transparency = math.max(d.t, math.clamp((t - 0.55) / 0.45, 0, 1))
		end
		for _, s in ipairs(streaks) do
			local hh = (s.h + t * 1.4) % 1
			local ang = s.a + t * s.sp * 3
			local rr = 1.5 + hh * s.rad * 2.5 * (0.4 + t)
			local at = V3(pos.X + math.cos(ang) * rr, gp.Y + hh * 30, pos.Z + math.sin(ang) * rr)
			s.p.CFrame = CFrame.lookAt(at, at + V3(-math.sin(ang), 0.15, math.cos(ang)))
			s.p.Transparency = 0.35 + ((t > 0.7) and (t - 0.7) / 0.3 * 0.65 or 0)
		end
		RunService.Heartbeat:Wait()
	end
	for _, s in ipairs(streaks) do s.p:Destroy() end
	hide(char)
	burst(pos + UP * 20, { Color = ColorSequence.new(white, teal), Speed = NumberRange.new(20, 60) }, 60)
	ring(gp, white, 34, 0.6)
	flash(C3(210, 255, 250), 0.4, 0.3)
	punch(10, 0.4)
end)

