add("Dust", "\u{1F4A8}", C3(200, 200, 205), function(char, pos, gp)
	local parts = bodyParts(char)
	freezeParts(char)
	sfx(SND_BASS, 0.9, 0.4)
	sfx(SND_PING, 0.5, 0.3)
	loopSfx(SFX.wind, 0.9, 2.4, 0.9)
	dim(0.14, 2.6)
	ring(gp, C3(200, 200, 205), 30, 1.2, 0.5)
	local wind = V3(26, 5, R() * 8 - 4)
	for _, p in ipairs(parts) do
		if p.Transparency < 1 then
			local vol = p.Size.X * p.Size.Y * p.Size.Z
			local n = math.clamp(math.floor(vol * 1.4 * state.intensity), 3, 16)
			local col = p.Color
			for _ = 1, n do
				local off = V3((R() - 0.5) * p.Size.X, (R() - 0.5) * p.Size.Y, (R() - 0.5) * p.Size.Z)
				local at = p.CFrame:PointToWorldSpace(off)
				local c = fxPart(Enum.PartType.Block, ONE * (0.25 + R() * 0.35), col, CFrame.new(at) * ANG(R() * 6, R() * 6, R() * 6), 0, Enum.Material.SmoothPlastic, 6)
				local height = math.clamp((at.Y - pos.Y + 3) / 7, 0, 1)
				task.delay((1 - height) * 0.9 + R() * 0.25, function()
					tween(c, 1.4 + R() * 0.8, {
						Position = at + wind * (0.6 + R() * 0.8) + V3(0, R() * 5, (R() - 0.5) * 10),
						Orientation = V3(R(0, 360), R(0, 360), R(0, 360)),
						Size = ONE * 0.05, Transparency = 1, Color = C3(60, 60, 60),
					}, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
					if R() < 0.2 then
						burst(at, { Color = ColorSequence.new(C3(110, 110, 110)), Texture = TEX_SMOKE, LightEmission = 0, Speed = NumberRange.new(2, 8), Lifetime = NumberRange.new(1, 1.6), Acceleration = wind * 0.4, Size = NS(1.4, 3) }, 1)
					end
				end)
			end
		end
	end
	hide(char)
	burst(pos, { Color = ColorSequence.new(C3(230, 230, 230)), Speed = NumberRange.new(3, 10), Lifetime = NumberRange.new(1.5, 2.5), Acceleration = wind * 0.5 }, 30)
	flash(C3(230, 230, 230), 0.5, 0.15)
end)

