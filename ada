		-- ---------- DETEKTOR GUI (cari & tutup GUI script lain yang mengganggu layar) ----------
		do
			local pg = tPages["Detektor"]
			local function say(k, t) if U.say then U.say(k, t) end end
			local function L(id, en)
				if curLang == 2 then return id end
				if curLang ~= 1 then TR.K[en] = true end
				return en
			end
			local CG = game:GetService("CoreGui")
			local ROBLOX_CG = { RobloxGui = true, TopBarApp = true, PlayerList = true, Chat = true, ThemeProvider = true, PurchasePrompt = true, RobloxNetworkPauseNotification = true, RobloxLoadingGui = true, DevConsoleMaster = true, InGameMenu = true, ControlGui = true, TouchGui = true, BubbleChat = true, ExperienceChat = true, FoundationOverlay = true, CoreScripts = true, TeleportEffect = true, ScreenshotHud = true }
			local seen, base, rows = {}, {}, {}
			local function roots()
				local r = { player:FindFirstChildOfClass("PlayerGui") }
				pcall(function() local h = gethui(); if typeof(h) == "Instance" then r[#r + 1] = h end end)
				pcall(function() r[#r + 1] = CG end)
				return r
			end
			local function isMine(g) return g == gui or g.Name == "UIcb20ce" or g:IsDescendantOf(gui) end
			local function scan()
				local out = {}
				for _, root in ipairs(roots()) do
					local okc, ch = pcall(function() return root:GetChildren() end)
					if okc then
						for _, g in ipairs(ch) do
							if (g:IsA("ScreenGui") or g:IsA("BillboardGui") or g:IsA("SurfaceGui")) and not isMine(g) and not (root == CG and ROBLOX_CG[g.Name]) then
								if g:IsA("ScreenGui") then out[#out + 1] = g end
							end
						end
					end
				end
				return out
			end
			-- baseline = GUI yang sudah ada saat script dimuat (milik game); yang muncul setelahnya = "baru"
			for _, g in ipairs(scan()) do base[g] = true; seen[g] = 0 end
			local tick0 = 0
			local function kill(g)
				pcall(function() g.Enabled = false end)
				pcall(function() for _, d in ipairs(g:GetDescendants()) do if d:IsA("GuiObject") then d.Visible = false end end end)
				pcall(function() g:Destroy() end)
				if g.Parent then pcall(function() g.Parent = nil end) end
				return g.Parent == nil
			end
			local listH = scroller(pg, UDim2.fromOffset(0, 106), UDim2.new(1, 0, 1, -106))
			lab(pg, L("Cari GUI script lain & tutup yang mengganggu layar.", "Find other scripts' GUIs and close the ones blocking your screen."), 11, FONT, DIM, UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 30))
			local onlyNew = true
			local function mkBtn(txt, x, w, y)
				local b = mk("TextButton", { Position = UDim2.new(x, 0, 0, y), Size = UDim2.new(w, -4, 0, 30), BackgroundColor3 = SURF2, Text = txt, Font = FONTK, TextSize = 11, TextColor3 = TXT, AutoButtonColor = false }, pg)
				corner(b, 10)
				return b
			end
			local bScan = mkBtn(L("PINDAI", "SCAN"), 0, 0.25, 36)
