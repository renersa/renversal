	local AUTO_PATHS = { "../autoexec/axcb20ce.lua", "autoexec/axcb20ce.lua" }
	-- file script ini di workspace executor (dipakai kalau SELF_URL kosong)
	function U.selfFile()
		if not (isfile and readfile) then return nil end
		if U._sf and pcall(isfile, U._sf) and isfile(U._sf) then return U._sf end
		local f = CONFIG.SELF_FILE
		if f and isfile(f) then U._sf = f return f end
		if listfiles then
			for _, dir in ipairs({ ".", "" }) do
				local ok, fl = pcall(listfiles, dir)
				if ok and type(fl) == "table" then
					local best
					for _, p in ipairs(fl) do
						local nm = (tostring(p):match("([^/\\]+)$") or ""):lower()
						if nm:match("^ultimatekillfx.*%.lua$") or nm:match("^ultimatekillfx.*%.txt$") then
							local path = isfile(tostring(p)) and tostring(p) or (isfile(nm) and nm or nil)
							if path and (not best or path > best) then best = path end
						end
					end
					if best then U._sf = best return best end
				end
			end
		end
	end
	-- kode untuk queue_on_teleport: URL kalau SELF_URL diisi, kalau tidak pakai file lokal. Hanya jalan di game (PlaceId) tujuan yang sama,
	-- dan hanya sekali pada teleport berikutnya (tidak universal seperti folder autoexec).
	function U.selfLoader(pid, auto)
		local body
		if CONFIG.SELF_URL then
			body = 'loadstring(game:HttpGet("' .. CONFIG.SELF_URL .. '"))()'
		else
			local f = U.selfFile()
			if f then body = string.format("loadstring(readfile(%q))()", f) end
		end
		if not body then return nil end
		return "if not game:IsLoaded() then game.Loaded:Wait() end if game.PlaceId == " .. tostring(tonumber(pid) or PLACE) .. " then " .. (auto and "getgenv().aucb20ce54=true " or "") .. body .. " end"
	end
	function U.autoLoader() return U.selfLoader(PLACE, true) end
	function U.autoApply()
		local ld = U.autoLoader()
		-- bersihkan file autoexec lama: script tidak boleh jalan di semua game (risiko anti-cheat)
		if delfile and isfile then
			for _, p in ipairs(AUTO_PATHS) do pcall(function() if isfile(p) then delfile(p) end end) end
		end
		if not ld then return false, "nourl" end
		if state.autoExec and queue_on_teleport then pcall(queue_on_teleport, ld) end
		return true
	end
