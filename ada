local LANGIDX = {}
for i, c in ipairs(LANGS) do LANGIDX[c] = i end
local curLang = 1
local function detectLang()
	local code
	pcall(function() code = game:GetService("LocalizationService").RobloxLocaleId end)
	if not code or code == "" then pcall(function() code = Players.LocalPlayer.LocaleId end) end
	code = tostring(code or "en"):lower():sub(1, 2)
	if code == "in" or code == "ms" then code = "id" end
	if code == "jp" then code = "ja" end
	if code == "cn" or code == "zh" then code = "zh" end
	if code == "kr" then code = "ko" end
	return LANGIDX[code] and code or "en"
end
local function setLang()
	local c = state.lang
	if c == "auto" or not LANGIDX[c] then c = detectLang() end
	curLang = LANGIDX[c]
end
