	-- pusat data center Roblox (perkiraan): { index region, lat, lon }
	local CENTERS = {
		{ 2, 1.35, 103.8 }, { 2, 35.7, 139.7 }, { 2, 19.1, 72.9 },
		{ 3, 39.0, -77.5 }, { 3, 37.3, -121.9 }, { 3, 41.9, -87.6 },
