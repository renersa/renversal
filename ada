-- 20. CHRONO (waktu berhenti)
add("Chrono", "\u{23F3}", C3(120, 255, 190), function(char, pos, gp)
	local mint, gold, white = C3(120, 255, 190), C3(255, 214, 120), C3(235, 255, 245)
	freezeParts(char)
	dim(0.3, 3.4)
	sfx(SND_PING, 1, 0.4)
	sfx(SND_BASS, 1, 0.5)
	flash(mint, 0.4, 0.15)
	local face = CFrame.new(pos) * ANG(0, R() * 6.28, 0)
	local rimP = fxPart(Enum.PartType.Cylinder, V3(0.25, 1, 1), mint, face, 0.1)
	local disc = fxPart(Enum.PartType.Cylinder, V3(0.32, 1, 1), C3(20, 34, 32), face, 0.35)
	tween(rimP, 0.5, { Size = V3(0.25, 15, 15) }, Enum.EasingStyle.Back)
	tween(disc, 0.5, { Size = V3(0.32, 13.6, 13.6) }, Enum.EasingStyle.Back)
	local pieces = {}
	for h = 0, 11 do
		local th = h / 12 * PI * 2
		local big = (h % 3 == 0)
		local tk = fxPart(Enum.PartType.Block, V3(0.4, big and 1.3 or 0.7, 0.4), big and gold or white,
			face * CFrame.new(0.3, math.cos(th) * 6.1, math.sin(th) * 6.1) * ANG(th, 0, 0), 1)
		task.delay(0.2 + h * 0.03, function() tween(tk, 0.2, { Transparency = 0 }) end)
		pieces[#pieces + 1] = tk
	end
	local minute = fxPart(Enum.PartType.Block, V3(0.35, 5.4, 0.35), gold, face, 1)
	local hour = fxPart(Enum.PartType.Block, V3(0.45, 3.4, 0.45), white, face, 1)
	task.delay(0.4, function()
		tween(minute, 0.2, { Transparency = 0 })
		tween(hour, 0.2, { Transparency = 0 })
	end)
	pieces[#pieces + 1] = minute
	pieces[#pieces + 1] = hour
	local cubes = {}
	for i = 1, I(36) do
		local dir = V3(R() - 0.5, R() - 0.5, R() - 0.5).Unit
		local c = fxPart(Enum.PartType.Block, ONE * (0.3 + R() * 0.5), (R() < 0.5) and gold or mint,
			CFrame.new(pos + dir * (2 + R() * 6)) * ANG(R() * 6, R() * 6, R() * 6), 1, Enum.Material.Glass)
		cubes[i] = { p = c, dir = dir }
		tween(c, 0.5, { Transparency = 0.15 })
	end
	local parts, pd = bodyParts(char), {}
	for i, p in ipairs(parts) do
		pd[i] = { pos = p.Position, v = V3((R() - 0.5) * 3, (R() - 0.3) * 3, (R() - 0.5) * 3) }
	end
	local t0, lastTick = os.clock(), 0
	local T = 1.6
	while true do
		local now = os.clock()
		local t = (now - t0) / T
		if t >= 1 then break end
		minute.CFrame = face * CFrame.new(0.45, 0, 0) * ANG(-(t * t) * PI * 16, 0, 0) * CFrame.new(0, 2.7, 0)
		hour.CFrame = face * CFrame.new(0.5, 0, 0) * ANG(-(t * t) * PI * 2.4, 0, 0) * CFrame.new(0, 1.7, 0)
		for i, p in ipairs(parts) do p.Position = pd[i].pos + pd[i].v * (t * 0.6) end
		if now - lastTick > 0.18 then
			lastTick = now
			sfx(SND_SNAP, 0.5, 1.5 + t * 1.5)
		end
		RunService.Heartbeat:Wait()
	end
	boom(1.6, 1)
	defSfx("boom", SFX.golden, 1.1, 1.2)
	flash(white, 0.5, 0.7)
	punch(16, 0.5)
	shake(3, 0.6)
	hide(char)
	tween(rimP, 0.6, { Transparency = 1 })
	tween(disc, 0.6, { Transparency = 1 })
	for _, o in ipairs(pieces) do
		local away = o.Position - pos
		if away.Magnitude > 0.1 then
			tween(o, 0.6, { Position = o.Position + away.Unit * 14, Transparency = 1 })
		else
			tween(o, 0.6, { Transparency = 1 })
		end
	end
	for _, c in ipairs(cubes) do
		tween(c.p, 0.8, { Position = c.p.Position + c.dir * (20 + R() * 20), Transparency = 1, Orientation = V3(R(0, 360), R(0, 360), R(0, 360)) })
	end
	launchParts(char, pos, 26, 0.9, 10)
	ring(gp, mint, 44, 0.7)
	ring(gp, gold, 30, 0.5)
	rays(pos, { mint, gold, white }, 30, 36, 0.6)
	burst(pos, { Color = ColorSequence.new(gold, mint), Speed = NumberRange.new(20, 60) }, 60)
end)

-- 21. SHADOW (ditarik bayangan)
add("Shadow", "\u{1F311}", C3(150, 105, 235), function(char, pos, gp)
	local vio, ink = C3(150, 105, 235), C3(10, 8, 16)
	freezeParts(char)
	dim(0.3, 3.2)
	sfx(SND_BASS, 1.2, 0.3)
	sfx(SND_PING, 0.6, 0.3)
	flash(C3(120, 80, 200), 0.4, 0.12)
	local ctr = V3(pos.X, gp.Y + 0.06, pos.Z)
	local pit = fxPart(Enum.PartType.Cylinder, V3(0.15, 1, 1), ink, CFrame.new(ctr) * ANG(0, 0, PI / 2), 0, Enum.Material.SmoothPlastic)
	local rimP = fxPart(Enum.PartType.Cylinder, V3(0.12, 1, 1), vio, CFrame.new(ctr - V3(0, 0.02, 0)) * ANG(0, 0, PI / 2), 0.2)
	tween(rimP, 0.6, { Size = V3(0.12, 17, 17) })
	tween(pit, 0.6, { Size = V3(0.15, 14.5, 14.5) })
	local parts, pd = bodyParts(char), {}
	for i, p in ipairs(parts) do
		p.Material = Enum.Material.SmoothPlastic
		tween(p, 0.4, { Color = ink })
		pd[i] = { cf = p.CFrame, size = p.Size, tr = p.Transparency }
	end
	local nT = I(10)
	local tends = {}
	for i = 1, nT do
		local segs = {}
		for s = 1, 9 do
			local glow = (s % 2 == 0)
			segs[s] = fxPart(Enum.PartType.Ball, ONE * (1.1 - s * 0.09), glow and vio or ink, CFrame.new(ctr), 0, glow and Enum.Material.Neon or Enum.Material.SmoothPlastic)
		end
		tends[i] = { segs = segs, a = i / nT * 6.28 + R() * 0.3, r = 6 + R() * 3, ph = R() * 6 }
	end
	local eyeL = fxPart(Enum.PartType.Block, V3(0.5, 0.18, 0.12), WHITE, CFrame.new(pos + V3(-0.45, 1.6, 0)), 1)
	local eyeR = fxPart(Enum.PartType.Block, V3(0.5, 0.18, 0.12), WHITE, CFrame.new(pos + V3(0.45, 1.6, 0)), 1)
	local T, t0 = 1.7, os.clock()
	while true do
		local t = (os.clock() - t0) / T
		if t >= 1 then break end
		local grow = math.clamp(t * 2.5, 0, 1)
		for _, td in ipairs(tends) do
			for s, seg in ipairs(td.segs) do
				local rad = td.r * (1 - 0.75 * t) - s * 0.3
				local a = td.a + math.sin(t * 9 + s * 0.6 + td.ph) * 0.06 * s
				seg.Position = V3(pos.X + math.cos(a) * rad, gp.Y + 0.4 + s * 1.3 * grow, pos.Z + math.sin(a) * rad)
			end
		end
		local sink = t * t
		for i, p in ipairs(parts) do
			local d = pd[i]
			p.CFrame = d.cf + V3(0, -sink * 6, 0)
			p.Size = d.size * (1 - 0.7 * sink)
		end
		local on = (t > 0.3 and t < 0.8 and (math.floor(t * 14) % 3 ~= 0))
		eyeL.Transparency = on and 0 or 1
		eyeR.Transparency = on and 0 or 1
		RunService.Heartbeat:Wait()
	end
	for _, td in ipairs(tends) do
		for _, seg in ipairs(td.segs) do seg:Destroy() end
	end
	eyeL:Destroy()
	eyeR:Destroy()
	hide(char)
	boom(1.6, 0.6)
	flash(C3(120, 80, 200), 0.4, 0.3)
	shake(2.5, 0.6)
	ring(gp, vio, 36, 0.7)
	burst(ctr, { Color = ColorSequence.new(C3(22, 16, 34)), Texture = TEX_SMOKE, LightEmission = 0, Speed = NumberRange.new(10, 34), Lifetime = NumberRange.new(1.2, 2.2), Acceleration = V3(0, 8, 0), Size = NS(4, 12) }, 34)
	burst(ctr, { Color = ColorSequence.new(WHITE, vio), Speed = NumberRange.new(20, 60), Acceleration = V3(0, 25, 0) }, 60)
	rays(ctr + UP * 2, { vio, WHITE }, 24, 30, 0.6)
	tween(pit, 0.5, { Size = V3(0.15, 0.5, 0.5), Transparency = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	tween(rimP, 0.5, { Size = V3(0.12, 0.5, 0.5), Transparency = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
end)

-- 22. DRAGON (v7: naga timur - kepala, tanduk, taring, sisik, kaki, cakar) ---
add("Dragon", "\u{1F409}", C3(60, 230, 150), function(char, pos, gp)
	local jade, deep, pale, gold, white = C3(34, 176, 112), C3(12, 70, 56), C3(170, 255, 214), C3(255, 214, 120), C3(242, 255, 248)
	local belly = C3(236, 226, 168)
	freezeParts(char)
	dim(0.16, 3.6)
	sfx(SND_BASS, 1.3, 0.4)
	riser(SND_BASS, 2.2, 0.5, 1.3, 1)
	loopSfx(SFX.wind, 0.9, 2.8, 1.1)
	local a0 = R() * 6.28
	local function path(s)
		if s < 0.6 then
			local k = s / 0.6
			local r = 45 - 40 * k ^ 1.3
			local ang = a0 + k * PI * 4
			return V3(pos.X + math.cos(ang) * r, gp.Y + 25 - 24 * k, pos.Z + math.sin(ang) * r)
		else
			local k = (s - 0.6) / 0.4
			local r = 5 - 4 * k
			local ang = a0 + PI * 4 + k * PI * 3
			return V3(pos.X + math.cos(ang) * r, gp.Y + 1 + 46 * k ^ 1.4, pos.Z + math.sin(ang) * r)
		end
	end
	local function frame(s)
		local p = path(s)
		local d = path(math.min(s + 0.004, 1)) - path(math.max(s - 0.004, 0))
		local t = (d.Magnitude < 0.001) and V3(0, 1, 0) or d.Unit
		local upv = (math.abs(t.Y) > 0.95) and V3(1, 0, 0) or UP
		return CFrame.lookAt(p, p + t, upv)
	end

	local trOf = {}
	local function mk(shape, size, color, mat, tr)
		local p = fxPart(shape, size, color, CFrame.new(path(0)), 1, mat or Enum.Material.Metal, 12)
		trOf[p] = tr or 0
		return p
	end
	local function reveal(list)
		for _, p in ipairs(list) do p.Transparency = trOf[p] end
	end
	local B, CYL = Enum.PartType.Block, Enum.PartType.Cylinder
	local METAL, NEON, PLASTIC = Enum.Material.Metal, Enum.Material.Neon, Enum.Material.SmoothPlastic

	-- badan: silinder bersisik + perut krem + duri punggung + kaki bercakar
	local N = I(40)
	local GAP = 0.0085
	local SEGLEN = 4.9
	local segs = {}
	local legAt = { [math.max(3, math.floor(N * 0.2))] = true, [math.max(5, math.floor(N * 0.55))] = true }
	for i = 1, N do
		local u = i / N
		local d = (u < 0.2) and (2.2 + 1.2 * (u / 0.2)) or (3.4 * (1 - (u - 0.2) / 0.8 * 0.85))
		local col = jade:Lerp(deep, u * 0.8)
		local sg = { d = d, sh = d * 0.6 }
		sg.body = mk(CYL, V3(SEGLEN, d, d), col, METAL, 0)
		sg.body.Reflectance = 0.12
		sg.belly = mk(CYL, V3(SEGLEN * 0.9, d * 0.62, d * 0.62), belly, PLASTIC, 0)
		sg.spike = mk(B, V3(0.16, sg.sh, 0.9), (i % 2 == 0) and gold or pale, NEON, 0.05)
		sg.parts = { sg.body, sg.belly, sg.spike }
		if legAt[i] then
			sg.legs = {}
			for _, side in ipairs({ -1, 1 }) do
				local leg = { side = side, upper = mk(B, V3(0.45, 2.2, 0.45), col, METAL, 0), claws = {} }
				sg.parts[#sg.parts + 1] = leg.upper
				for k = 1, 3 do
					local c = mk(B, V3(0.16, 0.16, 1.0), white, METAL, 0)
					leg.claws[k] = c
					sg.parts[#sg.parts + 1] = c
				end
				sg.legs[#sg.legs + 1] = leg
			end
		end
		if i % 8 == 0 then
			stream(sg.body, { Color = ColorSequence.new(white, jade), Size = NS(1.2, 0), Lifetime = NumberRange.new(0.6, 1), Speed = NumberRange.new(1, 3), Rate = 10 })
		end
		segs[i] = sg
	end
	local fin = mk(B, V3(0.12, 3.2, 5), pale, NEON, 0.35)

	-- kepala
	local headParts, rigid, jawParts, whiskers = {}, {}, {}, {}
	local function hrig(size, color, mat, off, tr)
		local p = mk(B, size, color, mat, tr)
		headParts[#headParts + 1] = p
		rigid[#rigid + 1] = { p = p, off = off }
		return p
	end
	local function hjaw(size, color, mat, off)
		local p = mk(B, size, color, mat, 0)
		headParts[#headParts + 1] = p
		jawParts[#jawParts + 1] = { p = p, off = off }
	end
	local skull = hrig(V3(2.6, 2.0, 3.4), jade, METAL, CFrame.new(0, 0, 0))
	skull.Reflectance = 0.12
	hrig(V3(2.0, 1.2, 2.8), jade, METAL, CFrame.new(0, -0.35, -3.0))
	hrig(V3(2.2, 0.55, 0.8), deep, METAL, CFrame.new(0, 0.1, -4.45))
	hrig(V3(2.9, 0.35, 1.2), deep, METAL, CFrame.new(0, 1.05, -0.9) * ANG(-0.15, 0, 0))
	for _, sd in ipairs({ -1, 1 }) do
		hrig(V3(0.55, 0.4, 0.55), gold, NEON, CFrame.new(sd * 1.2, 0.5, -0.9), 0)
		hrig(V3(0.3, 0.25, 0.3), C3(8, 30, 24), PLASTIC, CFrame.new(sd * 0.55, 0.4, -4.7))
		hrig(V3(0.24, 0.85, 0.24), white, METAL, CFrame.new(sd * 0.8, -1.05, -4.3))
		hrig(V3(0.16, 0.5, 0.16), white, METAL, CFrame.new(sd * 0.45, -0.95, -4.55))
		local cur = CFrame.new(sd * 0.95, 1.0, 0.8) * ANG(0.9, sd * 0.25, 0)
		local lens, ths = { 1.6, 1.3, 1.0 }, { 0.5, 0.4, 0.3 }
		for k = 1, 3 do
			hrig(V3(ths[k], ths[k], lens[k]), pale, METAL, cur * CFrame.new(0, 0, lens[k] / 2))
			cur = cur * CFrame.new(0, 0, lens[k]) * ANG(0.3, sd * 0.1, 0)
		end
		for j = 1, 2 do
			local w = mk(B, V3(0.08, 0.08, 6.5), gold, NEON, 0.1)
			headParts[#headParts + 1] = w
			whiskers[#whiskers + 1] = { p = w, side = sd, j = j }
		end
	end
	for k = 1, 5 do
		hrig(V3(0.2, 1.2, 0.9), (k % 2 == 0) and gold or pale, NEON, CFrame.new(0, 1.1 + 0.05 * k, 1.4 + 0.95 * k) * ANG(0.6, 0, 0), 0.05)
	end
	hjaw(V3(1.8, 0.5, 3.3), C3(70, 200, 140), METAL, CFrame.new(0, -0.15, -1.7))
	for _, sd in ipairs({ -1, 1 }) do
		hjaw(V3(0.16, 0.45, 0.16), white, METAL, CFrame.new(sd * 0.55, 0.35, -2.8))
		hjaw(V3(0.16, 0.35, 0.16), white, METAL, CFrame.new(sd * 0.3, 0.3, -3.1))
	end
	local mouth = mk(Enum.PartType.Ball, ONE * 0.5, WHITE, NEON, 1)
	local pl = Instance.new("PointLight")
	pl.Color, pl.Brightness, pl.Range = pale, 6, 40
	pl.Parent = skull
	stream(skull, { Color = ColorSequence.new(white, jade), Size = NS(1.6, 0), Lifetime = NumberRange.new(0.4, 0.9), Speed = NumberRange.new(2, 8), Rate = 60 })
	local br = stream(mouth, { Color = ColorSequence.new(white, pale), Texture = TEX_FIRE, Size = NS(2.6, 0), Lifetime = NumberRange.new(0.4, 0.8), Speed = NumberRange.new(20, 45), Spread = Vector2.new(12, 12), Rate = 0 })
	br.EmissionDirection = Enum.NormalId.Front

	local function placeHead(hcf, open, tt)
		for _, r in ipairs(rigid) do r.p.CFrame = hcf * r.off end
		local jb = hcf * CFrame.new(0, -0.85, -0.9) * ANG(-open, 0, 0)
		for _, r in ipairs(jawParts) do r.p.CFrame = jb * r.off end
		for j, w in ipairs(whiskers) do
			w.p.CFrame = hcf * CFrame.new(w.side * 0.9, -0.3 - 0.25 * w.j, -3.8)
				* ANG(0.1 * math.sin(tt * 6 + j), w.side * (-0.35 + 0.25 * math.sin(tt * 7 + j)), 0) * CFrame.new(0, 0, 3.3)
		end
		mouth.CFrame = hcf * CFrame.new(0, -0.8, -5)
	end
	local function placeSeg(sg, cf)
		local d = sg.d
		sg.body.CFrame = cf * ANG(0, PI / 2, 0)
		sg.belly.CFrame = cf * CFrame.new(0, -d * 0.3, 0) * ANG(0, PI / 2, 0)
		sg.spike.CFrame = cf * CFrame.new(0, d * 0.5 + sg.sh * 0.4, 0.15) * ANG(0.45, 0, 0)
		if sg.legs then
			for _, leg in ipairs(sg.legs) do
				local base = cf * CFrame.new(leg.side * d * 0.5, -d * 0.35, 0) * ANG(0, 0, leg.side * 0.8)
				leg.upper.CFrame = base * CFrame.new(0, -1.1, 0)
				local foot = base * CFrame.new(0, -2.2, 0)
				for k, c in ipairs(leg.claws) do
					c.CFrame = foot * ANG(0.9, (k - 2) * 0.45, 0) * CFrame.new(0, 0, -0.5)
				end
			end
		end
	end

	reveal(headParts)
	local total = 1 + (N + 2) * GAP
	local T, t0, hit = 2.7, os.clock(), false
	local shown = {}
	while true do
		local now = os.clock()
		local t = (now - t0) / T
		if t >= 1 then break end
		local sh = t * total
		local open = math.clamp(1 - math.abs(sh - 0.6) / 0.07, 0, 1) * 0.75
		placeHead(frame(math.min(sh, 1)), open, now - t0)
		br.Rate = ((sh > 0.58 and sh < 0.68) and 320 or 0) * state.intensity
		for i = 1, N do
			local s = sh - i * GAP
			if s >= 0 then
				local sg = segs[i]
				if not shown[i] then
					shown[i] = true
					reveal(sg.parts)
				end
				placeSeg(sg, frame(math.min(s, 1)))
			end
		end
		local sf = sh - (N + 1) * GAP
		if sf >= 0 then
			if not shown.fin then
				shown.fin = true
				fin.Transparency = trOf[fin]
			end
			fin.CFrame = frame(math.min(sf, 1)) * CFrame.new(0, 0, 1.8)
		end
		if sh >= 0.62 and not hit then
			hit = true
			boom(1.7, 0.9)
			sfx(SND_PING, 1, 1.5)
			flash(pale, 0.6, 0.7)
			punch(22, 0.5)
			shake(4, 0.8)
			burst(pos, { Color = ColorSequence.new(white, jade), Speed = NumberRange.new(30, 80) }, 80)
			launchParts(char, pos, 30, 0.9, 10)
			ring(gp, jade, 44, 0.7)
			ring(gp, pale, 28, 0.5)
			rays(pos, { jade, pale, white }, 30, 40, 0.7)
		end
		RunService.Heartbeat:Wait()
	end
	br.Enabled = false
	for p in pairs(trOf) do tween(p, 0.4, { Transparency = 1 }) end
	burst(path(1), { Color = ColorSequence.new(white, jade), Speed = NumberRange.new(20, 60) }, 60)
end)

