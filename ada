	}
	local function distKm(a1, o1, a2, o2)
		local r = math.pi / 180
		local dla, dlo = (a2 - a1) * r, (o2 - o1) * r
		local h = math.sin(dla / 2) ^ 2 + math.cos(a1 * r) * math.cos(a2 * r) * math.sin(dlo / 2) ^ 2
		return 12742 * math.asin(math.min(1, math.sqrt(h)))
	end
	local me
	local function myGeo()
		if me then return me end
		local b = http("http://ip-api.com/json/?fields=status,lat,lon,countryCode")
		local d = b and jdecode(b)
		if d and d.status == "success" then me = d end
		return me
	end
	local function rttFromKm(km) return 20 + 0.0155 * km end
	local function expectedRtt(idx)
		local g = myGeo()
		if not g then return nil end
		local best
		for _, c in ipairs(CENTERS) do
			if idx == nil or c[1] == idx then
				local r = rttFromKm(distKm(g.lat, g.lon, c[2], c[3]))
				if not best or r < best then best = r end
			end
		end
		return best
	end
	local function regionOf(lat, lon)
		local best, bi = 1e9, 2
		for _, c in ipairs(CENTERS) do
			local d = distKm(lat, lon, c[2], c[3])
			if d < best then best, bi = d, c[1] end
		end
		return bi
	end
	-- cocokkan ping terukur (sungguhan) dengan tujuan
	local function pingMatches(rtt, reg, low)
		if reg > 1 then
			local e = expectedRtt(reg)
			if not e then return true end
			return math.abs(rtt - e) <= math.max(45, e * 0.32), e
		elseif low then
			local e = expectedRtt(nil)
			if not e then return rtt <= 120 end
			return rtt <= math.max(70, e * 1.35 + 15), e
		end
		return true
	end
	local function fetchServers(maxP, pages, ss)
		local good, fallback, ids = {}, {}, {}
		local cursor
		local now = os.time()
		local recent = (ss and type(ss.recent) == "table") and ss.recent or {}
		-- tanpa batas pemain: ambil server paling ramai (Desc) = server aktif & stabil; dengan batas: server terkecil (Asc)
		local order = maxP and "Asc" or "Desc"
		for page = 1, pages do
			local url = "https://games.roblox.com/v1/games/" .. PLACE .. "/servers/Public?sortOrder=" .. order .. "&excludeFullGames=true&limit=100" .. (cursor and ("&cursor=" .. cursor) or "")
			local d, errMsg
			for try = 1, 4 do
				local body = http(url)
				d = body and jdecode(body)
				if d and type(d.data) == "table" then break end
				errMsg = d and d.errors and d.errors[1] and d.errors[1].message
				-- rate limit (429) / respons kosong: tunggu lalu coba lagi
				if (not d) or (errMsg and tostring(errMsg):lower():find("too many")) then task.wait(1.5 * try) else break end
			end
			if not d or type(d.data) ~= "table" then
				if page == 1 then return nil, errMsg or "no response" end
				break
			end
			local stop = false
			for _, s in ipairs(d.data) do
				if type(s.id) == "string" and s.id ~= game.JobId and not ids[s.id] and type(s.playing) == "number" and type(s.maxPlayers) == "number" and s.playing < s.maxPlayers then
					if maxP and s.playing > maxP then stop = true break end
					ids[s.id] = true
					local free = s.maxPlayers - s.playing
					local fresh = not (recent[s.id] and now - recent[s.id] < 900)
					-- server kosong (hampir mati) & server yang sisa slotnya tipis (keburu penuh) dilewati
					if s.playing >= 1 and free >= math.max(2, math.ceil(s.maxPlayers * 0.1)) and fresh then
						good[#good + 1] = s
					else
						fallback[#fallback + 1] = s
					end
				end
			end
			if stop or not d.nextPageCursor or #good >= 250 then break end
			cursor = d.nextPageCursor
			task.wait(0.35)
		end
		if #good > 0 then return good end
		return fallback
	end
