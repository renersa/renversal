						local url = (q == "") and "https://rscripts.net/api/v2/scripts?page=1&orderBy=date&sort=desc" or ("https://rscripts.net/api/v2/scripts?q=" .. HttpService:UrlEncode(q) .. "&page=1&orderBy=views&sort=desc")
