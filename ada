	-- ---------- builder UI di dunia (SurfaceGui / BillboardGui) ----------
	local function mkFrame(parent, size, pos, anchor)
		local f = Instance.new("Frame")
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.AnchorPoint = anchor or Vector2.new(0.5, 0.5)
		f.Position = pos or UD2(0.5, 0, 0.5, 0)
		f.Size = size
		f.Parent = parent
		return f
	end
	local function circleF(parent, scale, thick, col, fillT)
		local f = mkFrame(parent, UD2(scale, 0, scale, 0))
		if fillT then
			f.BackgroundTransparency = fillT
			f.BackgroundColor3 = col
		end
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = f
		local s
		if thick and thick > 0 then
			s = Instance.new("UIStroke")
			s.Thickness = thick
			s.Color = col
			s.Parent = f
		end
		return f, s
	end
	local function squareF(parent, scale, thick, col, rot)
		local f = mkFrame(parent, UD2(scale, 0, scale, 0))
		f.Rotation = rot or 0
		local s = Instance.new("UIStroke")
		s.Thickness = thick
		s.Color = col
		s.Parent = f
		return f, s
	end

	local function buildSigil(part, style, c1, c2, anim, R)
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Top
		sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		sg.CanvasSize = Vector2.new(600, 600)
		sg.LightInfluence = 0
		pcall(function() sg.Brightness = 2.5 end)
		sg.AlwaysOnTop = false
		sg.Parent = part
		local root = mkFrame(sg, UD2(1, 0, 1, 0))
		if style == "plain" then
			local f, _ = circleF(root, 0.96, 0, c1, 0.82)
			R(f, "BackgroundColor3")
			local o, os2 = circleF(root, 0.96, 10, c1)
			R(os2, "Color")
			local i, is2 = circleF(root, 0.7, 3, c2)
			R(is2, "Color")
			local g = circleF(root, 0.46, 0, c2, 0.85)
			R(g, "BackgroundColor3")
			anim[#anim + 1] = function(t) i.Rotation = t * 20 end
		elseif style == "halo" then
			local f = circleF(root, 0.94, 0, c1, 0.8)
			R(f, "BackgroundColor3")
			local _, s1 = circleF(root, 0.94, 14, c1)
			R(s1, "Color")
			local _, s2 = circleF(root, 0.8, 4, c2)
			R(s2, "Color")
		else -- rune
			local f = circleF(root, 0.98, 0, c1, 0.88)
			R(f, "BackgroundColor3")
			local _, so = circleF(root, 0.98, 10, c1)
			R(so, "Color")
			local ticks = mkFrame(root, UD2(1, 0, 1, 0))
			for i = 0, 35 do
				local a = i / 36 * math.pi * 2
				local tk = mkFrame(ticks, UD2(0, (i % 3 == 0) and 8 or 5, 0, (i % 3 == 0) and 30 or 18), UD2(0.5 + cos(a) * 0.44, 0, 0.5 + sin(a) * 0.44, 0))
				tk.BackgroundTransparency = 0
				tk.BackgroundColor3 = c2
				tk.Rotation = math.deg(a) + 90
				R(tk, "BackgroundColor3")
			end
			local _, s3 = circleF(root, 0.86, 3, c2)
			R(s3, "Color")
			local _, s4 = circleF(root, 0.7, 4, c1)
			R(s4, "Color")
			local sqA = mkFrame(root, UD2(1, 0, 1, 0))
			local _, q1 = squareF(sqA, 0.5, 4, c2, 0)
			local _, q2 = squareF(sqA, 0.5, 4, c2, 45)
			R(q1, "Color")
			R(q2, "Color")
			local sqB = mkFrame(root, UD2(1, 0, 1, 0))
			local _, q3 = squareF(sqB, 0.32, 4, c1, 22.5)
			local _, q4 = squareF(sqB, 0.32, 4, c1, 67.5)
			R(q3, "Color")
			R(q4, "Color")
			local cd = circleF(root, 0.09, 0, c2, 0.1)
			R(cd, "BackgroundColor3")
			anim[#anim + 1] = function(t)
				ticks.Rotation = t * 22
				sqA.Rotation = -t * 16
				sqB.Rotation = t * 34
			end
		end
	end

	local function buildDisc(part, d, c1, c2, sc, anim, R)
		local bb = Instance.new("BillboardGui")
		bb.Adornee = part
		bb.Size = UD2(d.size * sc, 0, d.size * sc, 0)
		bb.AlwaysOnTop = false
		bb.LightInfluence = 0
		pcall(function() bb.Brightness = 2 end)
		bb.Parent = part
		local root = mkFrame(bb, UD2(1, 0, 1, 0))
		local kind = d.kind
		local g1 = circleF(root, 0.78, 0, c1, 0.9)
		local g2 = circleF(root, 0.58, 0, c1, 0.78)
		R(g1, "BackgroundColor3")
		R(g2, "BackgroundColor3")
		local rc
		if (d.rays or 0) > 0 then
			rc = mkFrame(root, UD2(1, 0, 1, 0))
			local cnt = floor(d.rays / 2)
			for i = 1, cnt do
				local long = (i % 2 == 1)
				local ray = mkFrame(rc, UD2(long and 0.035 or 0.022, 0, long and 1 or 0.72, 0))
				ray.BackgroundTransparency = 0
				ray.BackgroundColor3 = c2
				ray.Rotation = (i - 1) * (180 / cnt)
				local gr = Instance.new("UIGradient")
				gr.Rotation = 90
				gr.Transparency = NumberSequence.new({ kp(0, 1), kp(0.5, 0.3), kp(1, 1) })
				gr.Parent = ray
				R(ray, "BackgroundColor3")
			end
		end
		local pulse
		if kind == "eclipse" then
			local ring = circleF(root, 0.5, 4, c1)
			ring.Parent = root
			local core = circleF(root, 0.42, 6, c2, 0)
			core.BackgroundColor3 = Color3.new(0, 0, 0)
			local st = core:FindFirstChildOfClass("UIStroke")
			if st then R(st, "Color") end
			pulse = g2
		elseif kind == "moon" then
			local core = circleF(root, 0.46, 0, c2, 0)
			local gr = Instance.new("UIGradient")
			gr.Color = ColorSequence.new(c2, c1)
			gr.Rotation = 40
			gr.Parent = core
			circleF(core, 0.22, 0, c1, 0.6).Position = UD2(0.32, 0, 0.36, 0)
			circleF(core, 0.14, 0, c1, 0.65).Position = UD2(0.64, 0, 0.62, 0)
			pulse = g1
		elseif kind == "hole" then
			rc = rc or mkFrame(root, UD2(1, 0, 1, 0))
			local e1 = mkFrame(rc, UD2(0.98, 0, 0.3, 0))
			e1.Rotation = -16
			local ec1 = Instance.new("UICorner")
			ec1.CornerRadius = UDim.new(0.5, 0)
			ec1.Parent = e1
			local es1 = Instance.new("UIStroke")
			es1.Thickness = 6
			es1.Color = c1
			es1.Parent = e1
			R(es1, "Color")
			local e2 = mkFrame(rc, UD2(0.82, 0, 0.22, 0))
			e2.Rotation = 14
			local ec2 = Instance.new("UICorner")
			ec2.CornerRadius = UDim.new(0.5, 0)
			ec2.Parent = e2
			local es2 = Instance.new("UIStroke")
			es2.Thickness = 4
			es2.Color = c2
			es2.Parent = e2
			R(es2, "Color")
			local core = circleF(root, 0.34, 5, c2, 0)
			core.BackgroundColor3 = Color3.new(0, 0, 0)
			local st = core:FindFirstChildOfClass("UIStroke")
			if st then R(st, "Color") end
			pulse = g1
		else -- sun
			local core = circleF(root, 0.36, 5, c1, 0)
			core.BackgroundColor3 = c2
			R(core, "BackgroundColor3")
			local st = core:FindFirstChildOfClass("UIStroke")
			if st then R(st, "Color") end
			pulse = g2
		end
		anim[#anim + 1] = function(t)
			if rc then rc.Rotation = t * (d.spin or 10) end
			if pulse then pulse.BackgroundTransparency = 0.78 + 0.08 * sin(t * 2.2) end
		end
		return bb
	end

	-- ---------- engine aura ----------
	function U.ccatStopAura()
		if ccat._auraConn then
			pcall(function() ccat._auraConn:Disconnect() end)
			ccat._auraConn = nil
		end
		ccat.auraStyle = nil
		local ch = player.Character
		if ch then
			local f = ch:FindFirstChild(".ccat_aura")
			if f then pcall(function() f:Destroy() end) end
		end
		for _, o in ipairs(ccat._auraJunk or {}) do pcall(function() o:Destroy() end) end
		ccat._auraJunk = {}
		if ccat.onChange then pcall(ccat.onChange) end
	end

	function U.ccatSetAura(styleKey)
		U.ccatStopAura()
		if not styleKey then return end
		local spec = AURA_BY[styleKey]
		if not spec then return end
		local ch = player.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum then return end
		ccat.auraStyle = styleKey
		local fold = Instance.new("Folder")
		fold.Name = ".ccat_aura"
		fold:SetAttribute("_cb20ce54", true)
		fold.Parent = ch
		local junk = ccat._auraJunk
		local sc = clamp(hrp.Size.Y / 2, 0.6, 3)
		local feetY = (hum.RigType == Enum.HumanoidRigType.R6) and -3 or -(hrp.Size.Y / 2 + hum.HipHeight)
		local head = ch:FindFirstChild("Head")
		local headY = head and (hrp.CFrame:PointToObjectSpace(head.Position).Y + head.Size.Y / 2) or 2.5
		local c1, c2 = spec.c1, spec.c2
		local anim, recs = {}, {}
		local rar = RAR[spec.rar]

		local function R(obj, prop)
			if spec.hue and obj then recs[#recs + 1] = { o = obj, p = prop, off = (#recs * 0.083) % 1 } end
		end
		local function RS(obj, prop)
			if spec.hue and obj then recs[#recs + 1] = { o = obj, p = prop, off = (#recs * 0.083) % 1, seq = true } end
		end
		local function mkPart(size, shape)
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = false
			p.CastShadow = false
			p.Massless = true
			p.Transparency = 1
			p.Size = size
			p.Material = Enum.Material.SmoothPlastic
			if shape then p.Shape = shape end
			p.Parent = fold
			return p
		end
		local function try(f)
			local ok, err = pcall(f)
			if not ok then warn("[aura " .. tostring(styleKey) .. "] " .. tostring(err)) end
		end

		-- cahaya
		try(function()
			if not spec.light then return end
			local lp = mkPart(V3(0.2, 0.2, 0.2))
			local l = Instance.new("PointLight")
			l.Color = spec.light[1]
			l.Brightness = spec.light[2]
			l.Range = spec.light[3] * sc
			l.Shadows = false
			l.Parent = lp
			R(l, "Color")
			anim[#anim + 1] = function(t, dt, pos)
				lp.Position = pos
				l.Brightness = spec.light[2] * (0.85 + 0.15 * sin(t * 3))
			end
		end)

		-- volume emitter
		local vols = {}
		local VOL = {
			body = { V3(3, 5, 3), function(pos) return pos end },
			ground = { V3(7, 0.2, 7), function(pos, gy) return V3(pos.X, gy + 0.1, pos.Z) end },
			head = { V3(2, 0.5, 2), function(pos) return pos + V3(0, headY + 0.5, 0) end },
			wide = { V3(10, 8, 10), function(pos) return pos + V3(0, 1, 0) end },
			sky = { V3(9, 1, 9), function(pos) return pos + V3(0, headY + 4, 0) end },
		}
		local function volPart(name)
			if vols[name] then return vols[name].p end
			local def = VOL[name] or VOL.body
			local p = mkPart(def[1] * sc)
			vols[name] = { p = p, f = def[2] }
			return p
		end
		try(function()
			for _, e in ipairs(spec.em or {}) do
				local p = volPart(e.vol or "body")
				local pe = Instance.new("ParticleEmitter")
