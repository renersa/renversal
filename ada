				elseif w == 2 then score[3] += 1 statusL.Text = "Kamu kalah!" U.sfx("bad", 0.75)
				else score[2] += 1 statusL.Text = "Lanjut..." U.sfx("tick", 0.45) end
				for k = 1, 3 do numL[k].Text = tostring(score[k]) end
			end
			local function newGame()
				for i = 1, 9 do board[i] = 0 end
				order = { {}, {} }
				over, busy = false, false
				paint()
				if aiFirst then
					busy = true
					statusL.Text = "AI sedang berpikir..."
					task.delay(0.35, function()
						if not alive() then return end
						local m = aiMove()
						if m then place(board, order, 2, m) end
						busy = false
						paint()
						local w, line = winnerOf(board)
						if w ~= 0 then finish(w, line) else statusL.Text = "Giliranmu (X) · max 3" end
					end)
				else
					statusL.Text = "Giliranmu (X) · max 3 bidak"
				end
			end
			for i = 1, 9 do
				local r, c = math.floor((i - 1) / 3), (i - 1) % 3
				local b = mk("TextButton", { Position = UDim2.fromOffset(c * 92, r * 92), Size = UDim2.fromOffset(84, 84), BackgroundColor3 = SURF, Text = "", Font = FONTK, TextSize = 44, TextColor3 = TXT, AutoButtonColor = false }, pg)
				corner(b, 14)
				cells[i] = b
				b.MouseButton1Click:Connect(function()
					if over or busy or board[i] ~= 0 then return end
					click()
					U.sfx("flip", 0.4)
					place(board, order, 1, i)
					paint()
					local w, line = winnerOf(board)
					if w ~= 0 then finish(w, line) paint() if line then for _, k in ipairs(line) do cells[k].BackgroundColor3 = byName[state.selected].color cells[k].TextColor3 = INK end end return end
					busy = true
					statusL.Text = "AI sedang berpikir..."
					task.delay(0.3, function()
						if not alive() or over then return end
						local m = aiMove()
						if m then place(board, order, 2, m) end
						busy = false
						paint()
