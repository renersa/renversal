							return h.a + (h.b - h.a) * (0.5 + 0.5 * sin(t * 0.6 + o * 6.28))
						end
						if rc.o.Parent then
							if rc.seq then
								rc.o[rc.p] = ColorSequence.new(Color3.fromHSV(hv(rc.off), 0.75, 1), Color3.fromHSV(hv(rc.off + 0.15), 0.5, 1))
							else
								rc.o[rc.p] = Color3.fromHSV(hv(rc.off), 0.75, 1)
							end
						end
					end
				end
			end)
			if not ok then
				pcall(function() conn:Disconnect() end)
				warn("[aura] " .. tostring(err))
				if U.note then U.note("Aura error: " .. tostring(err):sub(1, 60)) end
			end
		end)
		ccat._auraConn = conn
