		tween(p, 1.4, { Color = cols[1], Transparency = 1, Position = p.Position + V3(0, 6, 0) }, Enum.EasingStyle.Sine)
	end
	-- tirai aurora: pita-pita neon bergelombang yang naik ke langit
	local ribbons = {}
	for i = 1, 9 do
		local a = i / 9 * PI * 2
		local segs = {}
		for k = 1, 14 do
			segs[k] = fxPart(Enum.PartType.Block, V3(0.6, 2.4, 0.18), cols[(i + k) % #cols + 1], CFrame.new(pos), 0.2, Enum.Material.Neon, 6)
