		yes = true
	elseif state.mode == 1 then
		-- "My kills": harus aku yang memukul dia barusan, dan tidak ada pemain lain yang tercatat sebagai pembunuh
		local other = credit ~= nil and credit ~= player
		yes = (not other) and (hitByMe[hum] ~= nil) and (os.clock() - hitByMe[hum] < 3.5)
	elseif state.mode == 2 then
		yes = dist <= state.range
	else
		yes = true
	end
	if yes then play(char, pos) end
end

local watched = {}
local function watch(hum)
	if watched[hum] then return end
	local char = hum.Parent
	if not char or not char:IsA("Model") then return end
	watched[hum] = true
	local done = hum.Health <= 0
	bind(hum.Died, function()
		if done then return end
		done = true
		trigger(char, hum)
	end)
	local lastH = hum.Health
	bind(hum.HealthChanged, function(h)
		if h < lastH and h >= 0 and char ~= player.Character and os.clock() - lastAttack < 1.2 then
			local tg = hum:FindFirstChild("creator")
			local cr = tg and tg.Value
			if (cr == nil or cr == player) and aimingAt(char) then hitByMe[hum] = os.clock() end
		end
		lastH = h
		if h > 0 then
			done = false
		elseif not done then
			done = true
			trigger(char, hum)
		end
	end)
end

for _, d in ipairs(workspace:GetDescendants()) do
	if d:IsA("Humanoid") then watch(d) end
end
bind(workspace.DescendantAdded, function(d)
	if d:IsA("Humanoid") then task.defer(watch, d) end
end)

