	function U.radar()
		local out = {}
		local me = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not me then return out end
		for _, pl in ipairs(Players:GetPlayers()) do
			local r = pl ~= player and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
			if r then
				local d = r.Position - me.Position
				local look = me.CFrame.LookVector
				local ang = math.deg(math.atan2(d.X * look.Z - d.Z * look.X, d.X * look.X + d.Z * look.Z))
				out[#out + 1] = { pl = pl, dist = d.Magnitude, ang = ang }
			end
		end
		table.sort(out, function(a, b) return a.dist < b.dist end)
		return out
	end
