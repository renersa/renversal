	local LP = { "Brightness", "ClockTime", "Ambient", "OutdoorAmbient", "ColorShift_Top", "ColorShift_Bottom", "FogEnd", "FogStart", "FogColor", "GlobalShadows", "ExposureCompensation", "EnvironmentDiffuseScale", "EnvironmentSpecularScale", "ShadowSoftness" }
	local snap, qp, qa, loopOn = nil, {}, {}, false
	local function needLight() return not killed and (state.fullbright or state.nofog or state.shader or state.perf > 0) end
	local function quietPost(on)
		if on then
			for _, e in ipairs(Lighting:GetChildren()) do
				if e:IsA("PostEffect") and not isMine(e) and e.Enabled and not qp[e] then
					qp[e] = true
					e.Enabled = false
				end
			end
		else
			for e in pairs(qp) do pcall(function() e.Enabled = true end) end
			table.clear(qp)
		end
	end
	local function quietAtmo(on)
		if on then
			for _, e in ipairs(Lighting:GetChildren()) do
				if e:IsA("Atmosphere") then
					if not isMine(e) and not qa[e] then qa[e] = { e.Density, e.Haze, e.Offset, e.Glare } end
					pcall(function() e.Density = 0 e.Haze = 0 e.Glare = 0 end)
				end
			end
		else
			for e, v in pairs(qa) do pcall(function() e.Density, e.Haze, e.Offset, e.Glare = v[1], v[2], v[3], v[4] end) end
			table.clear(qa)
		end
	end
	local function reapply()
		if not needLight() then
			if snap then
				for p, v in pairs(snap) do lset(p, v) end
				snap = nil
			end
			quietPost(false)
			quietAtmo(false)
			return
		end
		if not snap then
			snap = {}
			for _, p in ipairs(LP) do pcall(function() snap[p] = Lighting[p] end) end
		end
		quietPost(state.shader or state.perf > 0)
		if state.shader then
			for k, v in pairs((SH[state.shMode] or SH[1]).l) do lset(k, v) end
		end
		if state.perf > 0 then
			lset("GlobalShadows", false)
			if state.perf >= 2 then lset("ShadowSoftness", 0) lset("EnvironmentSpecularScale", 0) end
		end
		if state.fullbright then
			lset("Brightness", 2.2) lset("ClockTime", 14) lset("GlobalShadows", false)
			lset("Ambient", C3(178, 178, 178)) lset("OutdoorAmbient", C3(178, 178, 178)) lset("ExposureCompensation", 0.2)
			if not state.nofog then lset("FogEnd", 1e5) end
		end
		if state.nofog then
			lset("FogEnd", 9e8) lset("FogStart", 9e8)
			quietAtmo(true)
		elseif state.perf < 2 then
			quietAtmo(false)
		end
		if state.perf >= 2 and not state.nofog then quietAtmo(true) end
	end
	local function lightLoop()
		if loopOn then return end
