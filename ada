	-- cara manual (client-side): ganti aksesoris / baju / wajah / warna kulit satu per satu
	local function avatarManual(uid, hum)
		local ch = hum.Parent
		local assets, colors
		local ok, info = pcall(function() return Players:GetCharacterAppearanceInfoAsync(uid) end)
		if ok and type(info) == "table" and type(info.assets) == "table" then
			assets, colors = info.assets, info.bodyColors
		else
			local d = apiJson("GET", "https://avatar.roblox.com/v1/users/" .. uid .. "/avatar")
			if type(d) == "table" and type(d.assets) == "table" then
				assets = d.assets
				colors = d.bodyColors and {
					headColorId = d.bodyColors.headColorId, torsoColorId = d.bodyColors.torsoColorId,
					leftArmColorId = d.bodyColors.leftArmColorId, rightArmColorId = d.bodyColors.rightArmColorId,
					leftLegColorId = d.bodyColors.leftLegColorId, rightLegColorId = d.bodyColors.rightLegColorId,
				}
			end
		end
		if not assets then return false, "data avatar tidak terbaca (API diblokir / profil privat)" end
		-- bersihkan yang lama
		for _, o in ipairs(ch:GetChildren()) do
			if o:IsA("Accessory") or o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic") then o:Destroy() end
		end
		-- muat semua aset bersamaan
		local loaded, pend = {}, 0
		for i, a in ipairs(assets) do
			local id = a.id
			pend = pend + 1
			task.spawn(function()
				local ok3, objs = pcall(loadObjs, id)
				loaded[i] = ok3 and objs or false
				pend = pend - 1
			end)
		end
		local t0 = os.clock()
		while pend > 0 and os.clock() - t0 < 12 do task.wait(0.1) end
		local n = 0
		for i = 1, #assets do
			local objs = loaded[i]
			if objs then
				for _, o in ipairs(objs) do
					if o:IsA("Accessory") then
						if pcall(function() hum:AddAccessory(o) end) then n = n + 1 end
					elseif o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic") then
						o.Parent = ch
						n = n + 1
					elseif o:IsA("Decal") then
						local head = ch:FindFirstChild("Head")
						local face = head and head:FindFirstChildOfClass("Decal")
						if face then face.Texture = o.Texture n = n + 1 end
					end
				end
			end
		end
		if type(colors) == "table" then
			pcall(function()
				local bc = ch:FindFirstChildOfClass("BodyColors") or Instance.new("BodyColors", ch)
				local function bk(id, def) return BrickColor.new(tonumber(id) or def) end
				bc.HeadColor, bc.TorsoColor = bk(colors.headColorId, 1), bk(colors.torsoColorId, 1)
				bc.LeftArmColor, bc.RightArmColor = bk(colors.leftArmColorId, 1), bk(colors.rightArmColorId, 1)
				bc.LeftLegColor, bc.RightLegColor = bk(colors.leftLegColorId, 1), bk(colors.rightLegColorId, 1)
				-- R15: warna ikut bagian tubuh
				for _, p in ipairs(ch:GetChildren()) do
					if p:IsA("BasePart") then
						local nm = p.Name
						if nm:find("Head") then p.BrickColor = bc.HeadColor
						elseif nm:find("Torso") then p.BrickColor = bc.TorsoColor
						elseif nm:find("LeftHand") or nm:find("LeftLowerArm") or nm:find("LeftUpperArm") or nm == "Left Arm" then p.BrickColor = bc.LeftArmColor
						elseif nm:find("RightHand") or nm:find("RightLowerArm") or nm:find("RightUpperArm") or nm == "Right Arm" then p.BrickColor = bc.RightArmColor
						elseif nm:find("LeftFoot") or nm:find("LeftLowerLeg") or nm:find("LeftUpperLeg") or nm == "Left Leg" then p.BrickColor = bc.LeftLegColor
						elseif nm:find("RightFoot") or nm:find("RightLowerLeg") or nm:find("RightUpperLeg") or nm == "Right Leg" then p.BrickColor = bc.RightLegColor
						end
					end
				end
			end)
		end
		return n > 0, n > 0 and nil or "tidak ada item yang bisa dipasang (GetObjects/LoadAsset diblokir executor)"
	end
	function U.avatarApply(uid)
		local hum = myHum()
