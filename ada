			corner(pv, 8)
			drawGlyph(pv, kind, K.color and state[K.color] or "FFFFFF", 36)
			lab(b, name, 10, FONTB, sel and TXT or DIM, UDim2.fromOffset(2, 62), UDim2.new(1, -4, 0, 18), Enum.TextXAlignment.Center).TextTruncate = Enum.TextTruncate.AtEnd
			b.MouseButton1Click:Connect(function() click() choose(w, kind, deletable) end)
			if deletable then
				local d = mk("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -2, 0, 2), Size = UDim2.fromOffset(20, 20), BackgroundColor3 = C3(200, 70, 70), Text = "\u{D7}", Font = FONTK, TextSize = 14, TextColor3 = WHITE, AutoButtonColor = false, ZIndex = 5 }, b)
				corner(d, 10)
				d.MouseButton1Click:Connect(function()
					click()
					local list = state[K.saved]
					for i = #list, 1, -1 do if list[i] == kind then table.remove(list, i) end end
