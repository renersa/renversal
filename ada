		p.Material = Enum.Material.Neon
		tween(p, 1, { Color = pink, Transparency = 1, Position = p.Position + V3(0, 2, 0) }, Enum.EasingStyle.Sine)
	end
	-- bunga teratai neon: 3 lapis kelopak yang membuka
	local petals = {}
	for layer = 1, 3 do
		local n = 6 + layer * 2
		for i = 1, n do
			local pt = fxPart(Enum.PartType.Block, V3(1.6 - layer * 0.2, 0.15, 6 + layer * 1.6), layer == 2 and white or pink, CFrame.new(gp), 0.15, Enum.Material.Neon, 6)
			petals[#petals + 1] = { p = pt, a = i / n * PI * 2 + layer * 0.3, layer = layer, len = 6 + layer * 1.6 }
		end
	end
	local T, t0 = 3.2, os.clock()
	while os.clock() - t0 < T do
		local t = os.clock() - t0
		local open = math.clamp(t / 1.4, 0, 1)
		open = 1 - (1 - open) ^ 3
		local fade = math.clamp((t - 2.4) / 0.8, 0, 1)
		for _, e in ipairs(petals) do
			local tilt = math.rad(82 - open * (30 + e.layer * 16)) + math.sin(t * 2 + e.a) * 0.03
			local base = gp + V3(0, 0.3 + e.layer * 0.35, 0)
			local cf = CFrame.new(base) * ANG(0, e.a, 0) * CFrame.new(0, 0, -0.8) * ANG(tilt, 0, 0) * CFrame.new(0, 0, -e.len / 2)
			e.p.CFrame = cf
			e.p.Transparency = 0.15 + fade * 0.85
		end
		if t > 1.2 and R() < 0.5 then
			local a = R() * 6.28
			local fl = fxPart(Enum.PartType.Ball, ONE * 0.4, gold, CFrame.new(gp + V3(math.cos(a) * 1.5, 1.5, math.sin(a) * 1.5)), 0.1, nil, 3)
			tween(fl, 1.6, { Position = fl.Position + V3((R() - 0.5) * 8, 8 + R() * 8, (R() - 0.5) * 8), Transparency = 1 })
		end
		RunService.Heartbeat:Wait()
	end
	for _, e in ipairs(petals) do e.p:Destroy() end
	shineO(1)
	burst(gp + UP * 3, { Color = ColorSequence.new(white, pink), Speed = NumberRange.new(10, 35), Size = NS(1.4, 0), Acceleration = V3(0, 5, 0), Lifetime = NumberRange.new(1.4, 2.4) }, 80)
	ring(gp, pink, 40, 0.8)
	light(pos, pink, 8, 60, 1)
	popup(pos + V3(0, 5, 0), "BLOOM", pink, 30)
end)

