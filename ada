-- apakah target ini memang yang sedang kuserang (dekat / diarahkan mouse / tepat di crosshair)
local function aimingAt(char)
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char.PrimaryPart
	if not myRoot or not root then return false end
	local d = (root.Position - myRoot.Position).Magnitude
	if d <= 14 then return true end
	if d > 450 then return false end
	local ok, tgt = pcall(function() return player:GetMouse().Target end)
	if ok and tgt and tgt:IsDescendantOf(char) then return true end
	local c = cam()
	if c then
		local dir = root.Position - c.CFrame.Position
		if dir.Magnitude > 0.1 then
			local ang = math.deg(math.acos(math.clamp(c.CFrame.LookVector:Dot(dir.Unit), -1, 1)))
			if ang < 7 then return true end
		end
	end
	return false
end

