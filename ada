	bind(UserInputService.InputBegan, function(input, processed)
		if processed then return end
		if U.kbBusy and U.kbBusy() then return end
		if input.KeyCode == Enum.KeyCode.RightBracket or input.KeyCode == Enum.KeyCode.LeftBracket then
			local dir = (input.KeyCode == Enum.KeyCode.RightBracket) and 1 or -1
			local idx = 1
			for i, e in ipairs(EFFECTS) do
				if e.name == state.selected then idx = i end
			end
			idx = (idx - 1 + dir) % #EFFECTS + 1
			state.selected = EFFECTS[idx].name
			refresh()
			announce("EFFECT", string.upper(state.selected), byName[state.selected].color)
			saveSoon()
		elseif input.KeyCode == Enum.KeyCode.M then
			state.music = not state.music
			applyMusic()
			syncAll()
			saveSoon()
		end
	end)

	overUI = function(p)
		if holder.Visible then return true end
		local inset = GuiService:GetGuiInset()
		local function inside(o)
			local ap, as = o.AbsolutePosition, o.AbsoluteSize
			local inX = p.X >= ap.X and p.X <= ap.X + as.X
			local inY1 = p.Y >= ap.Y and p.Y <= ap.Y + as.Y
			local inY2 = (p.Y + inset.Y) >= ap.Y and (p.Y + inset.Y) <= ap.Y + as.Y
			return inX and (inY1 or inY2)
		end
		if inside(openBtn) then return true end
		return hud.Visible and inside(hud)
	end

