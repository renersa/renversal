						local q = HttpService:UrlEncode(text)
						local res, det, err = nil, nil, nil
						-- Google
						do
							local url = "https://translate.googleapis.com/translate_a/single?client=gtx&sl=" .. srcCode .. "&tl=" .. dstCode .. "&dt=t&q=" .. q
							local body = TR.fetch and TR.fetch(url) or nil
							if not body then
								pcall(function() body = game:HttpGet(url) end)
							end
							if body then
								local okd, d = pcall(function() return HttpService:JSONDecode(body) end)
								if okd and type(d) == "table" and type(d[1]) == "table" then
									local parts = {}
									for _, seg in ipairs(d[1]) do
										if type(seg) == "table" and type(seg[1]) == "string" then parts[#parts + 1] = seg[1] end
									end
									res = table.concat(parts)
									if type(d[3]) == "string" then det = d[3] end
								end
							end
						end
						-- MyMemory fallback
						if not res or res == "" then
							local sl = (srcCode == "auto") and "autodetect" or srcCode
							local body = TR.fetch and TR.fetch("https://api.mymemory.translated.net/get?q=" .. q .. "&langpair=" .. HttpService:UrlEncode(sl .. "|" .. dstCode))
							if body then
								local okd, d = pcall(function() return HttpService:JSONDecode(body) end)
								if okd and type(d) == "table" and type(d.responseData) == "table" then
									local t = d.responseData.translatedText
									if type(t) == "string" and t ~= "" and not t:lower():find("invalid", 1, true) then res = t end
								end
							end
						end
						-- LibreTranslate fallback
						if (not res or res == "") and httpReq then
							local req = httpReq()
							if req then
								local ok, r = pcall(req, {
									Url = "https://libretranslate.com/translate",
