local function terrRestore()
local t=workspace:FindFirstChildOfClass("Terrain")
if t then
for k,v in pairs(terrOrig)do pcall(function()t[k]=v end)end
end
table.clear(terrOrig)
end
local function clearShader()
terrRestore()
for _,e in ipairs(shFx)do pcall(function()e:Destroy()end)end
table.clear(shFx)
clearWeather()
end
local function buildShader()
clearShader()
local pr=SH[state.shMode]or SH[1]
for _,f in ipairs(pr.fx)do
local e=tagged(f[1])
e.Name=".scb20ce"
for k,v in pairs(f[2])do pcall(function()e[k]=v end)end
e.Parent=Lighting
shFx[#shFx+1]=e
end
if pr.t then
local t=workspace:FindFirstChildOfClass("Terrain")
if t then
for k,v in pairs(pr.t)do
if terrOrig[k]==nil then pcall(function()terrOrig[k]=t[k]end)end
pcall(function()t[k]=v end)
end
end
end
if pr.w then startWeather(pr.w)end
end
