		local function tile(parent, w, kind, name, order, deletable)
			local K = KEYS[w]
			local sel = tostring(state[K.kind]) == tostring(kind)
			local b = mk("TextButton", { Size = UDim2.fromOffset(76, 86), BackgroundColor3 = SURF2, Text = "", AutoButtonColor = false, LayoutOrder = order }, parent)
