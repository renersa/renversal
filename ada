local function bodyParts(char)
	local list = {}
	if char then
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then list[#list + 1] = d end
		end
	end
	return list
end

local function hide(char)
	if not char then return end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then d.Transparency = 1 end
	end
end

local function freezeParts(char)
	for _, p in ipairs(bodyParts(char)) do
		p.Anchored = true
		p.CanCollide = false
	end
end

local function launchParts(char, pos, force, dur, spin)
	for _, p in ipairs(bodyParts(char)) do
		p.Anchored, p.CanCollide = true, false
		local away = p.Position - pos
		away = (away.Magnitude < 0.1) and UP or away.Unit
		away = (away + V3((R() - 0.5) * 0.6, 0.7, (R() - 0.5) * 0.6)).Unit
		tween(p, dur, {
			CFrame = p.CFrame * ANG(R() * spin, R() * spin, R() * spin) + away * force * (0.6 + R() * 0.8),
			Transparency = 1,
		})
	end
end

local function popup(pos, text, color, size)
	local a = fxPart(Enum.PartType.Ball, ONE * 0.2, color, CFrame.new(pos + V3(0, 4, 0)), 1, nil, 3)
	local bb = Instance.new("BillboardGui")
	bb.Size, bb.AlwaysOnTop, bb.Adornee = UDim2.fromOffset(300, 60), true, a
	bb.Parent = a
	local l = Instance.new("TextLabel")
	l.Size, l.BackgroundTransparency = UDim2.fromScale(1, 1), 1
	l.Text, l.Font, l.TextSize, l.TextColor3 = text, Enum.Font.GothamBlack, size or 26, color
	l.Parent = bb
	local st = Instance.new("UIStroke")
	st.Thickness, st.Color = 2, Color3.new(0, 0, 0)
	st.Parent = l
	tween(a, 1.8, { Position = a.Position + V3(0, 6, 0) })
	task.delay(0.9, function()
		tween(l, 0.9, { TextTransparency = 1 })
		tween(st, 0.9, { Transparency = 1 })
	end)
end

local function groundY(pos, ignore)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local list = { fxFolder }
	if player.Character then list[#list + 1] = player.Character end
	if ignore then list[#list + 1] = ignore end
	rp.FilterDescendantsInstances = list
	local r = workspace:Raycast(pos, V3(0, -25, 0), rp)
	return r and r.Position.Y or (pos.Y - 3)
end

-- ghost: klon visual korban supaya efek tidak bentrok sama respawn game
local function makeGhost(char)
	local ok, clone = pcall(function() return char:Clone() end)
	if not ok or not clone then return nil end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Humanoid") or d:IsA("Sound") or d:IsA("BillboardGui")
			or d:IsA("ForceField") or d:IsA("Highlight") then
			d:Destroy()
		end
	end
	clone.Name = ".gcb20ce"
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch = true, false, false, false
		end
	end
	clone.Parent = fxFolder
	Debris:AddItem(clone, 10)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then d.Transparency = 1 end
	end
	return clone
end

