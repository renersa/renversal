			end
			while inflight < MAX_INFLIGHT and #queue >= 1 and not F.cancel and not F.found do
				local batch = {}
				for _ = 1, math.min(100, #queue) do
					local row = table.remove(queue, 1)
					if row then batch[#batch + 1] = row[1] end
				end
				if #batch == 0 then break end
				inflight = inflight + 1
				task.spawn(runBatch, batch)
			end
		end

		-- presence background
		task.spawn(function()
			while F.running and not F.found and not F.cancel do
