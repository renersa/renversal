						local row = mk("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = SURF, LayoutOrder = n }, listH)
						corner(row, 10)
						local dot = mk("Frame", { Position = UDim2.fromOffset(10, 16), Size = UDim2.fromOffset(8, 8), BackgroundColor3 = isNew and Color3.fromRGB(255, 170, 60) or Color3.fromRGB(110, 120, 135) }, row)
						corner(dot, 4)
						local kids = 0
						pcall(function() kids = #g:GetDescendants() end)
						lab(row, g.Name .. (g.Enabled and "" or "  (off)"), 12, FONTB, TXT, UDim2.fromOffset(26, 3), UDim2.new(1, -96, 0, 18))
						lab(row, (g.Parent and g.Parent.Name or "?") .. "  \u{2022}  " .. kids .. " obj" .. (isNew and "  \u{2022}  " .. L("baru", "new") or ""), 10, FONT, DIM, UDim2.fromOffset(26, 21), UDim2.new(1, -96, 0, 14))
						local x = mk("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(70, 28), BackgroundColor3 = Color3.fromRGB(200, 70, 70), Text = L("TUTUP", "CLOSE"), Font = FONTK, TextSize = 11, TextColor3 = Color3.new(1, 1, 1), AutoButtonColor = false }, row)
						corner(x, 9)
						x.MouseButton1Click:Connect(function()
							click()
							local ok = kill(g)
							say("det", ok and (L("Ditutup: ", "Closed: ") .. g.Name) or (L("Dinonaktifkan (tidak bisa di-destroy): ", "Disabled (cannot destroy): ") .. g.Name))
							render()
						end)
						rows[#rows + 1] = row
					end
				end
				if n == 0 then
					rows[1] = lab(listH, L("Tidak ada GUI ditemukan.", "No GUI found."), 12, FONT, DIM, UDim2.new(), UDim2.new(1, 0, 0, 30))
				end
			end
			bScan.MouseButton1Click:Connect(function() click(); render() end)
			bNew.MouseButton1Click:Connect(function()
				click(); onlyNew = not onlyNew
				bNew.Text = onlyNew and L("HANYA BARU", "NEW ONLY") or L("SEMUA", "ALL")
				render()
			end)
			bAll.MouseButton1Click:Connect(function()
				click()
				local c = 0
				for _, g in ipairs(scan()) do if not base[g] then kill(g); c = c + 1 end end
				say("det", L("Ditutup: ", "Closed: ") .. c)
				render()
			end)
			bAuto.MouseButton1Click:Connect(function()
