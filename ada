	local sigil2 = fxPart(Enum.PartType.Cylinder, V3(0.25, 30, 30), blue, CFrame.new(gp) * ANG(0, 0, PI / 2), 0.4)
	tween(sigil2, T * 0.6, { Size = V3(0.25, 2, 2), Transparency = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

	-- horizon + cincin foton + accretion disk + jet
	local halo = fxPart(Enum.PartType.Ball, ONE, blue, CFrame.new(center), 0.65)
	local hole = fxPart(Enum.PartType.Ball, ONE, void, CFrame.new(center), 0, Enum.Material.Metal)
