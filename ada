		if t >= 1 then break end
		local dist = -60 + 115 * (t ^ 1.2)
		local c = V3(pos.X, gp.Y + H / 2 - 1, pos.Z) + dir * dist
		local cf = CFrame.lookAt(c, c + dir)
		body.CFrame = cf
		under.CFrame = cf * CFrame.new(0, -H * 0.15, 1.2)
