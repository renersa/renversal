	dim(0.3, 3.4)
	for k = 1, 8 do
		task.delay(k * 0.12, function() sfx(SND_PING, 0.8, 0.6 + k * 0.18) end)
	end
	local tiles = {}
	local N = 7
	for ix = 1, N do
		for iz = 1, N do
			local off = V3((ix - (N + 1) / 2) * 3.2, 0.06, (iz - (N + 1) / 2) * 3.2)
			local t = fxPart(Enum.PartType.Block, V3(3, 0.12, 3), cols[R(1, #cols)], CFrame.new(gp + off), 1, Enum.Material.Neon, 6)
