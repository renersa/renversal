		local at = pos + V3((R() - 0.5) * 3, (R() - 0.5) * 4, (R() - 0.5) * 3)
		balloons[i] = {
			b = fxPart(Enum.PartType.Ball, V3(2.2, 2.7, 2.2) * (0.85 + R() * 0.35), col, CFrame.new(at), 0.04, Enum.Material.SmoothPlastic, 5),
			s = fxPart(Enum.PartType.Block, V3(0.06, 3.6, 0.06), WHITE, CFrame.new(at), 0.2, Enum.Material.SmoothPlastic, 5),
			a = R() * 6.28, sp = 0.8 + R() * 1.4, rise = 12 + R() * 12, ph = R() * 6.28, off = at - pos, col = col, pop = 1.1 + R() * 1.3, alive = true,
		}
	end
	for _, p in ipairs(bodyParts(char)) do tween(p, 0.35, { Transparency = 1, Size = p.Size * 0.4 }) end
	for _, c in ipairs(colors) do
		burst(pos, { Color = ColorSequence.new(c, WHITE), Speed = NumberRange.new(30, 65), Lifetime = NumberRange.new(1.3, 2.4), Acceleration = V3(0, -40, 0), Drag = 1.5, Size = NS(0.9, 0.3) }, 28)
	end
	-- konfeti jatuh
	for _ = 1, I(95) do
		local c = fxPart(Enum.PartType.Block, V3(0.38, 0.04, 0.24), colors[R(1, #colors)], CFrame.new(pos + V3(0, 1, 0)) * ANG(R() * 6, R() * 6, R() * 6), 0, Enum.Material.SmoothPlastic, 5)
		local peak = pos + V3((R() - 0.5) * 26, 8 + R() * 14, (R() - 0.5) * 26)
		tween(c, 0.5, { Position = peak }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(0.5, function()
			tween(c, 1.8 + R() * 0.8, { Position = peak - V3((R() - 0.5) * 8, 20, (R() - 0.5) * 8), Orientation = V3(R(0, 720), R(0, 720), R(0, 720)) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			task.delay(1.5, function() tween(c, 0.6, { Transparency = 1 }) end)
		end)
	end
	-- roket kembang api
	for i = 1, 4 do
		task.delay(0.15 + i * 0.22, function()
			local c, c2 = colors[R(1, #colors)], colors[R(1, #colors)]
			local peak = pos + V3((R() - 0.5) * 22, 14 + R() * 12, (R() - 0.5) * 22)
			local rocket = fxPart(Enum.PartType.Ball, ONE * 0.8, c, CFrame.new(pos), 0, nil, 3)
			local tr = stream(rocket, { Color = ColorSequence.new(WHITE, c), Size = NS(1, 0), Lifetime = NumberRange.new(0.3, 0.5), Speed = NumberRange.new(0, 2), Rate = 90 })
			tween(rocket, 0.4, { Position = peak }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.wait(0.4)
			tr.Enabled = false
			rocket:Destroy()
			sfx(SND_PING, 0.8, 1.2 + R() * 0.5)
			sfx(SND_SNAP, 0.5, 0.8)
			light(peak, c, 7, 45, 0.7)
			burst(peak, { Color = ColorSequence.new(c, c2), Speed = NumberRange.new(25, 58), Lifetime = NumberRange.new(1, 1.9), Acceleration = V3(0, -14, 0), Size = NS(1.8, 0) }, 80)
			ring(peak, c, 24, 0.5)
		end)
	end
	-- pita serpentin spiral
	for h = 1, 3 do
		for i = 1, 22 do
			task.delay(i * 0.03, function()
				local a = h * 2.1 + i * 0.55
				local rib = fxPart(Enum.PartType.Block, V3(0.18, 1.6, 0.5), colors[((h + i) % #colors) + 1], CFrame.new(ctr + V3(math.cos(a) * (2 + i * 0.35), 0.5, math.sin(a) * (2 + i * 0.35))), 0, nil, 3)
				tween(rib, 1.3, { Position = rib.Position + V3(0, 8 + i * 0.5, 0), Orientation = V3(R(0, 360), R(0, 360), R(0, 360)), Transparency = 1 }, Enum.EasingStyle.Sine)
			end)
		end
	end
	popup(pos + V3(0, 5, 0), "PARTY!", colors[R(1, #colors)], 36)
	local t0 = os.clock()
	while true do
		local t = os.clock() - t0
		if t >= 2.6 then break end
		for _, bm in ipairs(beams) do
			bm.p.CFrame = CFrame.new(ctr) * ANG(0, bm.a + t * 3.2, 0) * ANG(rad(32 + math.sin(t * 4 + bm.a) * 10), 0, 0) * CFrame.new(0, 0, -22)
			bm.p.Transparency = 0.45 + math.clamp((t - 1.8) / 0.8, 0, 1) * 0.55
		end
		for _, b in ipairs(balloons) do
			if b.alive then
				local p = pos + b.off * 0.4 + V3(math.sin(t * b.sp + b.ph) * 1.6, b.rise * (1 - math.exp(-t * 1.2)), math.cos(t * b.sp + b.ph) * 1.6)
				b.b.CFrame = CFrame.new(p)
				b.s.CFrame = CFrame.new(p - V3(0, 2.8, 0)) * ANG(math.sin(t * 2 + b.ph) * 0.2, 0, 0)
				if t > b.pop then
					b.alive = false
					b.b:Destroy()
					b.s:Destroy()
					sfx(SND_SNAP, 0.8, 1.2 + R() * 0.7)
					burst(p, { Color = ColorSequence.new(b.col, WHITE), Speed = NumberRange.new(14, 34), Lifetime = NumberRange.new(0.8, 1.6), Acceleration = V3(0, -20, 0), Size = NS(0.9, 0) }, 22)
				end
			end
		end
		RunService.Heartbeat:Wait()
	end
	for _, b in ipairs(balloons) do
		if b.alive then
			b.alive = false
			burst(b.b.Position, { Color = ColorSequence.new(b.col, WHITE), Speed = NumberRange.new(14, 34), Acceleration = V3(0, -20, 0), Size = NS(0.9, 0) }, 18)
			b.b:Destroy()
			b.s:Destroy()
		end
	end
	for _, bm in ipairs(beams) do bm.p:Destroy() end
	hide(char)
end
