	local idx = 0
	while alive() and gui and gui.Parent do
		if state.showcase then
			idx = idx % #EFFECTS + 1
			state.selected = EFFECTS[idx].name
			refresh()
			testEffect()
			task.wait(7)
		else
			task.wait(0.5)
		end
	end
end)
