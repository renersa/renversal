	local TITLE_Y = 7
	-- kilauan menyapu judul; judul naik-turun mengikuti kilauan yang lewat. Kekuatan diatur state.shine (0 - 3).
	local function band(cx, w, base, peak)
		local t1 = math.clamp(cx - w, 0.001, 0.996)
		local t2 = math.clamp(cx, t1 + 0.001, 0.998)
		local t3 = math.clamp(cx + w, t2 + 0.001, 0.999)
		return {
			ColorSequenceKeypoint.new(0, base), ColorSequenceKeypoint.new(t1, base),
			ColorSequenceKeypoint.new(t2, peak), ColorSequenceKeypoint.new(t3, base), ColorSequenceKeypoint.new(1, base),
		}, { t1, t2, t3 }
	end
	bind(RunService.RenderStepped, function()
		if not holder.Visible then return end
		local ok, pos = pcall(function() return UserInputService:GetMouseLocation() end)
		if not ok or not pos then return end
		local abs = titleWrap.AbsolutePosition
		local sz = titleWrap.AbsoluteSize
		local inside = pos.X >= abs.X and pos.X <= abs.X + sz.X and pos.Y >= abs.Y and pos.Y <= abs.Y + sz.Y
		local k = math.clamp(tonumber(state.shine) or 1, 0, 3)
		local bell = 0
		if state.titleShine ~= false and k > 0 then
			local cx
			if inside then
				cx = math.clamp((pos.X - abs.X) / math.max(1, sz.X), 0, 1)
			else
				-- sapuan tiap ~2.6 dtk: kilau jalan kiri ke kanan, lalu jeda sebentar
				local ph = (os.clock() % 2.6) / 2.6
				cx = ph < 0.62 and (-0.2 + (ph / 0.62) * 1.4) or -2
			end
			local w = 0.08 + 0.05 * math.min(k, 2)
			local lo = math.clamp(232 - 22 * math.min(k, 2), 180, 232) -- makin tinggi k, teks dasar makin redup supaya kilau makin kontras
			local base = Color3.fromRGB(lo, lo + 4, lo + 16)
			if cx > -0.3 and cx < 1.3 then
				local keys, t = band(cx, w, base, WHITE)
				titleGrad.Color = ColorSequence.new(keys)
				titleGrad.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(t[1], 0.12),
					NumberSequenceKeypoint.new(t[2], 0), NumberSequenceKeypoint.new(t[3], 0.12), NumberSequenceKeypoint.new(1, 0.12),
				})
				bell = math.sin(math.pi * math.clamp(cx, 0, 1))
			else
				titleGrad.Color = ColorSequence.new(base)
				titleGrad.Transparency = NumberSequence.new(0.12)
			end
			titleGlow.Thickness = 0.5 + 0.7 * k
			titleGlow.Transparency = math.clamp(1 - bell * (0.35 + 0.22 * k), 0.15, 1)
		else
			titleGrad.Color = ColorSequence.new(WHITE)
			titleGrad.Transparency = NumberSequence.new(0)
			titleGlow.Transparency = 1
		end
		local target = inside and 1 or bell
		titleLift = titleLift + (target - titleLift) * 0.3
		local amp = 2 + 3 * math.min(math.max(k, 0.4), 2)
		titleWrap.Position = UDim2.new(0.5, 0, 0, TITLE_Y - math.floor(amp * titleLift + 0.5))
	end)
