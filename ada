	function U.ccatEquip(assetId, key, name)
		key = tostring(key or assetId)
		assetId = tonumber(assetId)
		if not assetId then return false, "ID tidak valid" end
		local ch = player.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if not hum or not ch then return false, "karakter belum ada" end
		ccatClearOne(key)

		local real = 0
		local fold = ccatFolder()

		-- A) GetObjects / InsertService -> accessory asli
		local objs = loadAssetObjs(assetId)
		if objs then
			for _, o in ipairs(objs) do
				pcall(function()
					if o:IsA("Accessory") or o:IsA("Hat") then
						o.Name = "ccat_" .. key
						o:SetAttribute("ccatKey", key)
						o:SetAttribute("_cb20ce54", true)
						if pcall(function() hum:AddAccessory(o) end) then
							real = real + 1
						else
							o.Parent = fold or ch
							local handle = o:FindFirstChild("Handle")
							if handle and weldPart(ch, handle) then real = real + 1 end
						end
					elseif o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic") then
						-- baju / celana / T-shirt: pasang langsung di karakter (client), yang lama disimpan untuk dikembalikan
						ccat._old = ccat._old or {}
						ccat._old[key] = ccat._old[key] or {}
						for _, x in ipairs(ch:GetChildren()) do
							if x.ClassName == o.ClassName and not x:GetAttribute("ccatKey") then
								table.insert(ccat._old[key], { inst = x, where = "char" })
								x.Parent = nil
							end
						end
						o.Name = "ccat_" .. key
						o:SetAttribute("ccatKey", key)
						o.Parent = ch
						real = real + 1
					elseif o:IsA("Decal") and ch:FindFirstChild("Head") then
						-- wajah
						local head = ch.Head
						ccat._old = ccat._old or {}
						ccat._old[key] = ccat._old[key] or {}
						for _, x in ipairs(head:GetChildren()) do
							if x:IsA("Decal") and x.Name == "face" and not x:GetAttribute("ccatKey") then
								table.insert(ccat._old[key], { inst = x, where = "head" })
								x.Parent = nil
							end
						end
						o.Name = "face"
						o:SetAttribute("ccatKey", key)
						o.Parent = head
						real = real + 1
					elseif o:IsA("BasePart") then
						o.Name = "ccat_" .. key
						o:SetAttribute("ccatKey", key)
						o.Parent = fold or ch
						if weldPart(ch, o) then real = real + 1 end
					elseif o:IsA("Model") then
						o.Name = "ccat_" .. key
						o:SetAttribute("ccatKey", key)
						o.Parent = fold or ch
						local p0 = o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
						if p0 and weldPart(ch, p0) then real = real + 1 end
					elseif o:IsA("Folder") or o:IsA("Configuration") then
						for _, c in ipairs(o:GetChildren()) do
							if c:IsA("Accessory") or c:IsA("Hat") then
								c.Name = "ccat_" .. key
								c:SetAttribute("ccatKey", key)
								if pcall(function() hum:AddAccessory(c) end) then real = real + 1 end
							end
						end
					end
				end)
			end
		end

		-- B) HumanoidDescription (kalau A gagal)
		if real == 0 then
			local before = countAcc(ch)
			pcall(function()
				local d = hum:GetAppliedDescription()
				ccat._descSnap = ccat._descSnap or {}
				local fields = { "HatAccessory", "HairAccessory", "FaceAccessory", "BackAccessory", "WaistAccessory", "ShouldersAccessory", "FrontAccessory", "NeckAccessory" }
				local snap = {}
				for _, f in ipairs(fields) do snap[f] = d[f] end
				ccat._descSnap[key] = snap
				local cur = tostring(d.HatAccessory or "")
				d.HatAccessory = (cur == "" and tostring(assetId)) or (cur .. "," .. tostring(assetId))
				hum:ApplyDescription(d)
			end)
			if countAcc(ch) > before then real = 1 end
		end

		-- C) fallback tag
		local fallback = false
		if real == 0 then
			if placeFallbackTag(ch, key, name) then fallback = true end
		end

		if real > 0 or fallback then
			ccat.on[key] = { id = assetId, name = name or ("ID " .. assetId), fallback = fallback }
			return true, fallback and "item tidak bisa dimuat — tampil sebagai tag" or nil
		end
		return false, "gagal equip"
	end

	function U.ccatToggle(assetId, key, name)
		key = tostring(key or assetId)
		if ccat.on[key] then
			U.ccatUnequip(key)
			return false
		end
		local ok, err = U.ccatEquip(assetId, key, name)
		return ok, err
	end

	-- ---------- helper umum ----------
	local function fmtNum(n)
		local s = tostring(floor(tonumber(n) or 0))
		local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
		return (out:gsub("^,", ""))
	end

	-- cache info produk (nama, harga, kreator, deskripsi) — antrian 3 worker
	local infoCache, infoWait, infoQueue, infoWorkers = {}, {}, {}, 0
	local function getInfo(id, cb)
		id = tonumber(id)
		if not id then return end
		local c = infoCache[id]
		if c ~= nil then
			if c and cb then cb(c) end
			return
		end
		if infoWait[id] then
			if cb then table.insert(infoWait[id], cb) end
			return
		end
		infoWait[id] = { cb }
		table.insert(infoQueue, id)
		local function worker()
			infoWorkers = infoWorkers + 1
			while #infoQueue > 0 do
				local nid = table.remove(infoQueue, 1)
				local ok, res = pcall(function() return MarketplaceService:GetProductInfo(nid, Enum.InfoType.Asset) end)
				infoCache[nid] = (ok and type(res) == "table") and res or false
				local waiters = infoWait[nid] or {}
				infoWait[nid] = nil
				if infoCache[nid] then
					for _, f in ipairs(waiters) do if f then pcall(f, infoCache[nid]) end end
				end
				task.wait(0.05)
			end
			infoWorkers = infoWorkers - 1
		end
		if infoWorkers < 3 then task.spawn(worker) end
	end

	-- teks harga: return label, tipe ("free"|"paid"|"off"|"load")
	local function priceLabel(it, info)
		local ps = it.pstatus
		if ps == "Off Sale" or ps == "OffSale" then return "Off sale", "off" end
		if type(it.price) == "number" and it.price > 0 then return fmtNum(it.price), "paid" end
		if it.price == 0 or ps == "Free" then return "Free", "free" end
		if info then
			if info.IsForSale == false then return "Off sale", "off" end
			if type(info.PriceInRobux) == "number" and info.PriceInRobux > 0 then return fmtNum(info.PriceInRobux), "paid" end
			return "Free", "free"
		end
		return "···", "load"
	end

