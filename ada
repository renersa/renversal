		refreshGallery = function()
			local w = gal.which
			if not w or not gal.body then return end
			local K = KEYS[w]
			gal.title.Text = K.title
			for _, c in ipairs(gal.body:GetChildren()) do
				if c:IsA("GuiObject") then c:Destroy() end
			end
			local function section(t, order)
				lab(gal.body, t, 10, FONTK, DIM, nil, UDim2.new(1, 0, 0, 16)).LayoutOrder = order
			end
			local function grid(order)
				local g = mk("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order }, gal.body)
				mk("UIGridLayout", { CellSize = UDim2.fromOffset(76, 86), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }, g)
				return g
			end
			section("BUILT-IN", 1)
			local g1 = grid(2)
			for i, o in ipairs(OPTS[w]) do tile(g1, w, o[1], o[2], i, false) end
			section("SAVED (your custom IDs)", 3)
			local saved = state[K.saved]
