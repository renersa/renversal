	local arrNow = 45
	local function pointArrow(deg, t)
		while deg - arrNow > 180 do deg -= 360 end
		while deg - arrNow < -180 do deg += 360 end
		arrNow = deg
		tween(arr, t, { Rotation = deg }, Enum.EasingStyle.Quad)
	end
	local rsz, rStart, rW, rH = false, nil, 660, 420
	grip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			rsz, rStart, rW, rH = true, Vector2.new(input.Position.X, input.Position.Y), state.uiW, state.uiH
			panX, panY = state.uiX, state.uiY
		end
	end)
	bind(UserInputService.InputChanged, function(input)
		if not (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then return end
		if panDrag then
			local d = Vector2.new(input.Position.X, input.Position.Y) - panStart
			state.uiX, state.uiY = panX + d.X, panY + d.Y
			applyPos()
		elseif rsz then
			local d = Vector2.new(input.Position.X, input.Position.Y) - rStart
			if d.Magnitude > 4 then pointArrow(math.deg(math.atan2(d.Y, d.X)), 0.08) end
			state.uiW, state.uiH = rW + d.X / baseFit, rH + d.Y / baseFit
			clampSize()
			state.uiX = panX + (state.uiW - rW) * baseFit / 2
			state.uiY = panY + (state.uiH - rH) * baseFit / 2
			applyPos()
		end
	end)
	bind(UserInputService.InputEnded, function(input)
		if (panDrag or rsz) and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			if rsz then pointArrow(45, 0.3) end
			panDrag, rsz = false, false
			saveSoon()
		end
	end)

