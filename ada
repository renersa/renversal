	function U.seenRecord(r)
		if type(r) ~= "table" or r.status ~= "ingame" or not r.uid then return end
		local g = r.game or r.where
		local p = tonumber(r.place)
		if not (g or p) then return end
		if type(state.lookSeen) ~= "table" then state.lookSeen = {} end
		local key, now = tostring(r.uid), os.time()
		local cur = state.lookSeen[key]
		if cur and cur.g == (g and tostring(g):sub(1, 80)) and cur.p == p and now - (cur.t or 0) < 120 then return end
		state.lookSeen[key] = { g = g and tostring(g):sub(1, 80) or (cur and cur.g), p = p or (cur and cur.p), t = now }
		local n, oldK, oldT = 0, nil, math.huge
		for k, v in pairs(state.lookSeen) do
			n = n + 1
			if (v.t or 0) < oldT then oldK, oldT = k, v.t or 0 end
		end
		if n > 200 and oldK then state.lookSeen[oldK] = nil end
		saveSoon()
	end
