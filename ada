			local GUARD = { "kill%s*fx", "kill%s*effect", "efek%s*kill", "ultimate%s*kill", "killfx", "efek%s*pembunuh", "cara%s*kerja%s*(script|sc|efek)", "system%s*prompt", "prompt%s*(awal|sistem|kamu)", "instruksi%s*(awal|sistem|kamu)", "source%s*code", "kode%s*(sumber|script|sc|efek)", "sc%s*(ini|kamu|nya)", "script%s*(ini|kamu|nya|menu)", "decompile", "dump%s*(script|sc|kode)" }
			local function guarded(t)
				local l = tostring(t):lower()
				local alt = { ["cara%s*kerja%s*(script|sc|efek)"] = { "cara kerja script", "cara kerja sc", "cara kerja efek" }, ["prompt%s*(awal|sistem|kamu)"] = { "prompt awal", "prompt sistem", "prompt kamu" }, ["instruksi%s*(awal|sistem|kamu)"] = { "instruksi awal", "instruksi sistem", "instruksi kamu" }, ["kode%s*(sumber|script|sc|efek)"] = { "kode sumber", "kode script", "kode sc", "kode efek" }, ["sc%s*(ini|kamu|nya)"] = { "sc ini", "sc kamu", "sc nya", "scnya" }, ["script%s*(ini|kamu|nya|menu)"] = { "script ini", "script kamu", "script nya", "scriptnya", "script menu" } }
				for _, pt in ipairs(GUARD) do
					if alt[pt] then
						for _, w in ipairs(alt[pt]) do if l:find(w, 1, true) then return true end end
					elseif not pt:find("|", 1, true) and l:find(pt) then return true end
				end
				return false
			end
			local function call(prov, mdl, msgs)
				local req = httpReq()
				if not req then return nil, "Executor tidak punya fungsi request()", 0 end
				local url, headers, body
				local JSON = { ["Content-Type"] = "application/json" }
				if prov == "Gemini" then
					local c = {}
					for _, m in ipairs(msgs) do c[#c + 1] = { role = (m.role == "user") and "user" or "model", parts = { { text = m.text } } } end
					url = "https://generativelanguage.googleapis.com/v1beta/models/" .. mdl .. ":generateContent"
					JSON["x-goog-api-key"] = keys[prov]
					headers, body = JSON, { contents = c, systemInstruction = { parts = { { text = SYS } } } }
				elseif prov == "Claude" then
					local c = {}
					for _, m in ipairs(msgs) do c[#c + 1] = { role = (m.role == "user") and "user" or "assistant", content = m.text } end
					url = "https://api.anthropic.com/v1/messages"
					JSON["x-api-key"] = keys[prov]
					JSON["anthropic-version"] = "2023-06-01"
					headers, body = JSON, { model = mdl, max_tokens = 1024, system = SYS, messages = c }
				else
					local c = {}
					c[1] = { role = "system", content = SYS }
					for _, m in ipairs(msgs) do c[#c + 1] = { role = (m.role == "user") and "user" or "assistant", content = m.text } end
					url = (prov == "OpenAI") and "https://api.openai.com/v1/chat/completions" or "https://openrouter.ai/api/v1/chat/completions"
					JSON["Authorization"] = "Bearer " .. keys[prov]
					headers, body = JSON, { model = mdl, messages = c, max_tokens = 1024 }
				end
				local ok, res = pcall(req, { Url = url, Method = "POST", Headers = headers, Body = HttpService:JSONEncode(body) })
				if not ok or type(res) ~= "table" then return nil, "Gagal konek ke server", 0 end
				local st = res.StatusCode or 0
				local okd, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
				if not okd or type(data) ~= "table" then data = nil end
				if st >= 200 and st < 300 and data then
					local text, tok
					pcall(function()
						if prov == "Gemini" then
							local parts = {}
							for _, p in ipairs(data.candidates[1].content.parts) do parts[#parts + 1] = p.text or "" end
							text = table.concat(parts)
							tok = data.usageMetadata and data.usageMetadata.totalTokenCount
						elseif prov == "Claude" then
							text = data.content[1].text
							tok = data.usage and ((data.usage.input_tokens or 0) + (data.usage.output_tokens or 0))
						else
							text = data.choices[1].message.content
							tok = data.usage and data.usage.total_tokens
						end
					end)
					if text and text ~= "" then return text, tok or 0, st end
					return nil, "Balasan kosong / diblokir", st
				end
				local msg = "HTTP " .. tostring(st)
				if data and data.error then
					msg = type(data.error) == "table" and tostring(data.error.message or msg) or tostring(data.error)
				end
				return nil, msg, st
			end

			local function send()
