U.tfStuds=math.clamp(tonumber(power)or 100,0,5000)
if not on or U.tfRun then return end
U.tfRun=true
task.spawn(function()
local movel=0.1
local mul,lastTs,stall,seen={},{},{},{}
while U.tfOn and alive()and not killed do
RunService.Heartbeat:Wait()
local r=myRoot()
if r and U.tfStuds>0 then
local sp=U.flingSpeed(U.tfStuds)
local now=os.clock()
local tgt,tr
for _,pl in ipairs(Players:GetPlayers())do
local t2=pl~=player and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
if t2 and(t2.Position - r.Position).Magnitude<6 then tgt,tr=pl,t2 break end
end
if tgt then
seen[tgt]=now
local ts=tr.AssemblyLinearVelocity.Magnitude
if ts>=sp*0.95 then
else
local m=mul[tgt]or 1
if ts<=(lastTs[tgt]or 0)+0.5 then
stall[tgt]=(stall[tgt]or 0)+1
