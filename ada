						local res = d and d.scripts
						if type(res) ~= "table" then return nil end
						local out = {}
						for _, s in ipairs(res) do
							if #out < 15 then
								local by = (type(s.user) == "table" and s.user.username) or "?"
								out[#out + 1] = mkItem("RScripts", tostring(s.title or "?"), nil, s.image,
									"@" .. tostring(by) .. "  \u{2022}  " .. tostring(s.views or 0) .. " views" .. (s.mobileReady and "  \u{2022}  mobile" or ""),
									function()
										local raw = s.rawScript
										if type(raw) ~= "string" or raw == "" then return nil end
										if raw:match("^https?://%S+$") then return fetch(raw) end
										return raw
									end)
							end
						end
						return out
					end
					local function fromGeneric(def)
						local enc = HttpService:UrlEncode(q)
						local url = (def.url:gsub("{q}", function() return enc end))
						local d = jget(url)
						if not d then return nil end
						local res = d.scripts or d.data or d.results or d.items or (type(d.result) == "table" and (d.result.scripts or d.result)) or d
						if type(res) ~= "table" then return nil end
						local out = {}
						for _, s in ipairs(res) do
							if type(s) == "table" and #out < 15 then
								local g = (type(s.game) == "table" and s.game.name) or s.gameName or s.game
								if type(g) ~= "string" then g = "Universal" end
								local img = s.image or s.thumbnail or s.imageUrl or (type(s.game) == "table" and s.game.imageUrl)
								if type(img) ~= "string" then img = nil end
								out[#out + 1] = mkItem(def.name, tostring(s.title or s.name or "?"), (type(s.game) == "table") and tonumber(s.game.gameId) or tonumber(s.placeId), img,
									g .. "  \u{2022}  " .. tostring(s.views or 0) .. " views",
									function()
										local raw = s.script or s.rawScript or s.source or s.code or s.content
										if type(raw) == "string" and raw ~= "" then
											if raw:match("^https?://%S+$") then return fetch(raw) end
											return raw
										end
										local slug = s.slug or s.id or s._id
										if slug and def.raw then return fetch((def.raw:gsub("{slug}", function() return tostring(slug) end))) end
									end)
							end
						end
						return out
					end
					local selected = {}
					for i = 2, #SOURCES do
						if srcIdx == 1 or srcIdx == i then selected[#selected + 1] = i end
					end
					local results, pending = {}, #selected
					for _, si in ipairs(selected) do
						task.spawn(function()
							local ok, res
							if si == 2 then ok, res = pcall(fromScriptBlox)
							elseif si == 3 then ok, res = pcall(fromRScripts)
							else ok, res = pcall(fromGeneric, CONFIG.SEARCH_SOURCES[si - 3]) end
							results[si] = (ok and type(res) == "table") and res or false
							pending = pending - 1
						end)
					end
					local tw = os.clock()
					while pending > 0 and os.clock() - tw < 16 do task.wait(0.1) end
					local lists, okCount = {}, 0
					for _, si in ipairs(selected) do
						if type(results[si]) == "table" then
							okCount = okCount + 1
							lists[#lists + 1] = results[si]
						end
					end
					local idx = 1
					while #items < 36 do
						local added = false
						for _, l in ipairs(lists) do
							if l[idx] then items[#items + 1] = l[idx] added = true end
						end
						if not added then break end
						idx = idx + 1
					end
					local data = (okCount > 0) or nil
					if my ~= gen or not alive() then return end
					if not data then say("Gagal mencari (cek koneksi / HttpGet)", "err") return end
					clearList()
					if #items == 0 then
						local ef = mk("Frame", { Size = UDim2.new(1, -6, 0, 90), BackgroundTransparency = 1, LayoutOrder = 1 }, list)
						lab(ef, "no script matches", 14, FONTB, DIM, nil, UDim2.fromScale(1, 1), Enum.TextXAlignment.Center)
						say("")
						return
					end
					pinned()
					local jobs = {}
					for i, it in ipairs(items) do
						jobs[#jobs + 1] = { img = card(i, it.title, it.info, it.code, nil), it = it }
					end
					-- muat gambar PARALEL (maks 8 sekaligus) supaya semua kartu cepat punya gambar
					task.spawn(function()
						local active = 0
						for _, j in ipairs(jobs) do
							if not alive() then return end
							while active >= 8 do task.wait(0.03) end
							active = active + 1
							task.spawn(function()
								pcall(function()
									if not j.img.Parent then return end
									local done = false
									if j.it.placeId then done = gameIcon(j.it.placeId, j.img) end
									if not done and j.it.imgUrl then urlAsset(j.it.imgUrl, j.img) end
								end)
								active = active - 1
							end)
						end
					end)
					say(#items .. " " .. T("hasil") .. "  \u{2022}  " .. srcName .. "  (" .. okCount .. "/" .. #selected .. ")")
					end)
					if not okS and my == gen then say("Error: " .. tostring(eS):sub(1, 80), "err") end
				end)
			end
