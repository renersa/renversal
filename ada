				{ { "7" }, { "8" }, { "9" }, { "-", "op" } },
				{ { "4" }, { "5" }, { "6" }, { "+", "op" } },
				{ { "1" }, { "2" }, { "3" }, { "^", "op" } },
				{ { "pi", "fn", "PI" }, { "0" }, { "." }, { "=", "eq" } },
			}
			for r, row in ipairs(rows) do
