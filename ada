	local pad = fxPart(CYL, V3(0.15, 1, 1), fire, CFrame.new(gp + V3(0, 0.05, 0)) * ANG(0, 0, PI / 2), 0.2, nil, 6)
	tween(pad, 0.6, { Size = V3(0.15, 16, 16) })
