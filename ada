				if not ext then return end
				pcall(function()
					if makefolder and not (isfolder and isfolder(imgDir)) then makefolder(imgDir) end
				end)
				local path = imgDir .. "/" .. tostring(key) .. ext
				if not pcall(writefile, path, body) then return end
