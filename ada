local function place(b,ord,who,idx)
b[idx]=who
local q=ord[who]
q[#q+1]=idx
local removed=nil
if#q>3 then
removed=table.remove(q,1)
b[removed]=0
end
return removed
end
local function empties(b)
local t={}
