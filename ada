local function auraPass(color, pos, gp)
	local bright = color:Lerp(WHITE, 0.45)
	-- tint layar + saturasi
	local cc = tagged("ColorCorrectionEffect")
	cc.TintColor, cc.Saturation, cc.Contrast = WHITE:Lerp(color, 0.35), 0.35, 0.12
	cc.Parent = Lighting
	tween(cc, 1.7, { TintColor = WHITE, Saturation = 0, Contrast = 0 }, Enum.EasingStyle.Sine)
	Debris:AddItem(cc, 2)
	-- flash dasar
	local f = sphere(pos, WHITE, 11 * state.intensity, 0.35, 0.1)
	light(pos, color, 6, 30, 0.9)
	-- cakram cahaya di tanah
	local disc = fxPart(Enum.PartType.Cylinder, V3(0.2, 3, 3), color, CFrame.new(gp) * ANG(0, 0, PI / 2), 0.35, Enum.Material.Neon, 3)
	tween(disc, 1.2, { Size = V3(0.15, 16, 16), Transparency = 1 }, Enum.EasingStyle.Quint)
	ring(gp, bright, 26, 0.9, 0.2)
	ring(gp + UP * 0.1, color, 16, 1.2, 0.3)
	-- sinar tipis ke langit
	local beam = fxPart(Enum.PartType.Block, V3(1.2, 80, 1.2), bright, CFrame.new(gp + UP * 40), 0.3, Enum.Material.Neon, 2)
	tween(beam, 1.4, { Size = V3(0.1, 80, 0.1), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	-- streak anamorphic horizontal menghadap kamera
	local c = cam()
	local look = c and c.CFrame or CFrame.new(pos + V3(0, 0, 20))
	local right = look.RightVector
	local streak = fxPart(Enum.PartType.Block, V3(3, 0.35, 0.2), WHITE, CFrame.lookAt(pos, pos + look.LookVector * -1, UP), 0.05, Enum.Material.Neon, 2)
	tween(streak, 0.6, { Size = V3(48, 0.05, 0.1), Transparency = 1 }, Enum.EasingStyle.Quint)
	-- orb jiwa spiral naik
	for i = 1, I(7) do
		task.spawn(function()
			local a0 = (i / 7) * PI * 2
			local o = fxPart(Enum.PartType.Ball, ONE * R(4, 7) / 10, i % 2 == 0 and color or bright, CFrame.new(gp), 0.1, Enum.Material.Neon, 3)
			local t0 = os.clock()
			while o.Parent do
				local t = os.clock() - t0
				if t > 1.8 then break end
				local a = a0 + t * 4
				local rad_ = 1.5 + t * 1.2
				o.CFrame = CFrame.new(pos + V3(math.cos(a) * rad_, -2 + t * 7, math.sin(a) * rad_))
				o.Transparency = math.clamp(t / 1.8, 0.1, 1)
				task.wait()
			end
			if o.Parent then o:Destroy() end
		end)
	end
	-- percikan jatuh
	burst(pos + UP * 4, { Color = ColorSequence.new(bright, color), Texture = TEX_SPARK, Size = NS(0.7, 0), Lifetime = NumberRange.new(0.8, 1.6), Speed = NumberRange.new(14, 34), Acceleration = V3(0, -22, 0), LightEmission = 1 }, 30)
end

local function fire(char, pos, name, useGhost)
	local e = byName[name]
	if not e then return end
	local gp = V3(pos.X, groundY(pos, char) + 0.12, pos.Z)
	local target = char
	if useGhost then target = makeGhost(char) or char end
	kick(e.color, pos, gp)
	if state.aura then task.spawn(auraPass, e.color, pos, gp) end
	vignette(e.color)
	cinema(1.9)
	task.spawn(function()
		setCtx(name)
		active += 1
		playSlot("start", 1.4, 1, true)
		local fn = (active > 5) and quick or e.fn
		local ok, err = pcall(fn, target, pos, gp)
		if not ok then pcall(function() end) end
		playSlot("finish")
		active -= 1
	end)
end

local function play(char, pos)
	if recent[char] and os.clock() - recent[char] < 3 then return end
	recent[char] = os.clock()
	local name = pickName()
	local e = byName[name]
	if os.clock() - lastKill < 4 then combo += 1 else combo = 1 end
	lastKill = os.clock()
	state.kills += 1
	saveSoon()
	updateKills()
	local pl = Players:GetPlayerFromCharacter(char)
	local hum0 = char:FindFirstChildOfClass("Humanoid")
	local who = pl and pl.DisplayName or ((hum0 and hum0.DisplayName ~= "") and hum0.DisplayName or char.Name)
	announce(tierName(combo) or T("ELIMINATED"), string.upper(who) .. "  \u{2022}  " .. string.upper(name) .. (combo > 1 and ("   x" .. combo) or ""), e.color)
	addFeed(who, e)
	popup(pos, "\u{1F480} " .. string.upper(who), e.color, 24)
	fire(char, pos, name, true)
	if combo >= 3 then
		local c2 = e.color
		task.delay(0.35, function()
			rays(pos, { c2, WHITE }, 40, 52, 0.9)
			flash(c2, 0.4, 0.4)
			punch(10, 0.4)
		end)
	end
end

