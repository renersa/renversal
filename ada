bc.LeftArmColor,bc.RightArmColor=bk(colors.leftArmColorId,1),bk(colors.rightArmColorId,1)
bc.LeftLegColor,bc.RightLegColor=bk(colors.leftLegColorId,1),bk(colors.rightLegColorId,1)
