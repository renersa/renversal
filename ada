	local sliderActive, activeScroller, sliderTok = nil, nil, 0
	local function sliderRow(parent, order, text, lo, hi, get, set, fmt, scr)
		local f = mk("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = SURF, LayoutOrder = order }, parent)
		corner(f, 10)
		lab(f, text, 12, FONTB, TXT, UDim2.fromOffset(10, 4), UDim2.new(0.6, 0, 0, 20))
		local val = lab(f, "", 12, FONTK, DIM, UDim2.new(0.6, 0, 0, 4), UDim2.new(0.4, -10, 0, 20), RIGHT)
		local track = mk("Frame", { Position = UDim2.new(0, 10, 0, 33), Size = UDim2.new(1, -20, 0, 6), BackgroundColor3 = SURF2, BorderSizePixel = 0 }, f)
		corner(track, 3)
		local fill = acc(mk("Frame", { Size = UDim2.fromScale(0.5, 1), BorderSizePixel = 0 }, track))
		corner(fill, 3)
		local knob = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = TXT, BorderSizePixel = 0, ZIndex = 2 }, track)
		corner(knob, 8)
		local hitBtn = mk("TextButton", { Position = UDim2.new(0, 4, 0, 22), Size = UDim2.new(1, -8, 0, 24), BackgroundTransparency = 1, Text = "", ZIndex = 3 }, f)
		local myTok = 0
		local function show(v)
			local a = math.clamp((v - lo) / (hi - lo), 0, 1)
			fill.Size = UDim2.fromScale(a, 1)
			knob.Position = UDim2.fromScale(a, 0.5)
			val.Text = fmt(v)
		end
		local function fromInput(input)
			-- pakai posisi absolut track SAJA untuk slider ini
			local x = input.Position.X
			local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			local v = lo + a * (hi - lo)
			show(v)
			set(v)
		end
		hitBtn.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
			-- isolasi: token unik, tidak bisa digeser 2 slider sekaligus
			sliderTok += 1
			myTok = sliderTok
			sliderActive = function(inp)
				if myTok ~= sliderTok then return end
				fromInput(inp)
			end
			activeScroller = scr
			if scr then scr.ScrollingEnabled = false end
			click()
			fromInput(input)
		end)
		syncs[#syncs + 1] = function() show(get()) end
		show(get())
	end
	bind(UserInputService.InputChanged, function(input)
		if not sliderActive then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			sliderActive(input)
		end
	end)
	bind(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliderTok += 1 -- invalidasi semua slider aktif
			sliderActive = nil
			if activeScroller then activeScroller.ScrollingEnabled = true end
			activeScroller = nil
		end
	end)

