	hide(char)
	for i = 1, 4 do
		burst(pos, { Color = ColorSequence.new(pal[R(1, #pal)], pal[R(1, #pal)]), Speed = NumberRange.new(20, 55), Lifetime = NumberRange.new(0.8, 1.5), Acceleration = V3(0, -30, 0) }, 24)
	end
	shake(2, 0.4)
	punch(10, 0.4)
	ring(gp, pal[R(1, #pal)], 34, 0.6)
	local G, t0, last = -80, os.clock(), os.clock()
	while os.clock() - t0 < 1.2 do
		local now = os.clock()
		local dt = math.min(now - last, 0.05)
		last = now
		for _, d in ipairs(drops) do
			if not d.done then
				d.v = d.v + V3(0, G * dt, 0)
				local np = d.p.Position + d.v * dt
				if np.Y <= gp.Y + d.r then
					d.done = true
					splat(V3(np.X, 0, np.Z), 1.5 + R() * 2.5, d.col)
					d.p:Destroy()
				else
					d.p.Position = np
				end
			end
		end
		RunService.Heartbeat:Wait()
	end
	for _, d in ipairs(drops) do
		if not d.done then d.p:Destroy() end
	end
end)

