	local function chooseServer(list, ss)
		local seen = {}
		for _, id in ipairs(ss.seen or {}) do seen[id] = true end
		local pool = {}
		for _, s in ipairs(list) do
			if not seen[s.id] then pool[#pool + 1] = s end
		end
		if #pool == 0 then pool = list end
		local smart = (ss.low == true) or ((ss.reg or 1) > 1)
		if smart then
			table.sort(pool, function(a, b)
				local pa, pb = a.ping or 9999, b.ping or 9999
				if pa ~= pb then return pa < pb end
				return (a.fps or 0) > (b.fps or 0)
			end)
		else
			for i = #pool, 2, -1 do
				local j = R(1, i)
				pool[i], pool[j] = pool[j], pool[i]
			end
		end
		if not smart then return pool[1], "" end
		local g = myGeo()
		local best, bestScore, tested, failed = nil, nil, 0, 0
		if g then
			for i = 1, math.min(#pool, 12) do
				say("hop", L("Cek lokasi server ", "Checking server location ") .. i .. "...")
				local sg = serverGeo(pool[i].id)
				if not sg then
					failed = failed + 1
					if failed >= 3 and tested == 0 then break end
				else
					tested = tested + 1
					local km = distKm(g.lat, g.lon, sg.lat, sg.lon)
					local ok = true
					if (ss.reg or 1) > 1 then ok = (regionOf(sg.lat, sg.lon) == ss.reg) end
					if ok and (not bestScore or km < bestScore) then best, bestScore = pool[i], km end
					if ok and (ss.reg or 1) > 1 then break end
					if ok and km < 800 then break end
				end
			end
		end
		if best then return best, "" end
		return pool[1], L(" (lokasi server tidak terbaca, akan diverifikasi setelah masuk)", " (server location unreadable, will verify after joining)")
	end
	-- ---------- SCAN SERVER: 5 server terbaik + kota/region (cara scan sama seperti Find Players) ----------
	U.hs = { running = false, cancel = false, status = "", list = {}, pool = nil, pi = 1, rest = {}, total = 0, sig = "" }
