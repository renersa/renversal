	local spyLog, spyOn, spyHooked = {}, false, false
	function U.spyToggle(on)
		spyOn = on
		if on and not spyHooked then
			if not (hookmetamethod and getnamecallmethod) then
				spyOn = false
				return false
			end
			spyHooked = true
			local old
			local wrap = newcclosure or function(f) return f end
			old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
				local m = getnamecallmethod()
				if spyOn and (m == "FireServer" or m == "InvokeServer") then
					local a = { ... }
					pcall(function()
						local parts = {}
						for i = 1, math.min(#a, 4) do
							parts[i] = (type(a[i]) == "string") and ('"' .. a[i]:sub(1, 30) .. '"') or tostring(a[i])
						end
						spyLog[#spyLog + 1] = os.date("%H:%M:%S") .. "  " .. tostring(self.Name) .. ":" .. m .. "(" .. table.concat(parts, ", ") .. ")"
						if #spyLog > 80 then table.remove(spyLog, 1) end
					end)
				end
				return old(self, ...)
			end))
		end
		return true
	end
