	function U.avatarItems(uid)
		local req = httpReq()
		if not req then return nil, "executor tidak punya request()" end
		local ok, res = pcall(req, { Url = "https://avatar.roblox.com/v1/users/" .. uid .. "/avatar", Method = "GET" })
		local d = ok and type(res) == "table" and type(res.Body) == "string" and jdecode(res.Body)
		if type(d) ~= "table" or type(d.assets) ~= "table" then return nil, "gagal membaca avatar (profil privat / API diblokir)" end
		local out = {}
		for _, a in ipairs(d.assets) do
			out[#out + 1] = { id = a.id, name = a.name or "?", kind = a.assetType and a.assetType.name or "?" }
		end
		return out
	end
	function U.itemWear(id)
		local hum = myHum()
		if not hum then return false, "karakter belum ada" end
		local ok, m = pcall(function() return game:GetService("InsertService"):LoadAsset(id) end)
		if not ok or not m then return false, "gagal memuat item (executor tidak mendukung LoadAsset?)" end
		local worn = false
		for _, c in ipairs(m:GetChildren()) do
			if c:IsA("Accessory") then
				pcall(function() hum:AddAccessory(c) end)
				worn = true
			elseif c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") then
				local ch = hum.Parent
				for _, o in ipairs(ch:GetChildren()) do
					if o.ClassName == c.ClassName then o:Destroy() end
				end
