add("Constellation", "\u{2728}", C3(150, 175, 255), function(char, pos, gp)
	local blue, gold = C3(150, 175, 255), C3(255, 225, 150)
	freezeParts(char)
	dim(0.34, 3.8)
	sfx(SND_PING, 1, 0.5)
	sfx(SND_BASS, 1, 0.4)
	local cap = I(26)
	local pts = {}
	for _, p in ipairs(bodyParts(char)) do
		if p.Transparency < 1 then
			for _ = 1, 2 do
				if #pts < cap then
					local at = p.CFrame:PointToWorldSpace(V3((R() - 0.5) * p.Size.X, (R() - 0.5) * p.Size.Y, (R() - 0.5) * p.Size.Z))
					pts[#pts + 1] = { rel = at - pos, ph = R() * 6, star = fxPart(Enum.PartType.Ball, ONE * (0.5 + R() * 0.5), (R() < 0.3) and gold or WHITE, CFrame.new(at), 1, nil, 8) }
				end
			end
		end
	end
	for _, s in ipairs(pts) do
		task.delay(R() * 0.6, function() tween(s.star, 0.3, { Transparency = 0 }) end)
	end
	local lines, seen = {}, {}
	for i, a in ipairs(pts) do
		local best = {}
		for j, b in ipairs(pts) do
			if j ~= i then best[#best + 1] = { j = j, d = (a.rel - b.rel).Magnitude } end
		end
		table.sort(best, function(x, y) return x.d < y.d end)
		for k = 1, math.min(2, #best) do
			local j = best[k].j
			local key = (i < j) and (i .. "-" .. j) or (j .. "-" .. i)
			if not seen[key] then
				seen[key] = true
				lines[#lines + 1] = { a = i, b = j, p = fxPart(Enum.PartType.Block, V3(0.1, 0.1, 1), blue, CFrame.new(pos), 1, nil, 8) }
			end
		end
	end
	for _, l in ipairs(lines) do
		task.delay(0.3 + R() * 0.6, function() tween(l.p, 0.3, { Transparency = 0.25 }) end)
	end
	local bg = {}
	for i = 1, I(40) do
		local dir = V3(R() - 0.5, R() - 0.5, R() - 0.5).Unit
		local s = fxPart(Enum.PartType.Ball, ONE * (0.2 + R() * 0.4), (R() < 0.3) and gold or WHITE, CFrame.new(pos + dir * (14 + R() * 18)), 1, nil, 8)
		bg[i] = { p = s, ph = R() * 6 }
		task.delay(R() * 0.9, function() tween(s, 0.4, { Transparency = 0.1 }) end)
	end
	for _, p in ipairs(bodyParts(char)) do tween(p, 0.9, { Transparency = 1 }) end
	light(pos, blue, 5, 50, 2)
	local T, t0 = 2, os.clock()
	local P = {}
	while true do
		local t = (os.clock() - t0) / T
		if t >= 1 then break end
		local ang, sc = t * 1.4, 1 + 0.5 * t
		local c, sn = math.cos(ang), math.sin(ang)
		for i, s in ipairs(pts) do
			local r = s.rel
			P[i] = pos + V3(r.X * c - r.Z * sn, r.Y, r.X * sn + r.Z * c) * sc + V3(0, math.sin(t * 3 + s.ph) * 0.3, 0)
			s.star.Position = P[i]
		end
		for _, l in ipairs(lines) do
			local a, b = P[l.a], P[l.b]
			local len = (a - b).Magnitude
			if len > 0.05 then
				l.p.Size = V3(0.1, 0.1, len)
				l.p.CFrame = CFrame.lookAt((a + b) / 2, b)
			end
		end
		if t > 0.65 then
			for _, s in ipairs(bg) do s.p.Transparency = 0.1 + 0.5 * (0.5 + 0.5 * math.sin(t * 8 + s.ph)) end
		end
		RunService.Heartbeat:Wait()
	end
	boom(1.6, 1.2)
	sfx(SND_PING, 1.2, 2)
	flash(blue, 0.6, 0.6)
	punch(14, 0.5)
	for i, s in ipairs(pts) do
		local dir = (P[i] or pos) - pos
		if dir.Magnitude < 0.1 then dir = V3(0, 1, 0) end
		tween(s.star, 0.7, { Position = s.star.Position + dir.Unit * 60, Size = ONE * 0.2, Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	for _, l in ipairs(lines) do tween(l.p, 0.4, { Transparency = 1 }) end
	for _, s in ipairs(bg) do tween(s.p, 0.5, { Transparency = 1 }) end
	ring(gp, blue, 40, 0.7)
	rays(pos, { blue, gold, WHITE }, 40, 50, 0.9)
	burst(pos, { Color = ColorSequence.new(WHITE, blue), Speed = NumberRange.new(30, 80) }, 70)
end)

