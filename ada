				local l = lab(gal.body, "Nothing saved yet. Any custom ID you apply below is kept here.", 11, FONT, DIM, nil, UDim2.new(1, 0, 0, 30))
				l.LayoutOrder = 4
				l.TextWrapped = true
			else
				local g2 = grid(4)
				for i, id in ipairs(saved) do tile(g2, w, id, "ID " .. id:sub(1, 8), i, true) end
			end
			section("CUSTOM ID", 5)
			local f = mk("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = SURF, LayoutOrder = 6 }, gal.body)
			corner(f, 10)
			local box = mk("TextBox", { Position = UDim2.fromOffset(8, 7), Size = UDim2.new(1, -108, 0, 26), BackgroundColor3 = SURF2, Text = "", PlaceholderText = "Image asset ID", PlaceholderColor3 = DIM, ClearTextOnFocus = false, Font = Enum.Font.Code, TextSize = 12, TextColor3 = TXT, TextXAlignment = Enum.TextXAlignment.Left }, f)
			corner(box, 6)
