	-- ---------- cuaca (hujan / badai / salju) ----------
	local drops, wCfg, wConn, wGen, wParts, wCfs = {}, nil, nil, 0, {}, {}
	local rayP = RaycastParams.new()
	rayP.FilterType = Enum.RaycastFilterType.Exclude
	local function clearWeather()
		wGen = wGen + 1
		if wConn then wConn:Disconnect() wConn = nil end
		for _, d in ipairs(drops) do pcall(function() d.p:Destroy() end) end
		table.clear(drops)
		table.clear(wParts)
		table.clear(wCfs)
		wCfg = nil
	end
	local function placeDrop(d, c, fresh)
		local a = R() * PI * 2
		local r = math.sqrt(R()) * 58
		local x, z = c.X + math.cos(a) * r, c.Z + math.sin(a) * r
		local top = c.Y + 48
		rayP.FilterDescendantsInstances = { player.Character, fxFolder }
		local hit = workspace:Raycast(V3(x, top + 40, z), V3(0, -260, 0), rayP)
		d.floor = hit and hit.Position.Y or (c.Y - 40)
		d.x, d.z = x, z
		if d.floor >= top - 2 then
			d.idle = os.clock() + 0.6
			d.y = -1e4
			return
		end
		d.y = fresh and (d.floor + R() * (top - d.floor)) or top
	end
	local function wStep(dt)
		local c = cam()
		if not c or not wCfg then return end
		local cp = c.CFrame.Position
		local cfg = wCfg
		local now = os.clock()
		for i, d in ipairs(drops) do
			if d.idle then
				if now >= d.idle then d.idle = nil placeDrop(d, cp, false) end
			else
				d.y = d.y - d.vy * dt
				if cfg.snow then
					d.x = d.x + (math.sin(now * d.sw + d.ph) * (cfg.glow and 2.2 or 0.9) + cfg.wind * 8) * dt
				else
					d.x = d.x + cfg.wind * d.vy * dt
				end
				local dx, dz = d.x - cp.X, d.z - cp.Z
				if d.y <= d.floor then
					if not cfg.snow and dx * dx + dz * dz < 784 and R() < 0.1 then
						local rp = fxPart(Enum.PartType.Cylinder, V3(0.05, 0.3, 0.3), C3(210, 225, 245), CFrame.new(d.x, d.floor + 0.08, d.z) * ANG(0, 0, PI / 2), 0.4, Enum.Material.Neon, 1)
						tween(rp, 0.28, { Size = V3(0.05, 1.8, 1.8), Transparency = 1 })
					end
					placeDrop(d, cp, false)
				elseif dx * dx + dz * dz > 4900 then
					placeDrop(d, cp, true)
				end
			end
			if cfg.snow then
				wCfs[i] = CFrame.new(d.x, d.y, d.z)
			else
				wCfs[i] = CFrame.new(d.x, d.y, d.z) * cfg.rot
			end
		end
		pcall(function() workspace:BulkMoveTo(wParts, wCfs, Enum.BulkMoveMode.FireCFrameChanged) end)
	end
	local function startWeather(w)
		clearWeather()
		wCfg = w
		w.rot = CFrame.lookAt(ZERO, V3(w.wind or 0, -1, 0).Unit)
		local c = cam()
		local cp = c and c.CFrame.Position or ZERO
		for i = 1, w.n do
			local p = Instance.new("Part")
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
			p.Material = Enum.Material.Neon
			if w.snow then
				p.Shape = Enum.PartType.Ball
				p.Size = ONE * ((w.size or 0.2) + R() * 0.2)
				p.Color = w.col or WHITE
				p.Transparency = w.glow and 0.05 or 0.1
			else
				p.Size = V3(0.05, 0.05, 2.2 + R() * 0.8)
				p.Color = w.col or C3(190, 210, 238)
				p.Transparency = 0.5
			end
			p.CFrame = CFrame.new(0, -1e4, 0)
			p.Parent = fxFolder
			local d = { p = p, vy = w.vy[1] + R() * (w.vy[2] - w.vy[1]), sw = 0.6 + R() * 1.4, ph = R() * 6.28 }
			drops[i] = d
			wParts[i] = p
			wCfs[i] = p.CFrame
			placeDrop(d, cp, true)
		end
		wConn = RunService.Heartbeat:Connect(wStep)
		if w.storm then
			local gen = wGen
			task.spawn(function()
				while alive() and not killed and wGen == gen do
					task.wait(R(6, 14) + R())
					if wGen ~= gen or killed then break end
					local cc = cam()
					if cc then
						local ang = R() * PI * 2
						local dist = R(90, 220)
						local base = cc.CFrame.Position + V3(math.cos(ang), 0, math.sin(ang)) * dist
						pcall(function() bolt(base + V3(0, 260, 0), base - V3(0, 6, 0), 3, C3(210, 225, 255), 0.3, 0) end)
						flash(C3(215, 228, 255), 0.5, 0.5)
						task.delay(0.12, function() flash(C3(235, 242, 255), 0.35, 0.35) end)
						task.delay(0.5 + dist / 340, function() if not killed then sfx(SND_BOOM, 1.3, 0.45) sfx(SND_BASS, 1, 0.5) end end)
					end
				end
			end)
		end
	end

