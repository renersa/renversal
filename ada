	-- ambil SEMUA server: 2 produser paralel (Desc + Asc), retry bertahap, dedupe (sama seperti scan Find Players)
	local function hsCollect(S)
		local seen, all, producers = {}, {}, 2
		local function produce(order)
			local cursor
			for _ = 1, 200 do
				if S.cancel then break end
				local url = "https://games.roblox.com/v1/games/" .. PLACE .. "/servers/Public?sortOrder=" .. order .. "&limit=100" .. (cursor and ("&cursor=" .. cursor) or "")
				local d
				for try = 1, 6 do
					if S.cancel then break end
					d = jdecode(http(url) or "")
					if d and type(d.data) == "table" then break end
					d = nil
					task.wait(math.min(0.5 * try, 2.5))
				end
				if not d then break end
				for _, sv in ipairs(d.data) do
					if type(sv.id) == "string" and not seen[sv.id] then
						seen[sv.id] = true
						all[#all + 1] = sv
					end
				end
				hsStatus(L("Scan server: ", "Scanning servers: ") .. #all)
				cursor = d.nextPageCursor
				if not cursor then break end
				task.wait(0.03)
			end
			producers = producers - 1
		end
		task.spawn(produce, "Desc")
		task.spawn(produce, "Asc")
		while producers > 0 and not S.cancel do task.wait(0.1) end
		return all
	end
	local function hsPool(all, maxP)
		local now, recent = os.time(), (type(state.hopSess) == "table" and type(state.hopSess.recent) == "table") and state.hopSess.recent or {}
		local good, fb = {}, {}
		for _, sv in ipairs(all) do
			if sv.id ~= game.JobId and type(sv.playing) == "number" and type(sv.maxPlayers) == "number" and sv.playing < sv.maxPlayers and ((not maxP) or sv.playing <= maxP) then
				local free = sv.maxPlayers - sv.playing
				local fresh = not (recent[sv.id] and now - recent[sv.id] < 900)
				if sv.playing >= 1 and free >= math.max(2, math.ceil(sv.maxPlayers * 0.1)) and fresh then good[#good + 1] = sv else fb[#fb + 1] = sv end
			end
		end
		local pool = #good > 0 and good or fb
		table.sort(pool, function(a, b)
			local pa, pb = a.ping or 9999, b.ping or 9999
			if pa ~= pb then return pa < pb end
			return (a.fps or 0) > (b.fps or 0)
		end)
		return pool
	end
	-- ambil 5 server berikutnya: cek lokasi (kota/region) kandidat teratas, urut dari yang terdekat
	local function hsBatch(S, reg, low)
		local want, batch = 5, {}
		while #S.rest > 0 and #batch < want do batch[#batch + 1] = table.remove(S.rest, 1) end
		if #batch < want then
			local g = myGeo()
			local tmp, attempts, failStreak, geoDead = {}, 0, 0, false
			local need = want - #batch
			while S.pi <= #S.pool and #tmp < need * 2 and attempts < 26 and not S.cancel do
				local sv = S.pool[S.pi]
				S.pi = S.pi + 1
				attempts = attempts + 1
				hsStatus(L("Cek lokasi server ", "Checking server location ") .. attempts .. L(" (cocok: ", " (matched: ") .. #tmp .. ")")
				local sg = serverGeo(sv.id)
				if sg and sg.lat and sg.lon then
					failStreak = 0
					local km = g and distKm(g.lat, g.lon, sg.lat, sg.lon) or nil
					local ridx = regionOf(sg.lat, sg.lon)
					local okR = (reg or 1) <= 1 or ridx == reg
					local okL = not (low and km and km > 3000)
					if okR and okL then tmp[#tmp + 1] = { sv = sv, geo = sg, km = km, reg = ridx } end
				else
					failStreak = failStreak + 1
					if failStreak >= 5 and #tmp == 0 then geoDead = true break end
					task.wait(0.15)
				end
				task.wait(0.1)
			end
			table.sort(tmp, function(a, b)
				if a.km and b.km and a.km ~= b.km then return a.km < b.km end
				return (a.sv.ping or 9999) < (b.sv.ping or 9999)
			end)
			for _, e in ipairs(tmp) do
				if #batch < want then batch[#batch + 1] = e else S.rest[#S.rest + 1] = e end
			end
			-- lokasi server tidak bisa dibaca sama sekali: tampilkan urut ping data Roblox
			if geoDead and #batch == 0 then
				while #batch < want and S.pi <= #S.pool do
					batch[#batch + 1] = { sv = S.pool[S.pi] }
					S.pi = S.pi + 1
				end
			end
		end
		return batch
	end
	function U.hopScan(refresh)
		local S = U.hs
		if S.running then return end
		local maxP
		if state.hopMode == 2 then
			maxP = tonumber(state.hopMax)
			if not maxP or maxP < 1 then hsStatus(L("Isi jumlah pemain dulu (angka).", "Type the player count first (number).")) return end
		end
		local sig = tostring(state.hopRegion) .. "|" .. tostring(state.hopLow) .. "|" .. tostring(maxP)
		S.running, S.cancel = true, false
		task.spawn(function()
			local ok, err = pcall(function()
				local cont = refresh and S.pool and S.sig == sig and (#S.rest > 0 or S.pi <= #S.pool)
				if not cont then
					S.list, S.rest, S.pi, S.pool, S.sig = {}, {}, 1, nil, sig
					if U.hsUpd then pcall(U.hsUpd) end
					hsStatus(L("Scan server...", "Scanning servers..."))
					local all = hsCollect(S)
					if S.cancel then hsStatus(L("Scan dihentikan.", "Scan stopped.")) return end
					if #all == 0 then hsStatus(L("Gagal ambil daftar server / tidak ada server lain.", "Could not get server list / no other server.")) return end
					S.total = #all
					S.pool = hsPool(all, maxP)
					if #S.pool == 0 then hsStatus(maxP and (L("Tidak ada server dengan pemain <= ", "No server with players <= ") .. maxP) or L("Tidak ada server lain.", "No other server found.")) return end
				end
				local batch = hsBatch(S, state.hopRegion, state.hopLow)
				if S.cancel then hsStatus(L("Scan dihentikan.", "Scan stopped.")) return end
				S.list = batch
				if #batch == 0 then
					hsStatus(L("Tidak ada server cocok. Ganti Region / Low ping lalu SCAN ulang.", "No matching server. Change Region / Low ping and scan again."))
				else
					hsStatus(L("Dari ", "From ") .. S.total .. L(" server: ", " servers: ") .. #batch .. L(" terbaik. Tekan REFRESH untuk 5 berikutnya.", " best. Press REFRESH for the next 5."))
				end
			end)
			S.running = false
			if not ok then hsStatus("Error: " .. tostring(err)) end
			if U.hsUpd then pcall(U.hsUpd) end
		end)
	end
	function U.hopJoin(e)
		local now = os.time()
		local old = state.hopSess
		local recent = (type(old) == "table" and type(old.recent) == "table") and old.recent or {}
		recent[game.JobId] = now
		recent[e.sv.id] = now
		for id, t in pairs(recent) do if now - t > 900 then recent[id] = nil end end
		local ss = { on = true, manual = true, left = 0, seen = { game.JobId, e.sv.id }, recent = recent, reg = state.hopRegion, low = state.hopLow }
		state.hopSess = ss
		saveCfg()
		hsStatus(L("Join server ", "Joining server ") .. e.sv.playing .. "/" .. e.sv.maxPlayers .. "...")
		U.join(PLACE, e.sv.id, function(ok, err)
			if not ok then
				ss.on = false
				saveCfg()
				hsStatus(L("Gagal join: ", "Join failed: ") .. tostring(err) .. L(" (tekan REFRESH untuk server lain)", " (press REFRESH for another)"))
			end
		end)
	end
	function U.hop(auto)
		if hopBusy then return end
		hopBusy = true
		task.delay(60, function() hopBusy = false end)
		task.spawn(function()
			local function done(msg) say("hop", msg) hopBusy = false end
			local ss
			if auto then
				ss = sess()
			else
				local custom = state.hopMode == 2
				local maxP
				if custom then
					maxP = tonumber(state.hopMax)
					if not maxP or maxP < 1 then return done(L("Isi jumlah pemain dulu (angka).", "Type the player count first (number).")) end
				end
				local old = state.hopSess
				ss = { on = true, left = 6, retry = 0, seen = { game.JobId }, maxP = maxP, reg = state.hopRegion, low = state.hopLow, recent = (type(old) == "table" and type(old.recent) == "table") and old.recent or {} }
				state.hopSess = ss
			end
			ss.recent = type(ss.recent) == "table" and ss.recent or {}
			say("hop", L("Mencari server...", "Searching servers..."))
			local list, err = fetchServers(ss.maxP, ss.maxP and 6 or 3, ss)
			if not list then ss.on = false return done(L("Gagal ambil daftar server: ", "Failed to get server list: ") .. tostring(err)) end
			if #list == 0 then
				ss.on = false
				return done(ss.maxP and (L("Tidak ada server dengan pemain <= ", "No server with players <= ") .. ss.maxP) or L("Tidak ada server lain.", "No other server found."))
			end
			local pick, note = chooseServer(list, ss)
			ss.left = (ss.left or 1) - 1
			ss.seen = ss.seen or {}
			ss.seen[#ss.seen + 1] = pick.id
			-- riwayat server yang baru dikunjungi (dibawa antar sesi hop, kedaluwarsa 15 menit)
			local now = os.time()
			ss.recent[game.JobId] = now
			ss.recent[pick.id] = now
			for id, t in pairs(ss.recent) do if now - t > 900 then ss.recent[id] = nil end end
			saveCfg()
			local qld = U.selfLoader(game.PlaceId)
			if queue_on_teleport and qld and not state.autoExec then pcall(queue_on_teleport, qld) end
			say("hop", L("Pindah: ", "Joining: ") .. pick.playing .. "/" .. pick.maxPlayers .. L(" pemain (data server)", " players (server data)") .. note)
			local ok, e = pcall(function() TeleportService:TeleportToPlaceInstance(PLACE, pick.id, player) end)
			if not ok then done(L("Gagal teleport: ", "Teleport failed: ") .. tostring(e)) end
		end)
	end
	function U.hopStop()
		U.hs.cancel = true
		local ss = sess()
		ss.on = false
		saveCfg()
		say("hop", L("Hop otomatis dihentikan.", "Auto hop stopped."))
	end
	-- dipanggil saat script jalan di server baru: ukur ping & jumlah pemain SUNGGUHAN, ulangi bila belum cocok
	function U.hopArrive()
		local ss = sess()
		if not ss.on or killed then return end
		ss.retry = 0
		task.spawn(function()
			task.wait(5) -- biar koneksi & replikasi pemain stabil dulu
			local samples = {}
			for _ = 1, 12 do
				local p = myPing()
				if p and p > 1 then samples[#samples + 1] = p end
				task.wait(0.5)
			end
			-- median (tahan terhadap lonjakan sesaat), bukan rata-rata
			local rtt
			if #samples >= 3 then
				table.sort(samples)
				local m = #samples
				rtt = (m % 2 == 1) and samples[(m + 1) / 2] or (samples[m / 2] + samples[m / 2 + 1]) / 2
			end
			local cnt = #Players:GetPlayers()
			local okPlayers = (not ss.maxP) or cnt <= ss.maxP
			local okPing, e = true, nil
			if rtt then okPing, e = pingMatches(rtt, ss.reg or 1, ss.low) end
			local info = cnt .. L(" pemain, ping ", " players, ping ") .. (rtt and math.floor(rtt + 0.5) or "?") .. " ms"
			if ss.manual then
				ss.on = false
				saveCfg()
				say("hop", L("Tiba di server pilihanmu: ", "Arrived at your chosen server: ") .. info)
				pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Server Hop", Text = info, Duration = 6 }) U.notifSound() end)
				return
			end
			if okPlayers and okPing then
				ss.on = false
				saveCfg()
				say("hop", L("Server cocok: ", "Matching server: ") .. info)
				pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Server Hop", Text = info, Duration = 6 }) U.notifSound() end)
			elseif (ss.left or 0) > 0 then
				say("hop", L("Belum cocok (", "Not a match (") .. info .. L("), cari lagi...", "), searching again..."))
				task.wait(2)
				U.hop(true)
			else
				ss.on = false
				saveCfg()
				say("hop", L("Batas percobaan habis. Terakhir: ", "Attempts used up. Last: ") .. info)
			end
		end)
	end
	bind(TeleportService.TeleportInitFailed, function(_, res, msg)
		hopBusy = false
		say("hop", L("Teleport gagal: ", "Teleport failed: ") .. tostring(msg or res))
		-- server penuh / sudah tutup: otomatis pilih server lain (tidak memakai jatah percobaan)
		local ss = sess()
		if ss.on and not ss.manual and not killed then
			ss.retry = (ss.retry or 0) + 1
			if ss.retry <= 4 then
				ss.left = (ss.left or 0) + 1
				task.delay(1.5, function() U.hop(true) end)
			else
				ss.on = false
				saveCfg()
			end
		end
	end)

	-- ---------- waypoint saver ----------
	local function wpData()
		if type(state.wp) ~= "table" then state.wp = {} end
		local k = tostring(PLACE)
		local t = state.wp[k]
		if type(t) ~= "table" then t = {} state.wp[k] = t end
		if type(t.pts) ~= "table" then t.pts = {} end
		if type(t.spawn) ~= "number" then t.spawn = 0 end
		return t
	end
	U.wp = wpData
	local function myRoot()
		local ch = player.Character
		return ch and ch:FindFirstChild("HumanoidRootPart"), ch
	end
	function U.wpSave()
		local root = myRoot()
		if not root then return end
		local t = wpData()
		local p = root.Position
		t.pts[#t.pts + 1] = { n = L("Titik ", "Point ") .. (#t.pts + 1), x = p.X, y = p.Y, z = p.Z }
		saveSoon()
		if U.onWp then U.onWp() end
		say("wp", L("Lokasi disimpan.", "Location saved."))
	end
	function U.wpGo(i)
		local t = wpData()
		local p = t.pts[i]
		local root, ch = myRoot()
		if p and root then ch:PivotTo(CFrame.new(p.x, p.y, p.z)) end
	end
	function U.wpDel(i)
		local t = wpData()
		table.remove(t.pts, i)
		if t.spawn == i then t.spawn = 0 elseif t.spawn > i then t.spawn = t.spawn - 1 end
		saveSoon()
		if U.onWp then U.onWp() end
	end
	function U.wpSetSpawn(i)
		wpData().spawn = i
		saveSoon()
		if U.sync then U.sync() end
		if U.onWp then U.onWp() end
	end
	function U.wpSpawnText()
		local t = wpData()
		if t.spawn == -1 then return L("Lokasi terakhir", "Last location") end
		if t.spawn > 0 and t.pts[t.spawn] then return t.pts[t.spawn].n end
		return L("Bawaan game", "Game default")
	end
	function U.wpCycleSpawn()
		local t = wpData()
		local nx = t.spawn + 1
		if t.spawn == 0 then nx = -1 elseif t.spawn == -1 then nx = (#t.pts > 0) and 1 or 0 elseif nx > #t.pts then nx = 0 end
		U.wpSetSpawn(nx)
	end
	local holdUntil = 0
	local function applySpawn(char)
		local t = wpData()
		local pos
		if t.spawn > 0 and t.pts[t.spawn] then
			local p = t.pts[t.spawn]
			pos = V3(p.x, p.y, p.z)
		elseif t.spawn == -1 and type(t.last) == "table" then
			pos = V3(t.last.x, t.last.y, t.last.z)
		end
		if not pos then return end
		task.spawn(function()
			local root = char:WaitForChild("HumanoidRootPart", 8)
			if not root then return end
			for _ = 1, 4 do
				task.wait(0.25)
				if not alive() or killed or char ~= player.Character then return end
				char:PivotTo(CFrame.new(pos))
			end
		end)
	end
	task.spawn(function()
		local lastSaved
		while alive() and not killed do
			task.wait(2.5)
			if state.wpAuto and os.clock() > holdUntil then
				local root, ch = myRoot()
				local hum = ch and ch:FindFirstChildOfClass("Humanoid")
				if root and hum and hum.Health > 0 then
					local st = hum:GetState()
					local p = root.Position
					if st ~= Enum.HumanoidStateType.Freefall and st ~= Enum.HumanoidStateType.Dead and p.Y > -200 and (not lastSaved or (p - lastSaved).Magnitude > 4) then
						lastSaved = p
						wpData().last = { x = p.X, y = p.Y, z = p.Z }
						saveSoon()
					end
				end
			end
		end
	end)

	-- ---------- click teleport ----------
	local ctpTool
	local function tpTo(p)
		local root, ch = myRoot()
		if not root then return end
		ch:PivotTo(CFrame.new(p + V3(0, 3.2, 0)) * (root.CFrame - root.CFrame.Position))
	end
	local function rayAt(x, y)
		local c = cam()
		if not c then return end
		local r = c:ScreenPointToRay(x, y)
		rayP.FilterDescendantsInstances = { player.Character, fxFolder }
		local h = workspace:Raycast(r.Origin, r.Direction * 3000, rayP)
		return h and h.Position
	end
	local function dropTool()
		if ctpTool then pcall(function() ctpTool:Destroy() end) ctpTool = nil end
	end
	local function giveTool()
		dropTool()
		local bp = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
		if not bp then return end
		local t = Instance.new("Tool")
		t.Name = "Click TP"
		t.RequiresHandle = false
		t.CanBeDropped = false
		t.ToolTip = "Click TP"
		t:SetAttribute("App", true)
		t.Activated:Connect(function()
			local m = player:GetMouse()
			if m and m.Hit then tpTo(m.Hit.Position) end
		end)
		t.Parent = bp
		ctpTool = t
	end
	function U.ctpRefresh()
		if state.ctp and state.ctpMode == 2 then giveTool() else dropTool() end
	end
	local downAt = {}
	bind(UIS.InputBegan, function(input, gp)
		if gp or not state.ctp or state.ctpMode ~= 1 then return end
		local ut = input.UserInputType
		if ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.Touch then
			downAt[input] = { os.clock(), input.Position }
		end
	end)
	bind(UIS.InputEnded, function(input)
		local d = downAt[input]
		if not d then return end
		downAt[input] = nil
		if not state.ctp or state.ctpMode ~= 1 then return end
		if os.clock() - d[1] < 0.3 and (input.Position - d[2]).Magnitude < 12 then
			local hit = rayAt(input.Position.X, input.Position.Y)
			if hit then tpTo(hit) end
		end
	end)
	task.spawn(function()
		while alive() and not killed do
			task.wait(3)
			if state.ctp and state.ctpMode == 2 then
				local bp = player:FindFirstChildOfClass("Backpack")
				local ch = player.Character
				if not ctpTool or not ctpTool.Parent or (ctpTool.Parent ~= bp and ctpTool.Parent ~= ch) then giveTool() end
			end
		end
	end)

	bind(player.CharacterAdded, function(char)
		holdUntil = os.clock() + 3.5
		applySpawn(char)
		if state.ctp and state.ctpMode == 2 then task.delay(1, giveTool) end
		if state.fly then task.delay(1.2, function() U.setFly(true) end) end
	end)


	-- ---------- gerak: fly, noclip, speed/jump, inf jump, ESP ----------
	local flyConn, flyBV, flyBG, ncConn, jumpConn
	local function flyStop()
		if flyConn then flyConn:Disconnect() flyConn = nil end
		if flyBV then flyBV:Destroy() flyBV = nil end
		if flyBG then flyBG:Destroy() flyBG = nil end
		local _, ch = myRoot()
		local h = ch and ch:FindFirstChildOfClass("Humanoid")
		if h then pcall(function() h.PlatformStand = false end) end
	end
	function U.setFly(on)
		state.fly = on
		flyStop()
		if not on or killed then return end
		local root, ch = myRoot()
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if not root or not hum then return end
		flyBV = Instance.new("BodyVelocity")
		flyBV.MaxForce = V3(1e9, 1e9, 1e9)
		flyBV.Velocity = ZERO
		flyBV.Parent = root
		flyBG = Instance.new("BodyGyro")
		flyBG.MaxTorque = V3(1e9, 1e9, 1e9)
		flyBG.P = 9e4
		flyBG.Parent = root
		hum.PlatformStand = true
		flyConn = RunService.RenderStepped:Connect(function()
			local c = cam()
			local r, ch2 = myRoot()
			local h = ch2 and ch2:FindFirstChildOfClass("Humanoid")
			if not c or not r or not h or not flyBV then return end
			local md = h.MoveDirection
			local vel = ZERO
			if md.Magnitude > 0.05 then
				local lv = c.CFrame.LookVector
				local rv = c.CFrame.RightVector
				local fh = V3(lv.X, 0, lv.Z)
				local rh = V3(rv.X, 0, rv.Z)
				local f = fh.Magnitude > 0.01 and md:Dot(fh.Unit) or 0
				local s = rh.Magnitude > 0.01 and md:Dot(rh.Unit) or 0
				vel = lv * f + rv * s
			end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then vel = vel + UP end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) then vel = vel - UP end
			flyBV.Velocity = vel * state.flySpeed
			flyBG.CFrame = c.CFrame
		end)
	end
	function U.setNoclip(on)
		state.noclip = on
		if ncConn then ncConn:Disconnect() ncConn = nil end
		if on and not killed then
			ncConn = RunService.Stepped:Connect(function()
				local ch = player.Character
				if not ch then return end
				for _, d in ipairs(ch:GetDescendants()) do
					if d:IsA("BasePart") and d.CanCollide then d.CanCollide = false end
				end
			end)
		end
	end
	function U.setInfJump(on)
		state.infJump = on
		if jumpConn then jumpConn:Disconnect() jumpConn = nil end
		if on and not killed then
			jumpConn = UIS.JumpRequest:Connect(function()
				local _, ch = myRoot()
				local h = ch and ch:FindFirstChildOfClass("Humanoid")
				if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
			end)
		end
	end
	task.spawn(function()
		while alive() and not killed do
			task.wait(0.25)
			if state.moveOn then
				local _, ch = myRoot()
				local h = ch and ch:FindFirstChildOfClass("Humanoid")
				if h then
					pcall(function()
						h.WalkSpeed = state.walk
						h.UseJumpPower = true
						h.JumpPower = state.jump
					end)
				end
			end
		end
	end)
