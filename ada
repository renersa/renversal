			tiles[#tiles + 1] = t
		end
	end
	local ballPos = pos + V3(0, 16, 0)
	local ball = fxPart(Enum.PartType.Ball, ONE * 5, WHITE, CFrame.new(ballPos), 0, Enum.Material.Metal, 6)
	ball.Reflectance = 0.8
	local glint = stream(ball, { Color = ColorSequence.new(WHITE, cols[5]), Size = NS(1, 0), Lifetime = NumberRange.new(0.3, 0.7), Speed = NumberRange.new(0, 2), Rate = 90 })
	glint.Shape = Enum.ParticleEmitterShape.Sphere
	glint.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	light(ballPos, WHITE, 6, 60, 2.4)
	local beams = {}
	for i = 1, 6 do
		beams[i] = fxPart(Enum.PartType.Block, V3(0.5, 0.5, 1), cols[i], CFrame.new(ballPos), 0.35, Enum.Material.Neon, 6)
	end
	local parts, rels = bodyParts(char), {}
	for i, p in ipairs(parts) do rels[i] = CFrame.new(-pos) * p.CFrame end
	local T, t0, lastCol = 2.2, os.clock(), 0
	while true do
		local now = os.clock()
		local t = (now - t0) / T
		if t >= 1 then break end
		if now - lastCol > 0.14 then
			lastCol = now
			for _, tl in ipairs(tiles) do
				tl.Color = cols[R(1, #cols)]
				tl.Transparency = (R() < 0.2) and 0.7 or 0.1
			end
		end
		for i, bm in ipairs(beams) do
			local a = t * 6 + i * PI / 3
			local target = gp + V3(math.cos(a), 0, math.sin(a)) * (9 * (0.6 + 0.4 * math.sin(t * 5 + i)))
			local len = (ballPos - target).Magnitude
			bm.Size = V3(0.5, 0.5, len)
			bm.CFrame = CFrame.lookAt((ballPos + target) / 2, target)
		end
		local ang = t * t * 30 + t * 6
		local jump = math.abs(math.sin(t * 14)) * 2.5
		for i, p in ipairs(parts) do
			p.CFrame = CFrame.new(pos + V3(0, jump, 0)) * ANG(0, ang, 0) * rels[i]
		end
		RunService.Heartbeat:Wait()
	end
	boom(1.6, 1.2)
	sfx(SND_SNAP, 1.2, 1.4)
	flash(WHITE, 0.5, 0.6)
	punch(16, 0.5)
	shake(3, 0.6)
