local function gbNorm(s)return(tostring(s or ""):lower():gsub("[^%w]",""))end
local function gbClean(name)
name=tostring(name or "")
name=name:gsub("%b[]",""):gsub("%b()",""):gsub("[\128-\255]","")
return(name:gsub("^%s+",""):gsub("%s+$",""))
end
local function gbAcr(name)
local out=""
for w in gbClean(name):lower():gmatch("%w+")do
if w:match("^%d+$")then out=out .. w else out=out .. w:sub(1,1)end
end
return out
end
local function gbFmt(n)
n=tonumber(n)or 0
if n>=1e6 then return string.format("%.1fM",n/1e6)end
if n>=1e3 then return string.format("%.1fK",n/1e3)end
return tostring(math.floor(n))
end
local function gbHue(s)
local h=0
for i=1,#s do h=(h*31+s:byte(i))%360 end
return Color3.fromHSV(h/360,0.5,0.55)
end
local function gbFull(q)
local k=q:lower():gsub("%s+","")
return GBA[k]or GBA[q:lower()]
end
local function gbScore(g,q)
local nq=gbNorm(q)
if nq=="" then return 0 end
local nn=gbNorm(gbClean(g.name))
local full=gbFull(q)
local nf=full and gbNorm(full)or nil
local s
if nn==nq then s=1000
elseif gbAcr(g.name)==nq then s=950
elseif nf and nn==nf then s=940
elseif nf and nn:find(nf,1,true)then s=880
elseif nn:sub(1,#nq)==nq then s=800
elseif nn:find(nq,1,true)then s=600
else
local hit,tot=0,0
for w in q:lower():gmatch("%w+")do
tot=tot+1
if nn:find(w,1,true)then hit=hit+1 end
end
s=tot>0 and(400*hit/tot)or 0
end
return s+math.log10((g.playing or 0)+1)*25+(((g.likePct or 0)>=80)and 10 or 0)
end
local function gbRec(g)
local up,dn=tonumber(g.totalUpVotes)or 0,tonumber(g.totalDownVotes)or 0
return{
uid=tonumber(g.universeId),pid=tonumber(g.placeId or g.rootPlaceId),name=tostring(g.name or "?"),
playing=tonumber(g.playerCount or g.playing)or 0,likePct=(up+dn)>0 and math.floor(up/(up+dn)*100+0.5)or nil,
creator=g.creatorName or g.builder,
}
end
